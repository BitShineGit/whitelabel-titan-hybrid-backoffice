    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const responsibleGamingModal =
                document.getElementById("responsibleGamingModal");

            const rgConfirmButton =
                document.getElementById("rgConfirmButton");

            const rgDeclineButton =
                document.getElementById("rgDeclineButton");

            const storageKey = "responsibleGaming18Confirmed";
            const sessionKey = "responsibleGamingHandled";


            // ---------------------------------------------------------
            // CHECK RESPONSIBLE GAMING STATUS
            // ---------------------------------------------------------

            const isConfirmed =
                localStorage.getItem(storageKey) === "true";

            const alreadyHandledThisVisit =
                sessionStorage.getItem(sessionKey) === "true";


            // Show only if:
            // 1. User has NOT confirmed 18+
            // 2. Modal has NOT already been handled during this visit

            if (!isConfirmed && !alreadyHandledThisVisit) {

                responsibleGamingModal.style.display = "flex";
                document.body.style.overflow = "hidden";

            }


            // ---------------------------------------------------------
            // USER CONFIRMS 18+
            // ---------------------------------------------------------

            rgConfirmButton.addEventListener("click", function () {

                // Permanent confirmation
                localStorage.setItem(storageKey, "true");

                // Also mark as handled for this visit
                sessionStorage.setItem(sessionKey, "true");

                responsibleGamingModal.style.display = "none";
                document.body.style.overflow = "";

            });


            // ---------------------------------------------------------
            // USER DECLINES
            // ---------------------------------------------------------

            rgDeclineButton.addEventListener("click", function () {

                // Do NOT save 18+ confirmation.
                // Only remember that the modal was handled
                // during this browser session.

                sessionStorage.setItem(sessionKey, "true");

                responsibleGamingModal.style.display = "none";
                document.body.style.overflow = "";

            });

        });
    </script>

    <script>
        /**
         * Reusable Modal Controller
         *
         * Features:
         * - Open any modal
         * - Slide-up animation
         * - Fade overlay
         * - Close by outside click
         * - Update text from selected button
         *
         * Usage:
         *
         * Open button:
         * data-open-modal="#modalId"
         *
         * Option button:
         * data-update-element="#targetElement"
         *
         */

        class ModalController {
            constructor() {
                this.bindOpenEvents();
                this.bindOptionEvents();
                this.bindOutsideEvents();
            }

            // Open modal buttons
            bindOpenEvents() {
                document.querySelectorAll("[data-open-modal]").forEach((button) => {
                    button.addEventListener("click", () => {
                        const selector = button.dataset.openModal;

                        const modal = document.querySelector(selector);

                        this.open(modal);
                    });
                });
            }

            // Buttons inside modal
            bindOptionEvents() {

                document.querySelectorAll(".modal-option")
                    .forEach(button => {

                        button.addEventListener("click", () => {


                            // Remove active class from other buttons in the same modal
                            const modal = button.closest(".modal-overlay");

                            modal.querySelectorAll(".modal-option")
                                .forEach(option => {
                                    option.classList.remove("active");
                                });


                            // Add active class to clicked button
                            button.classList.add("active");


                            // Update target text
                            const targetSelector =
                                button.dataset.updateElement;


                            if (targetSelector) {

                                const target =
                                    document.querySelector(targetSelector);
                                if (target) {

                                    target.textContent =
                                        button.textContent.trim();
                                }
                            }
                            // Close modal
                            this.close(modal);

                        });

                    });

            }

            // Close when clicking outside modal
            bindOutsideEvents() {
                document.querySelectorAll(".modal-overlay").forEach((overlay) => {
                    overlay.addEventListener("click", (event) => {
                        if (event.target === overlay) {
                            this.close(overlay);
                        }
                    });
                });
            }

            open(modal) {
                if (!modal) return;

                modal.classList.add("is-open");
            }

            close(modal) {
                if (!modal) return;

                modal.classList.remove("is-open");
            }
        }

        // Initialize reusable modal system
        new ModalController();
    </script>

