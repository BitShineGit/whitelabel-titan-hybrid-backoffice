    <style>
        * {
            box-sizing: border-box;
        }
        /* ========================================= PAGE ========================================= */

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            margin-bottom: 30px;
        }
        /* ========================================= IMAGE GRID ========================================= */

        .image-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
        }
        /* ========================================= IMAGE CONTAINER ========================================= */

        .image-wrapper {
            position: relative;
            width: 100%;
            overflow: hidden;
            background: #313443;
            border-radius:12px;
        }
        /* ========================================= IMAGE ========================================= */

        .lazy-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: opacity 0.5s ease-out;
        }
        /* ========================================= SHIMMER ========================================= */

        .image-wrapper.loading::after {
            content: "";
            position: absolute;
            top: 0;
            left: -80%;
            width: 220%;
            height: 100%;
            pointer-events: none;
            background: linear-gradient( 90deg, transparent 0%, rgba(255, 255, 255, 0.025) 25%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.025) 75%, transparent 100% );
            transform: translate3d(0, 0, 0) skewX(-20deg);
            will-change: transform;
            animation: imageShimmer 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        @@keyframes imageShimmer {
            0% {
                transform: translate3d(-180%, 0, 0) skewX(-20deg);
            }

            100% {
                transform: translate3d(500%, 0, 0) skewX(-20deg);
            }
        }
        /* ========================================= IMAGE LOADED ========================================= */

        .image-wrapper.loaded::after {
            display: none;
        }

        .image-wrapper.loaded .lazy-image {
            opacity: 1;
        }
        /* ========================================= CARD ========================================= */

        .image-card {
            background: #0c0c0c;
            border-radius: 12px;
            overflow: hidden;
        }

        .image-title {
            padding: 15px;
            font-size: 17px;
            font-weight: 600;
        }
        /* ========================================= RESPONSIVE ========================================= */

        @@media (max-width: 1000px) {
            .image-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 700px) {
            .image-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 450px) {
            .image-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
