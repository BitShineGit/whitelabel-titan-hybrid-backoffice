    <script>
        // Open / Close dropdown
        $(document).on("click", ".user-dropdown-toggle", function (e) {
            e.stopPropagation();
                
            const dropdown = $(this).closest(".user-dropdown");

            // Close every other dropdown
            $(".user-dropdown").not(dropdown).removeClass("open");

            // Toggle current one
            dropdown.toggleClass("open");
        });

        // Click an option
        $(document).on("click", ".user-dropdown-menu button", function (e) {
            e.preventDefault();
            e.stopPropagation();

            const dropdown = $(this).closest(".user-dropdown");

            // Change button text
            dropdown.find(".user-selected-text").text($(this).text());

            // Close dropdown
            dropdown.removeClass("open");
        });

        // Prevent clicking inside menu from closing it
        $(document).on("click", ".user-dropdown-menu", function (e) {
            e.stopPropagation();
        });

        // Click outside closes all
        $(document).on("click", function () {
            $(".user-dropdown").removeClass("open");
        });
    </script>

