            z-index: 9999;
        }

            /* Show overlay */
            .modal-overlay.is-open {
                opacity: 1;
                visibility: visible;
            }

        /* Modal box */
        .modal-box {
            transform: translateY(100%);
            transition: transform 0.35s ease;
        }

        /* Slide up */
        .modal-overlay.is-open .modal-box {
            transform: translateY(0);
