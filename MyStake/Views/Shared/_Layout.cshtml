    <script>
          /* ===================================================== LAZY IMAGE HANDLER ===================================================== */ function initializeLazyImages(
            container = document,
        ) {
            const images = container.querySelectorAll("img.lazy-image");
            images.forEach(function (image) {
                const wrapper = image.closest(".image-wrapper");
                if (!wrapper) {
                    return;
                }
              /* * If the image has already loaded */ if (image.complete) {
                    if (image.naturalWidth > 0) {
                        wrapper.classList.remove("loading");
                        wrapper.classList.add("loaded");
                  /* * Image is already loaded. * Remove lazy-loading class. */ image.classList.remove(
                            "lazy-image",
                        );
                  /* * Remove wrapper classes because * lazy loading is no longer needed. */ wrapper.classList.remove(
                            "image-wrapper",
                            "loading",
                            "loaded",
                        );
                    }
                    return;
                }
              /* * Image successfully loaded */ image.addEventListener(
                    "load",
                    function () {
                        wrapper.classList.remove("loading");
                        wrapper.classList.add("loaded");
                  /* * Remove lazy-loading class. */ image.classList.remove(
                            "lazy-image",
                        );
                  /* * Remove wrapper after lazy loading * has finished. */ wrapper.classList.remove(
                            "image-wrapper",
                            "loading",
                            "loaded",
                        );
                    },
                    { once: true },
                );
              /* * Image failed */ image.addEventListener(
                    "error",
                    function () {
                        wrapper.classList.remove("loading");
                    },
                    { once: true },
                );
            });
        }
          /* ===================================================== INITIALIZE EXISTING IMAGES ===================================================== */ document.addEventListener(
            "DOMContentLoaded",
            function () {
                initializeLazyImages();
            },
        );
          /* ===================================================== OPTIONAL: AUTOMATICALLY HANDLE IMAGES ADDED LATER ===================================================== */ const observer =
            new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    mutation.addedNodes.forEach(function (node) {
                        if (node.nodeType !== 1) {
                            return;
                        }
                  /* * If the added element * itself is an image */ if (
                            node.matches &&
                            node.matches("img.lazy-image")
                        ) {
                            initializeLazyImages(node.parentElement);
                        } /* * If the added element * contains images */ else {
                            initializeLazyImages(node);
                        }
                    });
                });
            });
        observer.observe(document.body, { childList: true, subtree: true });
    </script>


