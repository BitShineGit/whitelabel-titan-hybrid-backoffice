        $(document).ready(function () {

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 5000,
                animation: true,            // enable animation
                showClass: {
                    popup: 'swal2-show'
                },
                hideClass: {
                    popup: 'swal2-hide'
                },
                didOpen: (toast) => {
                    toast.style.cursor = 'pointer'
                    toast.addEventListener('click', () => {
                        Swal.close()             // smooth fade out
                    })
                }
            })

            const loginmsg = sessionStorage.getItem("loginSuccessToast");
            if (loginmsg) {
                Toast.fire({
                    icon: 'success',
                    title: 'Signed in successfully'
                })
                sessionStorage.removeItem("loginSuccessToast");
            }

            const registermsg = sessionStorage.getItem("registerSuccessToast");
            if (registermsg) {
                Toast.fire({
                    icon: 'success',
                    title: 'Signed up successfully'
                })
                sessionStorage.removeItem("registerSuccessToast");
            }
        });

    </script>

