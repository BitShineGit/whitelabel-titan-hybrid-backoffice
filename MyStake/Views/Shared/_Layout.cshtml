            <script>
                function updateNotificationCount() {

                    var deleted = getDeletedNotifications()
                        .map(String);

                    var notificationElements =
                        document.querySelectorAll(".notifications-list");

                    var count = 0;

                    notificationElements.forEach(function (element) {

                        var classes = element.className.split(" ");

                        var id = classes.find(function (item) {
                            return item !== "notifications-list";
                        });

                        if (id && !deleted.includes(String(id))) {
                            count++;
                        }
                    });

                    if (count === 0) {
                        $("#notification-count-box").css("display", "none");
                    }
                    else {
                        $("#notification-count-box")
                            .css("display", "")
                            .html(count);
                    }
                }

                const NOTIFICATION_VIEWED_KEY = "notification_viewed";
                const NOTIFICATION_DELETED_KEY = "notification_deleted";


                function getViewedNotifications() {
                    try {
                        return JSON.parse(
                            localStorage.getItem(NOTIFICATION_VIEWED_KEY) || "[]"
                        );
                    } catch (e) {
                        return [];
                    }
                }


                function getDeletedNotifications() {
                    try {
                        return JSON.parse(
                            localStorage.getItem(NOTIFICATION_DELETED_KEY) || "[]"
                        );
                    } catch (e) {
                        return [];
                    }
                }


                function saveViewedNotifications(list) {
                    localStorage.setItem(
                        NOTIFICATION_VIEWED_KEY,
                        JSON.stringify(list)
                    );
                }


                function saveDeletedNotifications(list) {
                    localStorage.setItem(
                        NOTIFICATION_DELETED_KEY,
                        JSON.stringify(list)
                    );
                }


                function isNotificationViewed(id) {
                    var viewed = getViewedNotifications();

                    return viewed.map(String).includes(String(id));
                }


                function isNotificationDeleted(id) {
                    var deleted = getDeletedNotifications();

                    return deleted.map(String).includes(String(id));
                }


                function markNotificationViewed(id) {
                    var viewed = getViewedNotifications();

                    id = String(id);

                    if (!viewed.map(String).includes(id)) {
                        viewed.push(id);
                        saveViewedNotifications(viewed);
                    }
                }


                function markNotificationDeleted(id) {
                    var deleted = getDeletedNotifications();

                    id = String(id);

                    if (!deleted.map(String).includes(id)) {
                        deleted.push(id);
                        saveDeletedNotifications(deleted);
                    }
                }
