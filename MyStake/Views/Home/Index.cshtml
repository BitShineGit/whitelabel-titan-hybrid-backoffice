    List<MyStake.Models.GameListMedel> livegames = (List<MyStake.Models.GameListMedel>)ViewData["Games3"];
    List<MyStake.Models.GameListMedel> minigames = (List<MyStake.Models.GameListMedel>)ViewData["Games7"];
                                                                                                                 
}|

<style>
    /* =========================================================
           HOME GAME CARD
           Based on the LIST PAGE card visual system
           ========================================================= */

    .home-game-card-v2 {
        position: relative !important;
        overflow: hidden !important;
        border-radius: 12px !important;
        isolation: isolate;
    }


        /* =========================================================
           IMAGE
           ========================================================= */

        .home-game-card-v2 > .lazy-image {
            position: relative;
            z-index: 1;
            display: block !important;
            width: 100% !important;
            height: auto !important;
            object-fit: cover !important;
            transform: scale(1);
            transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
        }


        .home-game-card-v2:hover > .lazy-image {
            transform: scale(1.065);
            filter: brightness(0.68);
        }


        /* =========================================================
           IMAGE DARKENING
           Same visual direction as list page
           ========================================================= */

        .home-game-card-v2::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 8;
            pointer-events: none;
            opacity: 0;
            background: linear-gradient( to bottom, rgba(5, 8, 13, 0.05) 0%, rgba(5, 8, 13, 0.08) 35%, rgba(5, 8, 13, 0.48) 72%, rgba(5, 8, 13, 0.88) 100% );
            transition: opacity 0.4s ease;
        }


        .home-game-card-v2:hover::after {
            opacity: 1;
        }


    /* =========================================================
           NEW / HOT BADGES
           ========================================================= */

    .home-card-v2-badges {
        position: absolute !important;
        inset: 0 !important;
        z-index: 30 !important;
        pointer-events: none !important;
    }


    .home-card-v2-new,
    .home-card-v2-hot {
        position: absolute !important;
        top: 10px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 5px !important;
        min-width: 48px !important;
        height: 25px !important;
        padding: 0 9px 0 6px !important;
        border-radius: 999px !important;
        color: #ffffff !important;
        font-size: 9px !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        letter-spacing: 0.8px !important;
        white-space: nowrap !important;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.22);
        transform: translateY(0);
        transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease;
        overflow: hidden;
    }


    /* NEW = TOP LEFT */

    .home-card-v2-new {
        left: 10px !important;
        background: linear-gradient( 135deg, rgba(0, 190, 255, 0.98), rgba(0, 137, 218, 0.94) );
        border: 1px solid rgba(111, 220, 255, 0.48);
    }


    /* HOT = TOP RIGHT */

    .home-card-v2-hot {
        right: 10px !important;
        background: linear-gradient( 135deg, rgba(255, 94, 94, 0.98), rgba(220, 39, 72, 0.94) );
        border: 1px solid rgba(255, 157, 157, 0.48);
    }


    .home-game-card-v2:hover .home-card-v2-new,
    .home-game-card-v2:hover .home-card-v2-hot {
        transform: translateY(-2px);
    }


    /* =========================================================
           BADGE ICON
           ========================================================= */

    .home-card-v2-badge-icon {
        width: 17px !important;
        height: 17px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex-shrink: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
    }


        .home-card-v2-badge-icon svg {
            display: block;
        }


    /* =========================================================
           BADGE SHINE
           ========================================================= */

    .home-card-v2-new::after,
    .home-card-v2-hot::after {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.28), transparent );
        transform: skewX(-20deg);
        transition: left 0.7s ease;
    }


    .home-game-card-v2:hover .home-card-v2-new::after,
    .home-game-card-v2:hover .home-card-v2-hot::after {
        left: 140%;
    }


    /* =========================================================
           HOVER CONTENT
           ========================================================= */

    .home-card-v2-overlay {
        position: absolute !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        z-index: 40 !important;
        width: 100% !important;
        padding: 55px 10px 10px !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        opacity: 0;
        transform: translateY(12px);
        background: linear-gradient( to bottom, rgba(5, 8, 13, 0) 0%, rgba(5, 8, 13, 0.08) 20%, rgba(5, 8, 13, 0.65) 62%, rgba(5, 8, 13, 0.96) 100% );
        transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        pointer-events: none;
    }


    .home-game-card-v2:hover .home-card-v2-overlay {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }


    /* =========================================================
           CENTER PLAY BUTTON
           ========================================================= */

    .home-card-v2-play {
        position: absolute !important;
        top: 35% !important;
        left: 50% !important;
        width: 50px !important;
        height: 50px !important;
        min-width: 30px !important;
        max-width: 30px !important;
        min-height: 30px !important;
        max-height: 30px !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transform: translate(-50%, -50%) !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        border-radius: 50% !important;
        color: #ffffff !important;
        background: linear-gradient( 135deg, #00b9f5, #009fe0 ) !important;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35), 0 0 20px rgba(0, 170, 235, 0.22) !important;
        cursor: pointer !important;
        box-sizing: border-box !important;
        transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease !important;
    }


        .home-card-v2-play:hover {
            transform: translate(-50%, -50%) scale(1.08) !important;
            filter: brightness(1.08);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.42), 0 0 26px rgba(0, 170, 235, 0.30) !important;
        }


        .home-card-v2-play svg {
            display: block !important;
            width: 20px !important;
            height: 20px !important;
            margin-left: 2px !important;
            flex-shrink: 0;
        }


    /* =========================================================
           BOTTOM GLASS PANEL
           ========================================================= */

    .home-card-v2-bottom {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 8px !important;
        min-height: 48px !important;
        width: 100% !important;
        padding: 8px 8px 8px 11px !important;
        box-sizing: border-box !important;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        background: rgba(12, 17, 25, 0.78);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transform: translateY(8px);
        opacity: 0;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.03s, opacity 0.3s ease 0.03s;
    }


    .home-game-card-v2:hover .home-card-v2-bottom {
        transform: translateY(0);
        opacity: 1;
    }


    /* =========================================================
           GAME INFORMATION
           ========================================================= */

    .home-card-v2-info {
        min-width: 0 !important;
        flex: 1 !important;
        overflow: hidden !important;
    }


    .home-card-v2-name {
        display: block !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden;
        color: #ffffff !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        line-height: 1.3 !important;
        white-space: nowrap;
        text-overflow: ellipsis;
    }


    .home-card-v2-provider {
        display: block !important;
        width: 100% !important;
        margin: 2px 0 0 !important;
        padding: 0 !important;
        overflow: hidden;
        color: rgba(255, 255, 255, 0.48) !important;
        font-size: 9px !important;
        font-weight: 500 !important;
        line-height: 1.2 !important;
        text-transform: uppercase;
        white-space: nowrap;
        text-overflow: ellipsis;
    }


    /* =========================================================
           FAVORITE
           ========================================================= */

    .home-card-v2-favorite {
        flex: 0 0 32px !important;
        width: 32px !important;
        height: 32px !important;
        min-width: 32px !important;
        min-height: 32px !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        border: 1px solid rgba(255, 255, 255, 0.10) !important;
        border-radius: 8px !important;
        color: rgba(255, 255, 255, 0.78) !important;
        background: rgba(255, 255, 255, 0.06) !important;
        cursor: pointer !important;
        box-sizing: border-box !important;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease !important;
    }


        .home-card-v2-favorite:hover {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.13) !important;
            transform: translateY(-2px) !important;
        }


        .home-card-v2-favorite svg {
            display: block !important;
            width: 18px !important;
            height: 17px !important;
        }
</style>
