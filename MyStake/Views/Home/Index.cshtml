<script>


    function GetGameUrlHome(
        gamecode,
        providercode,
        gamename,
        status
    ) {

        /*
         * NOT LOGGED IN
         */
        if ("@User.Identity.IsAuthenticated" != "True") {

            const mobile_loginButton =
                document.querySelector("#openLoginModal");

            if (mobile_loginButton) {
                mobile_loginButton.click();
            }

            return;
        }


        /*
         * LOGGED IN
         *
         * Status 0 = Maintenance
         * Status 1 = Active
         */

        if (status == 0) {

            showGameMaintenance(gamename);

            return;
        }


        /*
         * ACTIVE GAME
         */

        if (status == 1) {

            window.location.href =
                `/Game/GetLaunchUrl?gamecode=${encodeURIComponent(gamecode)}` +
                `&providercode=${encodeURIComponent(providercode)}` +
                `&gamename=${encodeURIComponent(gamename)}`;

            return;
        }

    }



    function showGameMaintenance(gameName) {

        Swal.fire({
            icon: 'info',
            title: 'Game Under Maintenance',
            html: `
                <div style="
                    margin-top: 8px;
                    color: #aeb4c0;
                    font-size: 14px;
                    line-height: 1.6;
                ">
                    <div style="
                        font-size: 15px;
                        color: #ffffff;
                        font-weight: 600;
                        margin-bottom: 8px;
                    ">
                        ${gameName}
                    </div>

                    <div>
                        This game is temporarily unavailable
                        while we perform maintenance.
                    </div>

                    <div style="
                        margin-top: 8px;
                        color: #7f8794;
                        font-size: 13px;
                    ">
                        Please try again later.
                    </div>
                </div>
            `,
            background: '#151922',
            color: '#ffffff',
            confirmButtonText: 'OK',
            confirmButtonColor: '#00aaeb',
            buttonsStyling: true,
            customClass: {
                popup: 'game-maintenance-popup',
                title: 'game-maintenance-title',
                confirmButton: 'game-maintenance-button'
            }
        });

    }

</script>

