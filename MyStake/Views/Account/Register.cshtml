@{
    List<Titan.Repository.Database.Currency> currencyList = (List<Titan.Repository.Database.Currency>)ViewData["CurrencyList"];
}
@model MyStake.Models.RegisterViewModel
@using Microsoft.Extensions.Localization
@{
    string ReturnUrl = "";
    if (ViewData["ReturnUrl"] != null)
    {
        ReturnUrl = (string)ViewData["ReturnUrl"];
    }
}
<style>
  body.signup-modal-open,
  body.login-modal-open {
    overflow: hidden;
  }
  .signup-modal,
  .login-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }
  .signup-modal.is-open,
  .login-modal.is-open {
    visibility: visible;
    opacity: 1;
  }
  .signup-backdrop,
  .login-backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 25%,
        rgba(124, 92, 255, 0.14),
        transparent 45%
      ),
      rgba(2, 5, 12, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .signup-dialog,
  .login-dialog {
    position: relative;
    z-index: 2;
    width: min(860px, calc(100vw - 40px));
    height: min(570px, calc(100vh - 40px));
    min-height: 0;
    display: grid;
    grid-template-columns: 40% 60%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: linear-gradient(
      145deg,
      rgba(25, 29, 42, 0.99),
      rgba(13, 17, 27, 0.99)
    );
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.02);
    transform: translateY(18px) scale(0.98);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .signup-modal.is-open .signup-dialog,
  .login-modal.is-open .login-dialog {
    transform: translateY(0) scale(1);
  }
  .account-modal-visual {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #111522;
  }
  .account-modal-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.8s ease,
      transform 5s ease;
  }
  .account-modal-slide.active {
    opacity: 1;
    transform: scale(1);
  }
  .account-modal-slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .account-modal-visual:after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 7, 14, 0.05) 20%,
      rgba(5, 7, 14, 0.9) 100%
    );
    pointer-events: none;
  }
  .account-modal-visual-content {
    position: absolute;
    left: 28px;
    right: 22px;
    bottom: 30px;
    z-index: 3;
  }
  .account-modal-visual-content span {
    display: block;
    margin-bottom: 7px;
    color: #00aaeb;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .account-modal-visual-content h3 {
    margin: 0;
    color: #fff;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .account-modal-dots {
    position: absolute;
    left: 28px;
    bottom: 22px;
    z-index: 4;
    display: flex;
    gap: 5px;
  }
  .account-modal-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    transition: 0.25s ease;
    cursor: pointer;
  }
  .account-modal-dots span.active {
    width: 18px;
    border-radius: 10px;
    background: #00aaeb;
  }
  .signup-content,
  .login-content {
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
  }
  .signup-content::-webkit-scrollbar,
  .login-content::-webkit-scrollbar {
    width: 5px;
  }
  .signup-content::-webkit-scrollbar-track,
  .login-content::-webkit-scrollbar-track {
    background: transparent;
  }
  .signup-content::-webkit-scrollbar-thumb,
  .login-content::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
  }
  .account-modal-tabs {
    display: flex;
    gap: 4px;
    margin: 22px 28px 0;
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.025);
  }
  .account-modal-tab {
    flex: 1;
    height: 36px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: #7f8798;
    font-size: 12px;
    font-weight: 750;
    cursor: pointer;
    transition: 0.2s ease;
  }
  .account-modal-tab:hover {
    color: #dfe2ea;
  }
  .account-modal-tab.active {
    color: #fff;
    background: linear-gradient( 135deg, #00aaeb,#00aaeb );
    box-shadow: 0 6px 18px rgba(93, 61, 245, 0.18);
  }
  .signup-header,
  .login-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 22px 28px 18px;
  }
  .signup-eyebrow,
  .login-eyebrow {
    display: inline-block;
    margin-bottom: 6px;
    color: #00aaeb;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }
  .signup-header h2,
  .login-header h2 {
    margin: 0;
    color: #fff;
    font-size: 28px;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .signup-header p,
  .login-header p {
    margin: 6px 0 0;
    color: #858d9f;
    font-size: 12px;
  }
  .signup-close,
  .login-close {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.04);
    color: #a8afbf;
    font-size: 25px;
    line-height: 1;
    cursor: pointer;
    transition: 0.2s ease;
  }
  .signup-close:hover,
  .login-close:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .signup-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
  }
  .signup-full {
    grid-column: 1/-1;
  }
  #signupForm,
  #loginForm {
    padding: 0 28px 28px;
  }
  .signup-field,
  .login-field {
    margin-bottom: 14px;
  }
  .signup-field label,
  .login-field label {
    display: block;
    margin-bottom: 7px;
    color: #c8cdd8;
    font-size: 12px;
    font-weight: 650;
  }
  .signup-input-wrapper,
  .login-input-wrapper {
    position: relative;
  }
  .signup-input-wrapper input,
  .signup-input-wrapper select,
  .login-input-wrapper input {
    width: 100%;
    height: 46px;
    box-sizing: border-box;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    outline: none;
    background: rgba(255, 255, 255, 0.045);
    color: #f5f7fb;
    font-size: 13px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }
  .signup-input-wrapper input::placeholder,
  .login-input-wrapper input::placeholder {
    color: #646b7b;
  }
  .signup-input-wrapper input:focus,
  .signup-input-wrapper select:focus,
  .login-input-wrapper input:focus {
                border-color: #00aaeb;
    background: rgba(124, 92, 255, 0.055);
    box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.1);
  }
  .signup-input-wrapper select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 38px;
    background-image:
      linear-gradient(45deg, transparent 50%, #777f92 50%),
      linear-gradient(135deg, #777f92 50%, transparent 50%);
    background-position:
      calc(100% - 18px) 20px,
      calc(100% - 13px) 20px;
    background-size:
      5px 5px,
      5px 5px;
    background-repeat: no-repeat;
  }
  .signup-input-wrapper select option {
    background: #171b27;
    color: #fff;
  }
  .signup-input-wrapper:has(.signup-input-icon) input,
  .login-input-wrapper:has(.login-input-icon) input {
    padding-left: 36px;
  }
  .signup-input-icon,
  .login-input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #777f92;
    font-size: 15px;
    pointer-events: none;
    z-index: 1;
  }
  .password-toggle,
  .login-password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: #858da0;
    font-size: 11px;
    font-weight: 650;
    cursor: pointer;
  }
  .password-toggle:hover,
  .login-password-toggle:hover {
    color: #b9b0ff;
  }
  .signup-input-wrapper:has(.password-toggle) input,
  .login-input-wrapper:has(.login-password-toggle) input {
    padding-right: 58px;
  }
  .signup-error,
  .login-error {
    display: block;
    min-height: 15px;
    margin-top: 5px;
    color: #ff6f86;
    font-size: 11px;
    line-height: 1.4;
  }
  .signup-field.has-error input,
  .signup-field.has-error select,
  .login-field.has-error input {
    border-color: rgba(255, 85, 112, 0.65);
    box-shadow: 0 0 0 3px rgba(255, 85, 112, 0.06);
  }
  .signup-field.is-valid input,
  .signup-field.is-valid select,
  .login-field.is-valid input {
    border-color: rgba(62, 207, 142, 0.35);
  }
  .password-requirements {
    margin: 0 0 15px;
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.025);
  }
  .requirement-title {
    margin-bottom: 9px;
    color: #858da0;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .requirement-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
  }
  .requirement-list span {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #737b8d;
    font-size: 11px;
    transition: 0.2s ease;
  }
  .requirement-list i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4d5464;
  }
  .requirement-list span.valid {
    color: #6fdfaa;
  }
  .requirement-list span.valid i {
    background: #4ddd96;
    box-shadow: 0 0 8px rgba(77, 221, 150, 0.5);
  }
  .signup-server-message,
  .login-server-message {
    display: none;
    margin-bottom: 14px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(255, 82, 109, 0.08);
    color: #ff7188;
    font-size: 12px;
    line-height: 1.5;
  }
  .signup-server-message.is-visible,
  .login-server-message.is-visible {
    display: block;
  }
  .login-server-message.success {
    background: rgba(62, 207, 142, 0.08);
    color: #6fdfaa;
  }
  .signup-submit,
  .login-submit {
    position: relative;
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 13px;
        background: linear-gradient(135deg, #00aaeb, #00aaeb);
    color: #fff;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(93, 61, 245, 0.18);
    transition: 0.25s ease;
  }
  .signup-submit:hover:not(:disabled),
  .login-submit:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 14px 35px rgba(93, 61, 245, 0.3);
  }
  .signup-submit:disabled,
  .login-submit:disabled {
    cursor: not-allowed;
    background: #292e3b;
    color: #666d7e;
    box-shadow: none;
  }
  .signup-submit.is-loading,
  .login-submit.is-loading {
    pointer-events: none;
  }
  .signup-submit-loader,
  .login-submit-loader {
    display: none;
    width: 16px;
    height: 16px;
    margin: auto;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-top-color: #fff;
    border-radius: 50%;
    animation: accountModalSpin 0.7s linear infinite;
  }
  .signup-submit.is-loading .signup-submit-text,
  .login-submit.is-loading .login-submit-text {
    display: none;
  }
  .signup-submit.is-loading .signup-submit-loader,
  .login-submit.is-loading .login-submit-loader {
    display: block;
  }
  @@keyframes accountModalSpin {
    to {
      transform: rotate(360deg);
    }
  }
  @@media (max-width: 760px) {
    .signup-dialog,
    .login-dialog {
      width: min(680px, calc(100vw - 28px));
      height: min(680px, calc(100vh - 28px));
      grid-template-columns: 1fr;
      grid-template-rows: 145px minmax(0, 1fr);
      border-radius: 22px;
    }
    .account-modal-visual {
      min-height: 145px;
    }
    .account-modal-visual-content {
      left: 20px;
      bottom: 22px;
    }
    .account-modal-visual-content h3 {
      font-size: 19px;
    }
    .account-modal-dots {
      left: auto;
      right: 20px;
      bottom: 20px;
    }
    .account-modal-tabs {
      margin: 16px 20px 0;
      margin-top: 48px;
    }
    .signup-header,
    .login-header {
      padding: 18px 20px 14px;
    }
    #signupForm,
    #loginForm {
      padding: 0 20px 22px;
    }
  }
  @@media (max-width: 560px) {
    .signup-modal,
    .login-modal {
      align-items: flex-end;
      padding: 0;
    }
    .signup-dialog,
    .login-dialog {
      width: 100%;
      height: 94vh;
      max-height: 94vh;
      grid-template-rows: 125px minmax(0, 1fr);
      border-radius: 22px 22px 0 0;
      transform: translateY(30px);
    }
    .signup-modal.is-open .signup-dialog,
    .login-modal.is-open .login-dialog {
      transform: translateY(0);
    }
    .account-modal-visual {
      min-height: 125px;
    }
    .account-modal-visual-content {
      left: 18px;
      bottom: 18px;
    }
    .account-modal-visual-content span {
      margin-bottom: 4px;
    }
    .account-modal-visual-content h3 {
      font-size: 17px;
    }
    .account-modal-dots {
      right: 18px;
      bottom: 17px;
    }
    .account-modal-tabs {
      margin: 14px 18px 0;
      margin-top: 46px;
    }
    .signup-header,
    .login-header {
      padding: 16px 18px 12px;
    }
    .signup-header h2,
    .login-header h2 {
      font-size: 25px;
    }
    #signupForm,
    #loginForm {
      padding: 0 18px 20px;
    }
  }
  @@media (max-width: 430px) {
    .signup-dialog,
    .login-dialog {
      height: 96vh;
      max-height: 96vh;
    }
    .signup-form-grid {
      grid-template-columns: 1fr;
    }
    .signup-full {
      grid-column: auto;
    }
    .requirement-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .signup-field,
    .login-field {
      margin-bottom: 12px;
    }
  }
  @@media (max-width: 360px) {
    .requirement-list {
      grid-template-columns: 1fr;
    }
    .account-modal-tab {
      font-size: 11px;
    }
  }

  /* Combined account modal structure */
  .account-tab-panel {
    display: none;
    min-width: 0;
  }
  .account-tab-panel.is-active {
    display: block;
  }
  #closeSignupModal {
    position: absolute;
    top: 4px;
    right: 10px;
    z-index: 30;
  }
  .signup-content .account-modal-tabs {
    position: relative;
    z-index: 10;
    margin-top: 52px;
  }
  .signup-modal {
    pointer-events: none;
  }
  .signup-modal.is-open {
    pointer-events: auto;
  }
</style>

<!-- Combined Register / Login Modal -->
<div id="signupModal" class="signup-modal" aria-hidden="true">

    <div class="signup-backdrop"></div>

    <div class="signup-dialog" role="dialog" aria-modal="true" aria-labelledby="signupTitle">

        <div class="account-modal-visual" id="signupVisual">
            <div class="account-modal-slide active"><img src="~/images/login-bg.png" alt="Welcome"></div>
@*             <div class="account-modal-slide"><img src="~/images/7f809c1d-09e2-41e3-b449-60221165d7d2.png" alt="Casino"></div>
            <div class="account-modal-slide"><img src="~/images/7f809c1d-09e2-41e3-b449-60221165d7d2.png" alt="Games"></div> *@
            <div class="account-modal-visual-content"><span>CREATE ACCOUNT</span><h3>Have a great time at TITANBET.</h3></div>
            <div class="account-modal-dots"><span class="active"></span>
              @*   <span></span><span></span> *@
                </div>
        </div>

        <div class="signup-content">

            <div class="account-modal-tabs" role="tablist" aria-label="Account">
                <button type="button" class="account-modal-tab active" data-account-tab="register" role="tab" aria-selected="true">Register</button>
                <button type="button" class="account-modal-tab" data-account-tab="login" role="tab" aria-selected="false">Sign In</button>
            </div>

            <button type="button" id="closeSignupModal" class="signup-close" aria-label="Close">&times;</button>

            <div id="registerTabContent" class="account-tab-panel is-active" role="tabpanel">




        <!-- Header -->
        <div class="signup-header">
            <div>
                <span class="signup-eyebrow">CREATE ACCOUNT</span>
                <h2 id="signupTitle">Join us</h2>
                <p>Create your account and get started.</p>
            </div>


        </div>


        <!-- Form -->
        <form id="signupForm"
              method="post"
              action="@Url.Action("Register", "Account")"
              data-no-loading
              novalidate>

            @Html.AntiForgeryToken()

            <div class="signup-form-grid">

                <!-- First Name -->
                <div class="signup-field">
                    <label for="FirstName">First Name</label>

                    <div class="signup-input-wrapper">
                        <input type="text"
                               id="FirstName"
                               name="FirstName"
                               autocomplete="given-name"
                               placeholder="First name">
                    </div>

                    <span class="signup-error"
                          id="firstNameError"></span>
                </div>


                <!-- Last Name -->
                <div class="signup-field">
                    <label for="LastName">Last Name</label>

                    <div class="signup-input-wrapper">
                        <input type="text"
                               id="LastName"
                               name="LastName"
                               autocomplete="family-name"
                               placeholder="Last name">
                    </div>

                    <span class="signup-error"
                          id="lastNameError"></span>
                </div>


                <!-- Email -->
                <div class="signup-field signup-full">
                    <label for="Email">Email</label>

                    <div class="signup-input-wrapper">
                        <span class="signup-input-icon"></span>

                        <input type="text"
                               id="Email"
                               name="Email"
                               autocomplete="email"
                               placeholder="yourname@example.com">
                    </div>

                    <span class="signup-error"
                          id="emailError"></span>
                </div>


                <!-- Password -->
                <div class="signup-field">
                    <label for="Password">Password</label>

                    <div class="signup-input-wrapper">
                        <input type="password"
                               id="Password"
                               name="Password"
                               autocomplete="new-password"
                               placeholder="Enter password">

                        <button type="button"
                                class="password-toggle"
                                data-target="Password">
                            Show
                        </button>
                    </div>

                    <span class="signup-error"
                          id="passwordError"></span>
                </div>


                <!-- Confirm Password -->
                <div class="signup-field">
                    <label for="ConfirmPassword">Confirm Password</label>

                    <div class="signup-input-wrapper">
                        <input type="password"
                               id="ConfirmPassword"
                               name="ConfirmPassword"
                               autocomplete="new-password"
                               placeholder="Repeat password">

                        <button type="button"
                                class="password-toggle"
                                data-target="ConfirmPassword">
                            Show
                        </button>
                    </div>

                    <span class="signup-error"
                          id="confirmPasswordError"></span>
                </div>


                <!-- Currency -->
                <div class="signup-field">
                    <label for="CurrencyId">Currency</label>

                    <div class="signup-input-wrapper">
                        <select id="CurrencyId"
                                name="CurrencyId">
                            <option value="1" selected>USD — US Dollar</option>
                        </select>
                    </div>

                    <span class="signup-error"
                          id="currencyError"></span>
                </div>


                <!-- Country -->
                <div class="signup-field">
                    <label for="CountryId">Country</label>

                    <div class="signup-input-wrapper">
                        <select id="CountryId"
                                name="CountryId">
                            <option value="">Select country</option>

                            <option value="AF">Afghanistan</option>
                            <option value="AL">Albania</option>
                            <option value="DZ">Algeria</option>
                            <option value="AD">Andorra</option>
                            <option value="AO">Angola</option>
                            <option value="AG">Antigua and Barbuda</option>
                            <option value="AR">Argentina</option>
                            <option value="AM">Armenia</option>
                            <option value="AU">Australia</option>
                            <option value="AT">Austria</option>
                            <option value="AZ">Azerbaijan</option>

                            <option value="BS">Bahamas</option>
                            <option value="BH">Bahrain</option>
                            <option value="BD">Bangladesh</option>
                            <option value="BB">Barbados</option>
                            <option value="BY">Belarus</option>
                            <option value="BE">Belgium</option>
