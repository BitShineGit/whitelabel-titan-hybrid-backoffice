<script>
(function(){
    if(window.__accountModalControllerInitialized)return;
    window.__accountModalControllerInitialized=true;

    document.addEventListener("DOMContentLoaded",function(){
        const modal=document.getElementById("signupModal");
        if(!modal)return;

        const tabs=modal.querySelectorAll(".account-modal-tab");
        const registerPanel=document.getElementById("registerTabContent");
        const loginPanel=document.getElementById("loginTabContent");
        const closeButton=document.getElementById("closeSignupModal");
        const backdrop=modal.querySelector(".signup-backdrop");

        function setActive(tabName){
            const login=tabName==="login";
            tabs.forEach(function(tab){
                const active=tab.dataset.accountTab===tabName;
                tab.classList.toggle("active",active);
                tab.setAttribute("aria-selected",active?"true":"false");
            });
            registerPanel?.classList.toggle("is-active",!login);
            loginPanel?.classList.toggle("is-active",login);
            registerPanel?.setAttribute("aria-hidden",login?"true":"false");
            loginPanel?.setAttribute("aria-hidden",login?"false":"true");
        }

        function open(tabName){
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden","false");
            document.body.classList.add("signup-modal-open");
            document.body.classList.remove("login-modal-open");
            setActive(tabName||"register");
            setTimeout(function(){
                const field=tabName==="login"?document.getElementById("LoginEmail"):document.getElementById("Email");
                field?.focus();
            },250);
        }

        function close(){
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden","true");
            document.body.classList.remove("signup-modal-open","login-modal-open");
        }

        window.setActiveAccountTab=setActive;
        window.openAccountModal=open;
        window.closeAccountModal=close;

        tabs.forEach(function(tab){
            tab.addEventListener("click",function(event){
                event.preventDefault();
                setActive(tab.dataset.accountTab);
                setTimeout(function(){
                    const field=tab.dataset.accountTab==="login"?document.getElementById("LoginEmail"):document.getElementById("Email");
                    field?.focus();
                },100);
            });
        });

        closeButton?.addEventListener("click",close);
        backdrop?.addEventListener("click",close);

        document.addEventListener("keydown",function(event){
            if(event.key==="Escape" && modal.classList.contains("is-open"))close();
        });

        // Always start completely closed.
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden","true");
        document.body.classList.remove("signup-modal-open","login-modal-open");
        setActive("register");
    });
})();
</script>
<script>

document.addEventListener("DOMContentLoaded", function () {

    const modal = document.getElementById("signupModal");
    const openButton = document.getElementById("openSignupModal");
    const mobileopenButton = document.getElementById("openRegisterModal");
    const loginOpenButton = document.getElementById("openLoginModal");
    const closeButton = document.getElementById("closeSignupModal");
    const backdrop = modal?.querySelector(".signup-backdrop");

    const form = document.getElementById("signupForm");
    const submitButton = document.getElementById("signupSubmit");

    if (!modal || !openButton || !closeButton || !form) {
        return;
    }


    /* =========================================================
       ELEMENTS
       ========================================================= */

    const firstName = document.getElementById("FirstName");
    const lastName = document.getElementById("LastName");
    const email = document.getElementById("Email");
    const password = document.getElementById("Password");
    const confirmPassword = document.getElementById("ConfirmPassword");
    const currency = document.getElementById("CurrencyId");
    const country = document.getElementById("CountryId");
    const birthday = document.getElementById("Birthday");
    const promoCode = document.getElementById("PromoCode");
        const promoCodeError =
            document.getElementById("promoCodeError");

    const emailError = document.getElementById("emailError");
    const passwordError = document.getElementById("passwordError");
    const confirmPasswordError =
        document.getElementById("confirmPasswordError");

    const firstNameError =
        document.getElementById("firstNameError");

    const lastNameError =
        document.getElementById("lastNameError");

    const currencyError =
        document.getElementById("currencyError");

    const countryError =
        document.getElementById("countryError");

    const serverMessage =
        document.getElementById("signupServerMessage");
        const birthdayError =
            document.getElementById("birthdayError");


        const signupSlides=document.querySelectorAll("#signupVisual .account-modal-slide");
        const signupDots=document.querySelectorAll("#signupVisual .account-modal-dots span");
        let signupCurrentSlide=0,signupSliderTimer=null;
        function showSignupSlide(index){if(!signupSlides.length)return;signupSlides.forEach(function(s){s.classList.remove("active")});signupDots.forEach(function(d){d.classList.remove("active")});signupSlides[index].classList.add("active");if(signupDots[index])signupDots[index].classList.add("active");signupCurrentSlide=index;}
        function startSignupSlider(){if(signupSlides.length<=1||signupSliderTimer)return;signupSliderTimer=setInterval(function(){showSignupSlide((signupCurrentSlide+1)%signupSlides.length)},4000)}
        function stopSignupSlider(){if(!signupSliderTimer)return;clearInterval(signupSliderTimer);signupSliderTimer=null}
        signupDots.forEach(function(dot,index){dot.addEventListener("click",function(){showSignupSlide(index);stopSignupSlider();startSignupSlider();})});
        startSignupSlider();

    /* =========================================================
       OPEN / CLOSE
       ========================================================= */

    function openModal() {
        window.openAccountModal?.("register");
    }

        const isSignupRoute = @Json.Serialize(ViewData["IsSignupRoute"] ?? false);

        if (isSignupRoute) {
            openModal();
        }


    function closeModal() {
        window.closeAccountModal?.();
    }

    openButton.addEventListener("click", function () {
        openModal();
    });

    if (mobileopenButton) {
        mobileopenButton.addEventListener("click", function () {
            openModal();
        });
    }

    if (loginOpenButton) {
        loginOpenButton.addEventListener("click", function (event) {
            event.preventDefault();
            window.openAccountModal?.("login");
        });
    }

    closeButton.addEventListener("click", function () {
        closeModal();
    });

    backdrop?.addEventListener("click", function () {
        closeModal();
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && modal.classList.contains("is-open")) {
            closeModal();
        }
    });


    /* =========================================================
       PASSWORD TOGGLE
       ========================================================= */

    document.querySelectorAll(".password-toggle")
        .forEach(function (button) {

            button.addEventListener("click", function () {

                const targetId = button.dataset.target;
                const input = document.getElementById(targetId);

                if (!input) return;

                if (input.type === "password") {

                    input.type = "text";
                    button.textContent = "Hide";

                } else {

                    input.type = "password";
                    button.textContent = "Show";
                }
            });
        });


    /* =========================================================
       HELPERS
       ========================================================= */

    function setError(input, errorElement, message) {

        const field = input.closest(".signup-field");

        if (message) {

            errorElement.textContent = message;

            field.classList.add("has-error");
            field.classList.remove("is-valid");

        } else {

            errorElement.textContent = "";

            field.classList.remove("has-error");

            if (input.value.trim()) {
                field.classList.add("is-valid");
            }
        }
    }


    function clearServerMessage() {

        serverMessage.textContent = "";
        serverMessage.classList.remove("is-visible");
    }


    function showServerMessage(message) {

        serverMessage.textContent = message;
        serverMessage.classList.add("is-visible");
    }


    /* =========================================================
       EMAIL VALIDATION
       
       Requirements:
       - 8–20 characters
       - @@
       - .com
       - lowercase
       - uppercase
       - number
       ========================================================= */

    function validateEmail() {

        const value = email.value.trim();

        if (!value) {

            setError(
                email,
                emailError,
                "Email is required."
            );

            return false;
        }


        if (value.length < 8 || value.length > 20) {

            setError(
                email,
                emailError,
                "Email must be 8–20 characters long."
            );

            return false;
        }


        if (!value.toLowerCase().includes(".com")) {

            setError(
                email,
                emailError,
                "Email must contain '.com'."
            );

            return false;
        }


        if (!/[a-z]/.test(value)) {

            setError(
                email,
                emailError,
                "Email must contain a lowercase letter."
            );

            return false;
        }


        if (!/[A-Z]/.test(value)) {

            setError(
                email,
                emailError,
                "Email must contain an uppercase letter."
            );

            return false;
        }


        if (!/[0-9]/.test(value)) {

            setError(
                email,
                emailError,
                "Email must contain a number."
            );

            return false;
        }


        /*
         * Basic email structure
         */

        const emailPattern =
                /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        if (!emailPattern.test(value)) {

            setError(
                email,
                emailError,
                "Please enter a valid .com email address."
            );

            return false;
        }


        setError(email, emailError, "");

        return true;
    }


    /* =========================================================
       PASSWORD REQUIREMENTS UI
       ========================================================= */

        function updatePasswordRequirements() {

            const value = password.value;

            const lengthValid =
                value.length >= 6 &&
                value.length <= 20;

            const lowerValid =
                /[a-z]/.test(value);

            const upperValid =
                /[A-Z]/.test(value);

            const numberValid =
                /[0-9]/.test(value);

            const specialValid =
                /[^a-zA-Z0-9]/.test(value);


            const reqLength =
                document.getElementById("reqLength");

            const reqLower =
                document.getElementById("reqLower");

            const reqUpper =
                document.getElementById("reqUpper");

            const reqNumber =
                document.getElementById("reqNumber");

            const reqSpecial =
                document.getElementById("reqSpecial");


            if (reqLength) {
                reqLength.classList.toggle(
                    "valid",
                    lengthValid
                );
            }

            if (reqLower) {
                reqLower.classList.toggle(
                    "valid",
                    lowerValid
                );
            }

            if (reqUpper) {
                reqUpper.classList.toggle(
                    "valid",
                    upperValid
                );
            }

            if (reqNumber) {
                reqNumber.classList.toggle(
                    "valid",
                    numberValid
                );
            }

            if (reqSpecial) {
                reqSpecial.classList.toggle(
                    "valid",
                    specialValid
                );
            }
        }

    /* =========================================================
       PASSWORD VALIDATION
       ========================================================= */

        function validatePassword() {

            const value = password.value;

            updatePasswordRequirements();


            if (!value) {

                setError(
                    password,
                    passwordError,
                    "Password is required."
                );

                return false;
            }


            if (value.length < 6 || value.length > 20) {

                setError(
                    password,
                    passwordError,
                    "Password must be 6–20 characters long."
                );

                return false;
            }


            if (!/[a-z]/.test(value)) {

                setError(
                    password,
                    passwordError,
                    "Password must contain a lowercase letter."
                );

                return false;
            }


            if (!/[A-Z]/.test(value)) {

                setError(
                    password,
                    passwordError,
                    "Password must contain an uppercase letter."
                );

                return false;
            }


            if (!/[0-9]/.test(value)) {

                setError(
                    password,
                    passwordError,
                    "Password must contain a number."
                );

                return false;
            }


            if (!/[^a-zA-Z0-9]/.test(value)) {

                setError(
                    password,
                    passwordError,
                    "Password must contain at least one special character."
                );

                return false;
            }


            setError(
                password,
                passwordError,
                ""
            );

            return true;
        }

    /* =========================================================
       CONFIRM PASSWORD
       ========================================================= */

    function validateConfirmPassword() {

        const value = confirmPassword.value;

        if (!value) {

            setError(
                confirmPassword,
                confirmPasswordError,
                "Please confirm your password."
            );

            return false;
        }


        if (value !== password.value) {

            setError(
                confirmPassword,
                confirmPasswordError,
                "Passwords do not match."
            );

            return false;
        }


        setError(
            confirmPassword,
            confirmPasswordError,
            ""
        );

        return true;
    }


    /* =========================================================
       FIRST / LAST NAME
       ========================================================= */

    function validateFirstName() {

        const value = firstName.value.trim();

        if (!value) {

            setError(
                firstName,
                firstNameError,
                "First name is required."
            );

            return false;
        }

        setError(firstName, firstNameError, "");

        return true;
    }


    function validateLastName() {

        const value = lastName.value.trim();

        if (!value) {

            setError(
                lastName,
                lastNameError,
                "Last name is required."
            );

            return false;
        }

        setError(lastName, lastNameError, "");

        return true;
    }


    /* =========================================================
       CURRENCY
       ========================================================= */

    function validateCurrency() {

        if (!currency.value || currency.value === "0") {

            setError(
                currency,
                currencyError,
                "Please select your currency."
            );

            return false;
        }

        setError(currency, currencyError, "");

        return true;
    }


    /* =========================================================
       COUNTRY
       ========================================================= */

    function validateCountry() {

        if (!country.value) {

            setError(
                country,
                countryError,
                "Please select your country."
            );

            return false;
        }

        setError(country, countryError, "");

        return true;
    }
        /* =========================================================
       BIRTHDAY
       ========================================================= */
        function validateBirthday() {

            const value = birthday.value;

            if (!value) {

                setError(
                    birthday,
                    birthdayError,
                    "Birthday is required."
                );

                return false;
            }

            const birthDate = new Date(value + "T00:00:00");

            if (isNaN(birthDate.getTime())) {

                setError(
                    birthday,
                    birthdayError,
                    "Please enter a valid birthday."
                );

                return false;
            }

            const today = new Date();

            if (birthDate > today) {

                setError(
                    birthday,
                    birthdayError,
                    "Birthday cannot be in the future."
                );

                return false;
            }

            setError(
                birthday,
                birthdayError,
                ""
            );

            return true;
        }


    /* =========================================================
       COMPLETE FORM VALIDATION
       ========================================================= */

    function validateForm() {

        const firstValid = validateFirstName();
        const lastValid = validateLastName();
        const emailValid = validateEmail();
        const passwordValid = validatePassword();
        const confirmValid = validateConfirmPassword();
        const currencyValid = validateCurrency();
        const countryValid = validateCountry();
        const birthdayValid = validateBirthday();

        const isValid =
            firstValid &&
            lastValid &&
            emailValid &&
            passwordValid &&
            confirmValid &&
            currencyValid &&
            countryValid &&
            birthdayValid;


        submitButton.disabled = !isValid;

        return isValid;
    }


    /* =========================================================
       LIVE VALIDATION
       ========================================================= */

    firstName.addEventListener("input", function () {
        validateForm();
    });

    lastName.addEventListener("input", function () {
        validateForm();
    });

    email.addEventListener("input", function () {
        clearServerMessage();
        validateForm();
    });

    password.addEventListener("input", function () {
        clearServerMessage();
        validateForm();
    });

    confirmPassword.addEventListener("input", function () {
        validateForm();
    });

    currency.addEventListener("change", function () {
        validateForm();
    });

    country.addEventListener("change", function () {
        validateForm();
    });
    birthday.addEventListener("change", function () {
        validateForm();
    });

    /* =========================================================
       AJAX REGISTER
       ========================================================= */

    form.addEventListener("submit", async function (event) {

        /*
         * VERY IMPORTANT:
         *
         * Prevent normal form submission.
         *
         * Therefore your existing page loading mask
         * never activates.
         */

        event.preventDefault();
        event.stopPropagation();


        clearServerMessage();


        /*
         * Validate one final time before sending.
         */

        if (!validateForm()) {
            return;
        }


        submitButton.disabled = true;
        submitButton.classList.add("is-loading");


        try {

                const formData = new FormData(form);

                const promoValue = promoCode.value.trim();

                if (promoValue) {
                    formData.set("promocode", promoValue);
                } else {
                    formData.set("promocode", "000000");
                }

            const response = await fetch(
                form.action,
                {
                    method: "POST",

                    body: formData,

                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                }
            );


            if (!response.ok) {
                throw new Error(
                    "Unable to process registration."
                );
            }


            const result = await response.json();


            /* =================================================
               SUCCESS
               ================================================= */

            if (result.success) {

                showServerMessage(
                    result.msg || "Successfully Signed Up!"
                );

            if (result.errorPromoCode) {

                setError(
                    promoCode,
                    promoCodeError,
                    result.errorPromoCode
                );
            }

                /*
                 * Give the user a short moment to see success.
                 */
                    window.location.reload();
                    $("#success-header").text("Sign Up");
                    $("#success-body").text("Successfully sign up");
                    const modal = document.getElementById("success-notice-modal");
                    modal.style.transform = "translateX(0%)";
                    setTimeout(function () {
                        modal.style.transform = "translateX(110%)";
                    }, 2000);


                return;
            }


            /* =================================================
               BACKEND VALIDATION ERRORS
               ================================================= */

            if (result.errorEmail) {
                    $("#failed-header").text("Sign Up");
                    $("#failed-body").text(result.errorEmail);
                    const modal = document.getElementById("failed-notice-modal");
                    modal.style.transform = "translateX(0%)";
                    setTimeout(function () {
                        modal.style.transform = "translateX(110%)";
                    }, 3000);
            }


            if (result.errorPassword) {

                setError(
                    password,
                    passwordError,
                    result.errorPassword
                );
            }


            if (result.errorConfirmPassword) {

                setError(
                    confirmPassword,
                    confirmPasswordError,
                    result.errorConfirmPassword
                );
            }


            if (result.errorCurrency) {

                setError(
                    currency,
                    currencyError,
                    result.errorCurrency
                );
            }
                if (result.errorPromoCode) {
                    $("#failed-header").text("Sign Up");
                    $("#failed-body").text("Invalid PromoCode");
                    const modal = document.getElementById("failed-notice-modal");
                    modal.style.transform = "translateX(0%)";
                    setTimeout(function () {
                        modal.style.transform = "translateX(110%)";
                    }, 3000);
                }


                if (
                    !result.errorEmail &&
                    !result.errorPassword &&
                    !result.errorConfirmPassword &&
                    !result.errorCurrency &&
                    !result.errorPromoCode
                ) {
                    showServerMessage(
                        result.msg || "Sign Up Failed!"
                    );
                }


            /*
             * Re-enable only if the frontend is valid.
             * If backend returned an error, the relevant field
             * remains marked as invalid.
             */

            validateForm();

        }
        catch (error) {

            console.error(
                "Registration error:",
                error
            );

            showServerMessage(
                "Something went wrong. Please try again."
            );

            submitButton.disabled = false;
        }
        finally {

            submitButton.classList.remove("is-loading");

            /*
             * Don't blindly enable the button.
             *
             * The frontend validation decides whether
             * it should be enabled.
             */

            validateForm();
        }

    });

});

</script>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =========================================================
           MODAL ELEMENTS
           ========================================================= */

        const modal =
            document.getElementById("signupModal");

        const form =
            document.getElementById("loginForm");

        const submitButton =
            document.getElementById("loginSubmit");

        const email =
            document.getElementById("LoginEmail");

        const password =
            document.getElementById("LoginPassword");

        const emailError =
            document.getElementById("loginEmailError");

        const passwordError =
            document.getElementById("loginPasswordError");

        const serverMessage =
            document.getElementById("loginServerMessage");


        if (!modal || !form || !submitButton || !email || !password) {
            return;
        }


        /* =========================================================
           CLOSE LOGIN MODAL
           ========================================================= */

        function closeLoginModal() {
            window.closeAccountModal?.();
        }


        /* =========================================================
           PASSWORD SHOW / HIDE
           ========================================================= */

        document
            .querySelectorAll(".login-password-toggle")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const target =
                            document.getElementById(
                                button.dataset.target
                            );

                        if (!target) {
                            return;
                        }


                        if (target.type === "password") {

                            target.type = "text";

                            button.textContent = "Hide";

                        }
                        else {

                            target.type = "password";

                            button.textContent = "Show";
                        }

                    }
                );

            });


        /* =========================================================
           CLEAR LOGIN ERRORS
           ========================================================= */

        function clearErrors() {

            if (emailError) {
                emailError.textContent = "";
            }

            if (passwordError) {
                passwordError.textContent = "";
            }


            const emailField =
                email.closest(".login-field");

            const passwordField =
                password.closest(".login-field");


            if (emailField) {

                emailField.classList.remove(
                    "has-error",
                    "is-valid"
                );
            }


            if (passwordField) {

                passwordField.classList.remove(
                    "has-error",
                    "is-valid"
                );
            }
        }


        /* =========================================================
           SERVER MESSAGE
           ========================================================= */

        function showServerMessage(
            message,
            success = false
        ) {

            if (!serverMessage) {
                return;
            }


            serverMessage.textContent =
                message;

            serverMessage.classList.add(
                "is-visible"
            );

            serverMessage.classList.toggle(
                "success",
                success
            );
        }


        function clearServerMessage() {

            if (!serverMessage) {
                return;
            }


            serverMessage.textContent = "";

            serverMessage.classList.remove(
                "is-visible",
                "success"
            );
        }


        /* =========================================================
           LOGIN VALIDATION
           ========================================================= */

        function validateLogin() {

            const emailValue =
                email.value.trim();

            const passwordValue =
                password.value;


            /*
             * Email must have a valid email format.
             */
            const emailValid =
                /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(
                    emailValue
                );


            /*
             * Password only needs to contain something.
             *
             * Backend will handle whether the password
             * itself is correct.
             */
            const passwordValid =
                passwordValue.length > 0;


            /*
             * Update visual field state.
             */

            const emailField =
                email.closest(".login-field");

            const passwordField =
                password.closest(".login-field");


            if (emailField) {

                emailField.classList.toggle(
                    "is-valid",
                    emailValid
                );
            }


            if (passwordField) {

                passwordField.classList.toggle(
                    "is-valid",
                    passwordValid
                );
            }


            /*
             * IMPORTANT:
             *
             * Button is disabled when the form
             * is NOT valid.
             *
             * Therefore:
             *
             * valid email + valid password
             *          ↓
             *      disabled = false
             *          ↓
             *       ENABLED
             */
            const isValid =
                emailValid &&
                passwordValid;


            submitButton.disabled =
                !isValid;


            return isValid;
        }


        /* =========================================================
           EMAIL INPUT
           ========================================================= */

        email.addEventListener(
            "input",
            function () {

                clearServerMessage();

                validateLogin();
            }
        );


        /* =========================================================
           PASSWORD INPUT
           ========================================================= */

        password.addEventListener(
            "input",
            function () {

                clearServerMessage();

                validateLogin();
            }
        );


        /* =========================================================
           AUTOMATIC IMAGE SLIDER
           ========================================================= */

        const slides =
            document.querySelectorAll(
                "#signupVisual .account-modal-slide"
            );

        const dots =
            document.querySelectorAll(
                "#signupVisual .account-modal-dots span"
            );

        let currentSlide = 0;

        let sliderTimer = null;


        function showSlide(index) {

            if (!slides.length) {
                return;
            }


            slides.forEach(function (slide) {

                slide.classList.remove(
                    "active"
                );

            });


            dots.forEach(function (dot) {

                dot.classList.remove(
                    "active"
                );

            });


            if (slides[index]) {

                slides[index].classList.add(
                    "active"
                );
            }


            if (dots[index]) {

                dots[index].classList.add(
                    "active"
                );
            }


            currentSlide = index;
        }


        function nextSlide() {

            if (!slides.length) {
                return;
            }


            const nextIndex =
                (currentSlide + 1) %
                slides.length;


            showSlide(nextIndex);
        }


        function startSlider() {

            if (
                slides.length <= 1 ||
                sliderTimer
            ) {
                return;
            }


            sliderTimer =
                setInterval(
                    nextSlide,
                    4000
                );
        }


        function stopSlider() {

            if (!sliderTimer) {
                return;
            }


            clearInterval(
                sliderTimer
            );

            sliderTimer = null;
        }


        startSlider();


        /* =========================================================
           SLIDER DOT CLICK
           ========================================================= */

        dots.forEach(function (dot, index) {

            dot.addEventListener(
                "click",
                function () {

                    showSlide(index);

                    stopSlider();

                    startSlider();

                }
            );

        });


        /* =========================================================
           AJAX LOGIN
           ========================================================= */

        form.addEventListener(
            "submit",
            async function (event) {

                /*
                 * Prevent normal form submission.
                 */

                event.preventDefault();

                event.stopPropagation();


                /*
                 * Frontend validation.
                 *
                 * This is also an extra protection even though
                 * the button should already be disabled when invalid.
                 */

                if (!validateLogin()) {
                    return;
                }


                clearErrors();

                clearServerMessage();


                /*
                 * Prevent double submission.
                 */

                if (
                    submitButton.classList.contains(
                        "is-loading"
                    )
                ) {
                    return;
                }


                submitButton.classList.add(
                    "is-loading"
                );

                submitButton.disabled = true;


                try {

                    const formData =
                        new FormData(form);


                    const response =
                        await fetch(
                            form.action,
                            {
                                method: "POST",

                                body: formData,

                                headers: {
                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                }
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Login request failed."
                        );
                    }


                    const result =
                        await response.json();


                    /* =============================================
                       SUCCESS
                       ============================================= */

                    if (result.success) {

                        showServerMessage(
                            result.msg ||
                            "Successfully Signed In!",
                            true
                        );


                        /*
                         * Existing success notification.
                         */

                        $("#success-header").text(
                            "Login"
                        );

                        $("#success-body").text(
                            "Successfully login"
                        );


                        const successModal =
                            document.getElementById(
                                "success-notice-modal"
                            );


                        if (successModal) {

                            successModal.style.transform =
                                "translateX(0%)";


                            setTimeout(
                                function () {

                                    successModal.style.transform =
                                        "translateX(110%)";

                                },
                                2000
                            );
                        }


                        /*
                         * Keep your existing successful-login
                         * behavior.
                         */

                        setTimeout(
                            function () {

                                closeLoginModal();

                                window.location.reload();

                            },
                            300
                        );


                        return;
                    }


                    /* =============================================
                       TWO FACTOR AUTHENTICATION
                       ============================================= */

                    if (
                        result.requires2FA
                    ) {

                        showServerMessage(
                            result.msg ||
                            "Two-Factor Authentication required."
                        );


                        return;
                    }


                    /* =============================================
                       BACKEND EMAIL ERROR
                       ============================================= */

                    if (
                        result.errorEmail
                    ) {

                        if (emailError) {

                            emailError.textContent =
                                result.errorEmail;
                        }


                        const emailField =
                            email.closest(".login-field");


                        if (emailField) {

                            emailField.classList.add(
                                "has-error"
                            );

                            emailField.classList.remove(
                                "is-valid"
                            );
                        }
                    }


                    /* =============================================
                       BACKEND PASSWORD ERROR
                       ============================================= */

                    if (
                        result.errorPassword
                    ) {

                        if (passwordError) {

                            passwordError.textContent =
                                result.errorPassword;
                        }


                        const passwordField =
                            password.closest(".login-field");


                        if (passwordField) {

                            passwordField.classList.add(
                                "has-error"
                            );

                            passwordField.classList.remove(
                                "is-valid"
                            );
                        }
                    }


                    /* =============================================
                       GENERAL LOGIN ERROR
                       ============================================= */

                    if (
                        result.msg &&
                        !result.errorEmail &&
                        !result.errorPassword
                    ) {

                        showServerMessage(
                            result.msg
                        );
                    }

                }
                catch (error) {

                    console.error(
                        "Login error:",
                        error
                    );


                    showServerMessage(
                        "Unable to sign in. Please try again."
                    );

                }
                finally {

                    submitButton.classList.remove(
                        "is-loading"
                    );


                    /*
                     * Re-check frontend validation.
                     *
                     * If email/password are still valid,
                     * the button becomes enabled again.
                     */

                    validateLogin();

                }

            }
        );


        /* =========================================================
           INITIAL STATE
           ========================================================= */

        validateLogin();

    });

</script>
