@model MyStake.Models.LoginViewModel;
@using Microsoft.Extensions.Localization
@{
    string ReturnUrl = "";
    if (ViewData["ReturnUrl"] != null)
    {
        ReturnUrl = (string)ViewData["ReturnUrl"];
    }
}
<style>
    .login-swal-popup {
        background: #1b1b22 !important;
        border: 1px solid #30303a !important;
        border-radius: 16px !important;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.55) !important;
        color: #ffffff !important;
        padding: 28px 24px !important;
    }

    .login-swal-title {
        color: #ffffff !important;
        font-size: 21px !important;
        font-weight: 600 !important;
        margin-top: 8px !important;
    }

    .login-swal-text {
        color: #a9a9b3 !important;
        font-size: 14px !important;
        margin-top: 8px !important;
    }

    .login-swal-confirm {
        background: #00aaeb !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 10px 28px !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        box-shadow: none !important;
    }

        .login-swal-confirm:hover {
            background: #0098d2 !important;
        }

    .swal2-icon.swal2-error {
        border-color: #ff172d !important;
        color: #ff172d !important;
    }

    .swal2-icon.swal2-warning {
        border-color: #00aaeb !important;
        color: #00aaeb !important;
    }

    .swal2-icon.swal2-success {
        border-color: #00aaeb !important;
        color: #00aaeb !important;
    }
</style>

        @{
            if (!User.Identity.IsAuthenticated)
            {
    <div id="mymodal">
        <form class="login-container" id="loginform">
        <div class="user_pass"
             style="display: flex; align-items: center">
            <li class="fa fa-user" style="position:absolute;margin-left:4px;"></li>
                <input style="color: white;padding-left:20px;width:140px" id="email_Login" asp-for="Email"
                   type="text"
                   placeholder="Username/Email"
                   name="Email" />
        </div>
        <div class="user_pass"
             style="display: flex; align-items: center">
            <li class="fa fa-lock" style="position:absolute;margin-ldft:4px;"></li>
                <input style="color: white;padding-left:20px;width:140px" id="password_Login" asp-for="Password"
                   type="password"
                   placeholder="Password"
                   name="Password" />
        </div>
            <a id="BtnLogin">Login</a>
        </form>
    </div>}
}
<script>
    function showLoginAlert(icon, title, message) {

        Swal.fire({
            icon: icon,
            title: title,
            text: message,
            background: "#1b1b22",
            color: "#ffffff",
            confirmButtonText: "OK",
            customClass: {
                popup: "login-swal-popup",
                title: "login-swal-title",
                htmlContainer: "login-swal-text",
                confirmButton: "login-swal-confirm"
            },
            buttonsStyling: false,
            allowOutsideClick: true,
            allowEscapeKey: true
        });
    }


    $("#email_Login, #password_Login").on("input", function () {

        $("#email_Login").css("outline", "none");
        $("#password_Login").css("outline", "none");

        let email = $("#email_Login").val();
        let password = $("#password_Login").val();

        let emailValid = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email);

        let passwordValid =
            password.length >= 6 &&
            password.length <= 20;

        if (emailValid && passwordValid) {
            $("#BtnLogin").prop("disabled", false);
        }
        else {
            $("#BtnLogin").prop("disabled", true);
        }
    });


    let isLoginInProgress = false;


    $("#BtnLogin").on("click", function (e) {

        e.preventDefault();

        if (isLoginInProgress) {
            return;
        }

        isLoginInProgress = true;

        const btn = $(this);

        btn.prop("disabled", true);

        btn.find(".btn-text").hide();
        btn.find(".btn-loader").show();


        $.ajax({
            url: "/account/Dologin",
            method: "POST",
            data: $("#loginform").serialize(),

            success: function (res) {

                // ==========================================
                // LOGIN SUCCESS
                // ==========================================
                if (res.success) {

                    // Keep button disabled while redirecting
                    $("#success-header").text("Sign in");
                    $("#success-body").text("Successfully sign in");

                    const modal = document.getElementById("success-notice-modal");

                    if (modal) {
                        modal.style.transform = "translateX(0%)";

                        setTimeout(function () {
                            modal.style.transform = "translateX(110%)";
                        }, 2000);
                    }


                    if (res.isAdmin) {
                        window.location.href = res.redirectUrl;
                    }
                    else {

                        if ("@ReturnUrl" != "") {
                            window.location.href = "@Html.Raw(ReturnUrl)";
                        }
                        else {
                            window.location.reload();
                        }
                    }

                    return;
                }


                // ==========================================
                // LOGIN FAILED
                // ==========================================

                isLoginInProgress = false;

                btn.prop("disabled", false);

                btn.find(".btn-text").show();
                btn.find(".btn-loader").hide();


                // ==========================================
                // EMAIL ERROR
                // ==========================================
                if (res.errorEmail) {

                    showLoginAlert(
                        "error",
                        "Login Failed",
                        res.errorEmail
                    );

                    return;
                }


                // ==========================================
                // PASSWORD ERROR
                // ==========================================
                if (res.errorPassword) {

                    showLoginAlert(
                        "error",
                        "Login Failed",
                        res.errorPassword
                    );

                    return;
                }


                // ==========================================
                // TWO-FACTOR AUTHENTICATION
                // ==========================================
                if (res.requires2FA) {

                    showLoginAlert(
                        "warning",
                        "Verification Required",
                        res.msg || "Two-Factor Authentication required."
                    );

                    return;
                }


                // ==========================================
                // ACCOUNT LOCKED
                // ==========================================
                if (res.msg === "Account locked out.") {

                    showLoginAlert(
                        "error",
                        "Account Locked",
                        res.msg
                    );

                    return;
                }


                // ==========================================
                // GENERAL LOGIN ERROR
                // ==========================================
                if (res.msg) {

                    showLoginAlert(
                        "error",
                        "Login Failed",
                        res.msg
                    );

                    return;
                }


                // ==========================================
                // FALLBACK ERROR
                // ==========================================
                showLoginAlert(
                    "error",
                    "Login Failed",
                    "Unable to sign in. Please try again."
                );
            },


            // ==========================================
            // SERVER / AJAX ERROR
            // ==========================================
            error: function () {

                isLoginInProgress = false;

                btn.prop("disabled", false);

                btn.find(".btn-text").show();
                btn.find(".btn-loader").hide();


                showLoginAlert(
                    "error",
                    "Server Error",
                    "Something went wrong. Please try again."
                );
            }
        });
    });
</script>
