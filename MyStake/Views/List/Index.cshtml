    </section>
    <div class="two-cards" id="listcard">

        @foreach (MyStake.Models.GameListMedel game in homegames)
        {
            <div class="two-card"
                 onclick="GetGameUrl('@game.GameCode','@game.VendorCode','@game.GameName','@game.Status')">

                <div class="game-card-image">

                    <!-- NEW / HOT -->
                    <div class="game-badges">

                        @if (game.IsNew)
                        {
                            <span class="game-badge game-badge-new">

                                <span class="game-badge-icon">
                                    <svg width="11"
                                         height="11"
                                         viewBox="0 0 24 24"
                                         fill="none">

                                        <path d="M12 2L14.9 8.1L21.5 8.9L16.7 13.4L18 20L12 16.7L6 20L7.3 13.4L2.5 8.9L9.1 8.1L12 2Z"
                                              fill="currentColor" />

                                    </svg>
                                </span>

                                <span>NEW</span>

                            </span>
                        }

                        @if (game.IsHot)
                        {
                            <span class="game-badge game-badge-hot">

                                <span class="game-badge-icon">
                                    <svg width="11"
                                         height="11"
                                         viewBox="0 0 24 24"
                                         fill="none">

                                        <path d="M13.5 2C13.5 2 15 6.5 11.5 9.5C10.1 10.7 9.5 12 9.5 13.5C9.5 15.4 10.9 17 12.8 17C15.7 17 17.5 14.8 17.5 12.1C17.5 10.5 16.9 9 16.1 7.7C19.4 10 21 13.1 21 16C21 20.4 17.4 23 12.5 23C7.2 23 3 19.4 3 14.5C3 10.5 5.5 7.2 9.2 5C8.9 7.3 9.6 8.7 10.5 9.3C11.3 7 12.4 4.6 13.5 2Z"
                                              fill="currentColor" />

                                    </svg>
                                </span>

                                <span>HOT</span>

                            </span>
                        }

                    </div>


                    <!-- GAME IMAGE -->
                    <div class="image-wrapper loading">

                        <img class="lazy-image"
                             src="@(string.IsNullOrEmpty(game.Thumbnail) ? "~/images/default-game-image.png" : game.Thumbnail)"
                             draggable="false"
                             alt="@game.GameName"
                             onerror="this.onerror=null; this.src='/images/default-game.png';" />

                    </div>


                    <!-- CENTER PLAY BUTTON -->
                    <button type="button"
                            class="game-action-play"
                            onclick="event.stopPropagation(); GetGameUrl('@game.GameCode','@game.VendorCode','@game.GameName','@game.Status');">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 14 14"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">

                            <path d="M5 3L10 7L5 11V3Z"
                                  fill="currentColor" />

                        </svg>

                    </button>


                    <!-- BOTTOM HOVER AREA -->
                    <div class="game-hover">

                        <div class="game-hover-panel">

                            <div class="game-hover-info">

                                <div class="game-hover-name">
                                    @game.GameName
                                </div>

                                <div class="game-hover-provider">
                                    @game.VendorCode
                                </div>

                            </div>


                            <div class="game-hover-actions">

                                <!-- Favorite -->
                                <button type="button"
                                        class="game-action-favorite"
                                        onclick="event.stopPropagation();">

                                    <svg width="18"
                                         height="18"
                                         viewBox="0 0 22 20"
