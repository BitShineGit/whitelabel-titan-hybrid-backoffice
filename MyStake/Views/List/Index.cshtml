@{
    var title = ViewData["title"];
    ViewData["Title"] = title;
    List<MyStake.Models.GameListMedel> homegames = (List<MyStake.Models.GameListMedel>)ViewData["SelectGameList"];
    List<Titan.Repository.Database.Provider> provider = (List<Titan.Repository.Database.Provider>)ViewData["provider"];
    List<Titan.Repository.Database.Provider> providers = (List<Titan.Repository.Database.Provider>)ViewData["providers"];
    string providercode = (string)ViewData["providercode"];
    string defaulprovider = (string)ViewData["default"];
    int type = (int)ViewData["providertype"];
}
<style>

    /* =========================================================
           GAME CARD
        ========================================================= */

    .two-card {
        position: relative;
        overflow: hidden;
        cursor: pointer;
        border-radius: 12px;
        transform: translateZ(0);
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    }

        .two-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 38px rgba(0, 0, 0, 0.34);
        }


    /* =========================================================
           CARD IMAGE CONTAINER
        ========================================================= */

    .game-card-image {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: inherit;
        isolation: isolate;
    }


        /* =========================================================
           IMAGE
        ========================================================= */

        .game-card-image .image-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            overflow: hidden;
            border-radius: inherit;
        }

        .game-card-image .lazy-image {
            display: block;
            width: 100%;
            height: auto;
            object-fit: cover;
            transform: scale(1);
            transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
        }

    .two-card:hover .lazy-image {
        transform: scale(1.065);
        filter: brightness(0.68);
    }


    /* =========================================================
           IMAGE DARKENING
        ========================================================= */

    .game-card-image::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 8;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient( to bottom, rgba(5, 8, 13, 0.05) 0%, rgba(5, 8, 13, 0.08) 35%, rgba(5, 8, 13, 0.48) 72%, rgba(5, 8, 13, 0.88) 100% );
        transition: opacity 0.4s ease;
    }

    .two-card:hover .game-card-image::after {
        opacity: 1;
    }


    /* =========================================================
           NEW / HOT
           NEW = LEFT
           HOT = RIGHT
        ========================================================= */

    .game-badges {
        position: absolute;
        top: 10px;
        left: 10px;
        right: 10px;
        z-index: 30;
        display: flex;
        align-items: center;
        pointer-events: none;
        transform: translateY(0);
        transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .two-card:hover .game-badges {
        transform: translateY(-2px);
    }


    /* =========================================================
           BADGE
        ========================================================= */

    .game-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-width: 48px;
        height: 25px;
        padding: 0 9px 0 6px;
        overflow: hidden;
        border-radius: 999px;
        color: #fff;
        font-size: 9px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.8px;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.22);
        transform: translateZ(0);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }


    /* =========================================================
           HOT ALWAYS GOES TO RIGHT
        ========================================================= */

    .game-badge-hot {
        margin-left: auto;
        background: linear-gradient( 135deg, rgba(255, 94, 94, 0.98), rgba(220, 39, 72, 0.94) );
        border: 1px solid rgba(255, 157, 157, 0.48);
        box-shadow: 0 6px 20px rgba(255, 55, 80, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.22);
    }


    /* =========================================================
           NEW
        ========================================================= */

    .game-badge-new {
        background: linear-gradient( 135deg, rgba(0, 190, 255, 0.98), rgba(0, 137, 218, 0.94) );
        border: 1px solid rgba(111, 220, 255, 0.48);
        box-shadow: 0 6px 20px rgba(0, 170, 235, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.22);
    }


    /* =========================================================
           BADGE SHINE
        ========================================================= */

    .game-badge::after {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.28), transparent );
        transform: skewX(-20deg);
        transition: left 0.7s ease;
    }

    .two-card:hover .game-badge::after {
        left: 140%;
    }


    /* =========================================================
           BADGE ICON
        ========================================================= */

    .game-badge-icon {
        width: 17px;
        height: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
    }

        .game-badge-icon svg {
            display: block;
        }


    /* =========================================================
           CENTER PLAY BUTTON
        ========================================================= */

    .game-action-play {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 50;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 50%;
        color: #fff;
        background: linear-gradient( 135deg, #00c4f7, #009fe0 );
        box-shadow: 0 6px 18px rgba(0, 170, 235, 0.38), 0 0 0 1px rgba(0, 190, 255, 0.10);
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -50%) scale(0.75);
        transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), filter 0.2s ease, box-shadow 0.2s ease;
    }


    /* SHOW CENTER PLAY */

    .two-card:hover .game-action-play {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, -50%) scale(1);
    }


    /* PLAY HOVER */

    .game-action-play:hover {
        filter: brightness(1.08);
        box-shadow: 0 8px 24px rgba(0, 170, 235, 0.50), 0 0 0 3px rgba(0, 190, 255, 0.12);
        transform: translate(-50%, -50%) scale(1.08);
    }

    .game-action-play svg {
        display: block;
        margin-left: 2px;
        transition: transform 0.2s ease;
    }

    .game-action-play:hover svg {
        transform: scale(1.05);
    }


    /* =========================================================
           HOVER AREA
           BOTTOM INFORMATION PANEL
        ========================================================= */

    .game-hover {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        padding: 55px 10px 10px;
        opacity: 0;
        transform: translateY(12px);
        background: linear-gradient( to bottom, rgba(5, 8, 13, 0) 0%, rgba(5, 8, 13, 0.08) 20%, rgba(5, 8, 13, 0.65) 62%, rgba(5, 8, 13, 0.96) 100% );
        transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .two-card:hover .game-hover {
        opacity: 1;
        transform: translateY(0);
    }


    /* =========================================================
           HOVER PANEL
        ========================================================= */

    .game-hover-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        min-height: 48px;
        padding: 8px 8px 8px 11px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        background: rgba(12, 17, 25, 0.78);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transform: translateY(8px);
        opacity: 0;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.03s, opacity 0.3s ease 0.03s;
    }

    .two-card:hover .game-hover-panel {
        transform: translateY(0);
        opacity: 1;
    }


    /* =========================================================
           GAME INFORMATION
        ========================================================= */

    .game-hover-info {
        min-width: 0;
        flex: 1;
    }

    .game-hover-name {
        overflow: hidden;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .game-hover-provider {
        margin-top: 2px;
        overflow: hidden;
        color: rgba(255, 255, 255, 0.48);
        font-size: 9px;
        font-weight: 500;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: nowrap;
        text-overflow: ellipsis;
    }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .game-hover-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }


    /* =========================================================
           FAVORITE
        ========================================================= */

    .game-action-favorite {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 8px;
        color: rgba(255, 255, 255, 0.78);
        background: rgba(255, 255, 255, 0.06);
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

        .game-action-favorite:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.13);
            transform: translateY(-2px);
        }



</style>
