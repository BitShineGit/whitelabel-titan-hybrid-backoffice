<script>
    function GetGameUrl(gamecode, providercode, gamename, status) {

        if ("@User.Identity.IsAuthenticated" == "True") {

            // Game is active
            if (status == 1) {

                window.location.href =
                    `/Game/GetLaunchUrl?gamecode=${encodeURIComponent(gamecode)}` +
                    `&providercode=${encodeURIComponent(providercode)}` +
                    `&gamename=${encodeURIComponent(gamename)}`;

                return;
            }

            // Game is under maintenance
            if (status == 0) {

                showGameMaintenance(gamename);

                return;
            }
        }
        else {

            const mobile_loginButton =
                document.querySelector("#openLoginModal");

            if (mobile_loginButton) {
                mobile_loginButton.click();
            }
        }
    }


    function showGameMaintenance(gameName) {

        Swal.fire({
            icon: 'info',
            title: 'Game Under Maintenance',
            html: `
                    <div style="
                        margin-top: 8px;
                        color: #aeb4c0;
                        font-size: 14px;
                        line-height: 1.6;
                    ">
                        <div style="
                            font-size: 15px;
                            color: #ffffff;
                            font-weight: 600;
                            margin-bottom: 8px;
                        ">
                            ${gameName}
                        </div>

                        <div>
                            This game is temporarily unavailable
                            while we perform maintenance.
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #7f8794;
                            font-size: 13px;
                        ">
                            Please try again later.
                        </div>
                    </div>
                `,
            background: '#151922',
            color: '#ffffff',
            confirmButtonText: 'OK',
            confirmButtonColor: '#00aaeb',
            buttonsStyling: true,
            customClass: {
                popup: 'game-maintenance-popup',
                title: 'game-maintenance-title',
                confirmButton: 'game-maintenance-button'
            }
        });

    }

</script>
<script>

    /* =========================================================
       CURRENT PROVIDER
    ========================================================= */

    var code = $("#default").text();


    /* =========================================================
       GAME CARD HTML
    ========================================================= */

    function buildGameCard(game) {

        return `
    <div
      class="two-card"
      onclick="
        GetGameUrl(
          '${game.gameCode}',
          '${game.vendorCode}',
          '${game.gameName}',
          '${game.status}',
        )
      "
    >
      <div class="game-card-image">
        <!-- NEW / HOT badges -->
        <div class="game-badges">
          ${game.isNew ? `
          <span class="game-badge game-badge-new">
            <span class="game-badge-icon">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none">
                <path
                  d="M12 2L14.9 8.1L21.5 8.9L16.7 13.4L18 20L12 16.7L6 20L7.3 13.4L2.5 8.9L9.1 8.1L12 2Z"
                  fill="currentColor"
                />
              </svg>
            </span>
            <span>NEW</span>
          </span>
          ` : ''} ${game.isHot ? `
          <span class="game-badge game-badge-hot">
            <span class="game-badge-icon">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none">
                <path
                  d="M13.5 2C13.5 2 15 6.5 11.5 9.5C10.1 10.7 9.5 12 9.5 13.5C9.5 15.4 10.9 17 12.8 17C15.7 17 17.5 14.8 17.5 12.1C17.5 10.5 16.9 9 16.1 7.7C19.4 10 21 13.1 21 16C21 20.4 17.4 23 12.5 23C7.2 23 3 19.4 3 14.5C3 10.5 5.5 7.2 9.2 5C8.9 7.3 9.6 8.7 10.5 9.3C11.3 7 12.4 4.6 13.5 2Z"
                  fill="currentColor"
                />
              </svg>
            </span>
            <span>HOT</span>
          </span>
          ` : ''}
        </div>
        <!-- Game image -->
        <div class="image-wrapper loading">
    <img
        class="lazy-image"
        src="${game.thumbnail || '/images/default-game.png'}"
        draggable="false"
        alt="${game.gameName}"
                onerror="this.onerror=null; this.src='/images/default-game-image.png';"
    />
        </div>


                <!-- Play -->

                     <button
                        type="button"
                        class="game-action-play"
                        onclick="
                          event.stopPropagation();
                          GetGameUrl(
                            '${game.gameCode}',
                            '${game.vendorCode}',
                            '${game.gameName}',
                            '${game.status}',
                          );
                        "
                      >
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">

                                <path d="M5 3L10 7L5 11V3Z" fill="currentColor"></path>

                            </svg>

                        </button>
        <!-- Hover -->
        <div class="game-hover">
          <div class="game-hover-panel">
            <div class="game-hover-info">
              <div class="game-hover-name">${game.gameName}</div>
              <div class="game-hover-provider">${game.vendorCode}</div>
            </div>
            <div class="game-hover-actions">
              <!-- Favorite -->
              <button
                type="button"
                class="game-action-favorite"
                onclick="event.stopPropagation()"
              >
                <svg
                  width="18"
                  height="17"
                  viewBox="0 0 22 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M10.792 16.6648C12.3983 15.2259 13.5862 14.1383 14.3559 13.4021C15.1256 12.6659 15.9622 11.7959 16.8657 10.792C17.7692 9.78807 18.3883 8.90129 18.7229 8.13163C19.091 7.36197 19.275 6.60904 19.275 5.87284C19.275 4.80201 18.907 3.91522 18.1708 3.21249C17.468 2.50975 16.5812 2.15839 15.5104 2.15839C14.6738 2.15839 13.8874 2.39263 13.1512 2.86112C12.4485 3.32961 11.9633 3.93195 11.6956 4.66815H9.68774C9.42004 3.93195 8.91808 3.32961 8.18188 2.86112C7.47915 2.39263 6.70949 2.15839 5.8729 2.15839C4.80207 2.15839 3.89855 2.50975 3.16235 3.21249C2.45962 3.91522 2.10825 4.80201 2.10825 5.87284C2.10825 6.60904 2.27557 7.36197 2.6102 8.13163C2.9783 8.90129 3.61411 9.78807 4.51763 10.792C5.42114 11.7959 6.25773 12.6659 7.02739 13.4021C7.79705 14.1383 8.98501 15.2259 10.5913 16.6648L10.6917 16.7652L10.792 16.6648ZM15.5104 0C17.1836 0 18.5723 0.568867 19.6766 1.70663C20.8144 2.84439 21.3833 4.23313 21.3833 5.87284C21.3833 6.84328 21.1992 7.79699 20.8311 8.73397C20.463 9.63749 19.777 10.6581 18.7731 11.7959C17.8027 12.9336 16.9159 13.8874 16.1127 14.657C15.3096 15.4267 14.0213 16.6146 12.2477 18.2209L10.6917 19.6264L9.1356 18.2711C6.82661 16.1963 5.15343 14.6406 4.11606 13.6029C3.11216 12.5655 2.17518 11.3441 1.30513 9.93866C0.435075 8.53319 0 7.17792 0 5.87284C0 4.23313 0.552197 2.84439 1.65649 1.70663C2.79425 0.568867 4.19972 0 5.8729 0C7.81379 0 9.42004 0.752917 10.6917 2.25878C11.9633 0.752917 13.5695 0 15.5104 0Z"
                    fill="currentColor"
                  ></path>
                </svg>
              </button>
          
            </div>
          </div>
        </div>
      </div>
    </div>
    `;

    }


    /* =========================================================
       NORMAL PROVIDER LOAD
    ========================================================= */

    function GetProviderlist(providercode) {

        code = providercode;

        /*
         * Reset normal-game pagination whenever
         * the provider changes.
         */
        resetGamePagination();

        $.ajax({

            url: "/List/GetGame",

            method: "POST",

            data: {
                providercode: providercode
            },

            success: function (res) {

                if (!res || !res.success) {
                    return;
                }

                var Game = "";

                for (var i = 0; i < res.games.length; i++) {

                    Game += buildGameCard(res.games[i]);

                }

                $("#listcard").html(Game);


                /*
                 * Set active provider button.
                 */
                var active = res.providercode;

                active = "." + active;

                $(".provider-button-active")
                    .removeClass("provider-button-active");

                $(active)
                    .addClass("provider-button-active");
            }
        });
    }


    /* =========================================================
       NORMAL GAME PAGINATION
    ========================================================= */

    let gamePage = 2;
    let gameLoading = false;
    let gameHasMore = true;


    function resetGamePagination() {

        gamePage = 2;
        gameLoading = false;
        gameHasMore = true;
    }


    function loadGames() {

        /*
         * Do not load normal games while search is active.
         */
        var searchValue = $.trim(
            $("#search-game-input").val()
        );

        if (searchValue !== "") {
            return;
        }


        if (gameLoading || !gameHasMore) {
            return;
        }


        gameLoading = true;


        $.ajax({

            url: "/List/GetGame",

            type: "POST",

            data: {

                providercode: code,

                page: gamePage,

                pageSize: 35

            },

            success: function (res) {

                if (!res || !res.success) {

                    gameHasMore = false;

                    return;
                }


                if (!res.games || res.games.length === 0) {

                    gameHasMore = false;

                    return;
                }


                var html = "";


                for (var i = 0; i < res.games.length; i++) {

                    html += buildGameCard(res.games[i]);

                }


                $("#listcard").append(html);


                /*
                 * Server tells us whether another page exists.
                 */
                if (res.hasMore === false) {

                    gameHasMore = false;

                } else {

                    gamePage++;

                }

            },

            error: function () {

                /*
                 * Do not disable pagination permanently
                 * when the request fails.
                 */

            },

            complete: function () {

                gameLoading = false;

            }

        });
    }


    /* =========================================================
       SEARCH GAME PAGINATION
    ========================================================= */

    let searchGamePage = 1;
    let searchGameLoading = false;
    let searchGameHasMore = false;
    let searchGameRequest = null;
    let searchGameTimer = null;


    function resetSearchPagination() {

        searchGamePage = 1;
        searchGameLoading = false;
        searchGameHasMore = false;

    }


    function loadSearchGames(resetList) {

        /*
         * Search must have text.
         */
        var searchValue = $.trim(
            $("#search-game-input").val()
        );


        if (searchValue === "") {
            return;
        }


        /*
         * Prevent duplicate requests.
         */
        if (searchGameLoading) {
            return;
        }


        /*
         * Nothing more to load.
         */
        if (!resetList && !searchGameHasMore) {
            return;
        }


        searchGameLoading = true;


        /*
         * If this is a new search,
         * start from page 1.
         */
        if (resetList) {

            searchGamePage = 1;
            searchGameHasMore = false;

            $("#listcard").html("");

        }


        searchGameRequest = $.ajax({

            url: "/List/GetGamesAjax",

            type: "POST",

            data: {

                code: code,

                page: searchGamePage,

                search: searchValue

            },

            success: function (res) {

                if (!res || !res.success) {

                    if (searchGamePage === 1) {
                        $("#listcard").html("");
                    }

                    searchGameHasMore = false;

                    return;
                }


                /*
                 * No results.
                 */
                if (!res.selectGameList ||
                    res.selectGameList.length === 0) {

                    if (searchGamePage === 1) {
                        $("#listcard").html("");
                    }

                    searchGameHasMore = false;

                    return;
                }


                var html = "";


                for (
                    var i = 0;
                    i < res.selectGameList.length;
                    i++
                ) {

                    html += buildGameCard(
                        res.selectGameList[i]
                    );

                }


                /*
                 * First search page replaces
                 * existing games.
                 */
                if (searchGamePage === 1) {

                    $("#listcard").html(html);

                } else {

                    /*
                     * Following pages append.
                     */
                    $("#listcard").append(html);

                }


                /*
                 * Server tells us whether
                 * another page exists.
                 */
                searchGameHasMore = res.hasMore === true;


                /*
                 * Only move to the next page
                 * when another page exists.
                 */
                if (searchGameHasMore) {

                    searchGamePage++;

                }

            },

            error: function (xhr, status) {

                /*
                 * Ignore aborted request.
                 */
                if (status === "abort") {
                    return;
                }

            },

            complete: function () {

                searchGameRequest = null;

                searchGameLoading = false;

            }

        });
    }


    /* =========================================================
       SEARCH INPUT
    ========================================================= */

    $("#search-game-input").on(
        "input",
        function () {

            var searchValue = $.trim(
                $(this).val()
            );


            /*
             * Cancel previous debounce.
             */
            clearTimeout(searchGameTimer);


            /*
             * Cancel previous AJAX request.
             */
            if (searchGameRequest) {

                searchGameRequest.abort();

                searchGameRequest = null;

            }


            /*
             * Reset search state.
             */
            resetSearchPagination();


            /*
             * Empty search:
             *
             * Stop search pagination.
             *
             * Normal games can work again.
             */
            if (searchValue === "") {

                $("#listcard").html("");

                /*
                 * Reload the first normal provider page.
                 */
                resetGamePagination();

                GetProviderlist(code);

                return;
            }


            /*
             * Wait 250ms before sending request.
             */
            searchGameTimer = setTimeout(
                function () {

                    loadSearchGames(true);

                },
                250
            );

        }
    );


    /* =========================================================
       WINDOW SCROLL
    ========================================================= */

    $(window).on(
        "scroll",
        function () {

            var searchValue = $.trim(
                $("#search-game-input").val()
            );


            /*
             * -------------------------------------------------
             * SEARCH MODE
             * -------------------------------------------------
             */

            if (searchValue !== "") {

                if (
                    searchGameLoading ||
                    !searchGameHasMore
                ) {
                    return;
                }


                var scrollTop = $(window).scrollTop();

                var windowHeight = $(window).height();

                var documentHeight = $(document).height();


                /*
                 * Load next search page when
                 * approximately 300px from bottom.
                 */
                if (
                    scrollTop + windowHeight >=
                    documentHeight - 300
                ) {

                    loadSearchGames(false);

                }

                return;
            }


            /*
             * -------------------------------------------------
             * NORMAL GAME MODE
             * -------------------------------------------------
             */

            if (
                gameLoading ||
                !gameHasMore
            ) {
                return;
            }


            if (
                $(window).scrollTop() >=
                $(document).height() - 1300
            ) {

                loadGames();

            }

        }
    );

</script>

<script>
    $("#search-provider-input")
        .on("input", function () {
            $.ajax({
                url: "/list/getprovidersajax",
                method: "POST",
                data: {
                    type: @type,
                    search: $("#search-provider-input").val()
                },
                success: function (res) {
                    if (res.success) {
                        
                        var Game = ``;
                        for (var i = 0; i < res.selectProviderList.length; i++) {
                            Game += `<div
                                            class="two-hidden ${res.selectProviderList[i].providerCode}" onclick="GetProviderlist('${res.selectProviderList[i].providerCode}')">
                                        <img style="width:2.5rem;height:2.5rem;"
                                             class="svelte-ioe2qh"
                                             src = "${res.selectProviderList[i].logo}" />
                                            <p  class="two-p" id="two-p">${res.selectProviderList[i].providerCode
                        } </p>
                                    </div>`;
                        }
                        $("#providerlist-box").html(Game);
                        var activecode = "@providercode";
                        activecode = "." + activecode;
                        $(".provider-button-active").removeClass("provider-button-active");
                        $(activecode).addClass("provider-button-active");
                    }
                },
            });
        });
</script>
