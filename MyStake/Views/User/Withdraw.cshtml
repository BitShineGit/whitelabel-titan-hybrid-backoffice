<script>
    function showmore(id) {
        const content = document.getElementById(id);
        content.classList.toggle("show-hide");
    }
</script>
<script>
    /* ============================================================
       DARK CONFIRM MODAL
       ============================================================ */

    function showDarkConfirm(title, message, onConfirm) {

        return Swal.fire({
            icon: "question",
            title: title,
            html: message,

            background: "#1f1f27",
            color: "#ffffff",

            confirmButtonText: "Confirm",
            cancelButtonText: "Cancel",

            showCancelButton: true,
            buttonsStyling: false,

            customClass: {
                popup: "dark-confirm-popup",
                title: "dark-confirm-title",
                htmlContainer: "dark-confirm-message",
                confirmButton: "dark-confirm-button",
                cancelButton: "dark-cancel-button"
            },

            allowOutsideClick: false,
            allowEscapeKey: true,

            didOpen: () => {
                document.body.style.paddingRight = "0px";
            },

            willClose: () => {
                document.body.style.paddingRight = "0px";
            }

        }).then((result) => {

            if (
                result.isConfirmed &&
                typeof onConfirm === "function"
            ) {
                return onConfirm();
            }

            return result;
        });
    }


    /* ============================================================
       KYC REQUIRED MODAL
       ============================================================ */

    function showKycRequiredModal() {

        Swal.fire({

            icon: "info",

            title: "KYC Verification Required",

            html: `
                    <div class="withdraw-kyc-modal-content">

                        <div class="withdraw-kyc-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <div class="withdraw-kyc-text">
                            <p>
                                Please complete your KYC verification
                                before making a withdrawal.
                            </p>

                            <span>
                                You can submit your KYC information
                                from your profile page.
                            </span>
                        </div>

                    </div>
                `,

            background: "#151b21",
            color: "#ffffff",

            confirmButtonText:
                '<i class="fa-solid fa-arrow-right"></i> Go to KYC',

            cancelButtonText:
                "Cancel",

            showCancelButton: true,

            buttonsStyling: false,

            customClass: {

                popup:
                    "withdraw-kyc-popup",

                title:
                    "withdraw-kyc-title",

                htmlContainer:
                    "withdraw-kyc-message",

                confirmButton:
                    "withdraw-kyc-confirm-button",

                cancelButton:
                    "withdraw-kyc-cancel-button"

            },

            allowOutsideClick: false,
            allowEscapeKey: true,

            didOpen: () => {

                document.body.style.paddingRight =
                    "0px";

            },

            willClose: () => {

                document.body.style.paddingRight =
                    "0px";

            }

        }).then((result) => {

            if (result.isConfirmed) {

                /*
                 * Open the personal information page
                 * directly on the KYC section.
                 *
                 * The #kyc hash can be handled by the
                 * profile page tab JavaScript.
                 */
                window.location.href =
                    "/user/personal-information";
            }

        });
    }


    /* ============================================================
       QUICK AMOUNT SELECT BUTTONS
       ============================================================ */

    document.addEventListener(
        "click",
        function (e) {

            const btn =
                e.target.closest(
                    ".quick-amount-btn"
                );

            if (!btn) {
                return;
            }

            e.preventDefault();


            const paymentItem =
                btn.closest(
                    ".payment-item"
                );

            if (!paymentItem) {
                return;
            }


            const amountInput =
                paymentItem.querySelector(
                    "input#withdrawAmount"
                );

            if (!amountInput) {
                return;
            }


            const quickAmounts =
                btn.closest(
                    ".quick-amounts"
                );

            if (!quickAmounts) {
                return;
            }


            const allQuickBtns =
                quickAmounts.querySelectorAll(
                    ".quick-amount-btn"
                );


            allQuickBtns.forEach(
                function (b) {

                    b.classList.remove(
                        "active"
                    );

                }
            );


            btn.classList.add(
                "active"
            );


            const selected =
                btn.dataset.amount;


            if (selected === "custom") {

                amountInput.value = "";

                amountInput.disabled = false;

                amountInput.focus();

            }
            else {

                const currentValue =
                    parseFloat(
                        amountInput.value
                    ) || 0;

                const addedValue =
                    parseFloat(
                        selected
                    ) || 0;

                amountInput.value =
                    currentValue + addedValue;

                amountInput.disabled = true;
            }

        }
    );


    /* ============================================================
       WITHDRAW SUBMIT
       ============================================================ */

    document.addEventListener(
        "click",
        function (e) {

            const button =
                e.target.closest(
                    ".payment-item .submit-button"
                );

            if (!button) {
                return;
            }

            e.preventDefault();


            /*
             * Prevent double-click while request is being
             * processed.
             */
            if (button.disabled) {
                return;
            }


            const paymentItem =
                button.closest(
                    ".payment-item"
                );

            if (!paymentItem) {
                return;
            }


            const amountInput =
                paymentItem.querySelector(
                    "input#withdrawAmount"
                );

            if (!amountInput) {
                return;
            }


            const amountValue =
                parseFloat(
                    amountInput.value
                );


            /* ====================================================
               AMOUNT VALIDATION
               ==================================================== */

            if (
                !amountValue ||
                isNaN(amountValue)
            ) {

                showFailedModal(
                    "Withdraw",
                    "Please enter a valid amount"
                );

                return;
            }


            if (amountValue < 5) {

                showFailedModal(
                    "Withdraw",
                    "Amount must be greater than 5"
                );

                return;
            }


            if (amountValue > 5000) {

                showFailedModal(
                    "Withdraw",
                    "Amount must be less than 5000"
                );

                return;
            }


            /* ====================================================
               FIRST CONFIRMATION
               ==================================================== */

            showDarkConfirm(

                "Confirm Withdraw",

                "Are you sure you want to withdraw " +
                "<strong>" +
                amountValue.toFixed(2) +
                " USD</strong>?",

                function () {

                    /*
                     * Disable button immediately after the
                     * user confirms the withdrawal.
                     */
                    button.disabled = true;


                    return fetch(
                        "/Withdraw/CreateWithdrawRequest",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                amount: amountValue,
                                usercode:
                                    "@User.Identity.Name"
                            })
                        }
                    )
                        .then(
                            function (response) {

                                if (!response.ok) {

                                    throw new Error(
                                        "Network response was not ok"
                                    );

                                }

                                return response.json();

                            }
                        )
                        .then(
                            function (result) {

                                /*
                                 * =================================================
                                 * KYC REQUIRED
                                 * =================================================
                                 *
                                 * Backend returns:
                                 *
                                 * success = false
                                 * kycRequired = true
                                 *
                                 */
                                if (
                                    !result.success &&
                                    result.kycRequired === true
                                ) {

                                    button.disabled =
                                        false;

                                    showKycRequiredModal();

                                    return;
                                }


                                /*
                                 * =================================================
                                 * NORMAL ERROR
                                 * =================================================
                                 */

                                if (!result.success) {

                                    button.disabled =
                                        false;


                                    Swal.fire({

                                        icon: "error",

                                        title:
                                            result.message ||
                                            "Unable to submit withdrawal."

                                    });


                                    showFailedModal(
                                        "Withdraw",
                                        result.message ||
                                        "Unable to submit withdrawal."
                                    );

                                    return;
                                }


                                /*
                                 * =================================================
                                 * SUCCESS
                                 * =================================================
                                 */

                                button.disabled =
                                    false;


                                showSuccessModal(
                                    "Withdraw",
                                    "Withdraw request submitted."
                                );

                            }
                        )
                        .catch(
                            function (err) {

                                button.disabled =
                                    false;

                                console.error(
                                    "Withdraw error:",
                                    err
                                );

                                showFailedModal(
                                    "Withdraw",
                                    "Network Error"
                                );

                            }
                        );

                }
            );

        }
    );


    /* ============================================================
       FAILED NOTICE
       ============================================================ */

    function showFailedModal(
        header,
        body
    ) {

        const headerElement =
            document.getElementById(
                "failed-header"
            );

        const bodyElement =
            document.getElementById(
                "failed-body"
            );

        const modal =
            document.getElementById(
                "failed-notice-modal"
            );


        if (
            !headerElement ||
            !bodyElement ||
            !modal
        ) {
            return;
        }


        headerElement.textContent =
            header;

        bodyElement.textContent =
            body;


        modal.style.transform =
            "translateX(0%)";


        setTimeout(
            function () {

                modal.style.transform =
                    "translateX(110%)";

            },
            2000
        );

    }


    /* ============================================================
       SUCCESS NOTICE
       ============================================================ */

    function showSuccessModal(
        header,
        body
    ) {

        const headerElement =
            document.getElementById(
                "success-header"
            );

        const bodyElement =
            document.getElementById(
                "success-body"
            );

        const modal =
            document.getElementById(
                "success-notice-modal"
            );


        if (
            !headerElement ||
            !bodyElement ||
            !modal
        ) {
            return;
        }


        headerElement.textContent =
            header;

        bodyElement.textContent =
            body;


        modal.style.transform =
            "translateX(0%)";


        setTimeout(
            function () {

                modal.style.transform =
                    "translateX(110%)";

            },
            2000
        );

    }
</script>