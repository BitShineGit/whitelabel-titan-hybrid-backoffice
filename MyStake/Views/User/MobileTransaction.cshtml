<!-- ========================================================= CANCEL WITHDRAWAL CONFIRMATION ========================================================= -->
<div class="transaction-modal-overlay" id="cancelWithdrawalModal">
    <div class="transaction-confirm-modal">
        <div class="transaction-confirm-modal-title">Cancel Withdrawal</div>
        <div class="transaction-confirm-modal-text">
            Are you sure you want to cancel this withdrawal?
        </div>
        <div class="transaction-confirm-actions">
            <button type="button" id="cancelWithdrawalNo">No</button>
            <button type="button" id="cancelWithdrawalYes">Yes, Cancel</button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        /* =========================================================
           TRANSACTION SETTINGS
        ========================================================= */

        const pageSize = 10;

        let currentPage = 1;
        let allTransactions = [];

        const userTimeZone =
            Intl.DateTimeFormat().resolvedOptions().timeZone;

        let selectedActivity = "";
        let selectedStatus = "Status";

        let selectedWithdrawalId = null;


        /* =========================================================
           FORMAT DATE
        ========================================================= */

        function formatDateTime(dateTime) {

            if (!dateTime) {
                return "-";
            }

            return moment
                .utc(dateTime)
                .local()
                .format("YYYY-MM-DD HH:mm:ss");
        }


        /* =========================================================
           STATUS OPTIONS
        ========================================================= */

        function updateStatusOptions(activityType) {
            const container = $("#statusmodal .options-container");
            if (!container.length) {
                return;
            }
            let options = [];
        /* * Bet/Win has its own status list. */ if (activityType === "Bet/Win") {
                options = [
                    { text: "All", value: "All" },
                    { text: "Outstanding", value: "Outstanding" },
                    { text: "Success", value: "Success" },
                    { text: "Canceled", value: "Canceled" },
                ];
            } else {
          /* * Default: * Deposit / Withdraw * * Also used when no Activity Type * has been selected yet. */ options =
                    [
                        { text: "All", value: "All" },
                        { text: "Pending", value: "Pending" },
                        { text: "Processing", value: "Processing" },
                        { text: "Completed", value: "Completed" },
                        { text: "Rejected", value: "Rejected" },
                        { text: "Failed", value: "Failed" },
                        { text: "Canceled", value: "Canceled" },
                    ];
            }
            container.empty();
            options.forEach(function (option) {
                const isActive = option.value === selectedStatus;
                container.append(
                    ` <button type="button" role="option" class="modal-option option ${isActive ? "active" : ""}" aria-selected="${isActive ? "true" : "false"}" data-value="${option.value}" data-update-element="#selectedstatus"> <span>${option.text}</span> </button> `,
                );
            });
        }

        /* =========================================================
           STATUS CLASS
        ========================================================= */

        function getStatusClass(status) {

            if (!status) {
                return "";
            }

            switch (status.toLowerCase()) {

                case "success":
                    return "status-success";

                case "completed":
                    return "status-completed";

                case "pending":
                    return "status-pending";

                case "processing":
                    return "status-processing";

                case "rejected":
                    return "status-rejected";

                case "failed":
                    return "status-failed";

                case "canceled":
                    return "status-canceled";

                case "outstanding":
                    return "status-outstanding";

                default:
                    return "";
            }
        }


        /* =========================================================
           RENDER TRANSACTIONS
        ========================================================= */

        function renderMobileTransactions() {

            const tbody =
                $(".transactions-wrapper .transaction-table tbody");

            tbody.empty();


            const start =
                (currentPage - 1) * pageSize;

            const end =
                start + pageSize;

            const transactions =
                allTransactions.slice(start, end);


            if (transactions.length === 0) {

                tbody.append(`
            <tr>
                <td colspan="5" class="transaction-empty">
                    No transactions found.
                </td>
            </tr>
        `);

                renderPagination();

                return;
            }


            transactions.forEach(function (transaction) {

                /* =================================================
                   AMOUNT
                ================================================= */

                let amountHtml = "-";


                if (transaction.type === "Bet/Win") {

                    const betAmount =
                        transaction.amount !== undefined &&
                            transaction.amount !== null
                            ? transaction.amount
                            : 0;

                    const winAmount =
                        transaction.winAmount !== undefined &&
                            transaction.winAmount !== null
                            ? transaction.winAmount
                            : 0;


                    amountHtml = `
                            <span class="transaction-amount amount-loss">
                                -${betAmount}
                            </span>

                            <span class="transaction-amount-separator">
                                /
                            </span>

                            <span class="transaction-amount amount-profit">
                                +${winAmount}
                            </span>
                        `;

                }
                else if (
                    transaction.amount !== undefined &&
                    transaction.amount !== null
                ) {

                    amountHtml =
                        `<span class="transaction-amount">
                                ${transaction.amount}
                            </span>`;
                }


                /* =================================================
                   RESULT
                ================================================= */

                const result =
                    transaction.result || "-";

                const statusClass =
                    getStatusClass(result);

                let resultHtml = "";


                if (transaction.canCancel) {

                    resultHtml = `
                            <div class="transaction-result">

                                <span
                                    class="transaction-status ${statusClass}">
                                    ${result}
                                </span>

                                <button
                                    type="button"
                                    class="transaction-cancel-btn"
                                    data-id="${transaction.id}">
                                    Cancel
                                </button>

                            </div>
                        `;

                }
                else {

                    resultHtml = `
                            <span
                                class="transaction-status ${statusClass}">
                                ${result}
                            </span>
                        `;
                }


                /* =================================================
                   ROW
                ================================================= */

                tbody.append(`
                        <tr>

                            <td>
                                ${formatDateTime(transaction.dateTime)}
                            </td>

                            <td>
                                ${transaction.type || "-"}
                            </td>

                            <td>
                                ${transaction.name || "-"}
                            </td>

                            <td>
                                ${amountHtml}
                            </td>

                            <td>
                                ${resultHtml}
                            </td>

                        </tr>
                    `);

            });


            renderPagination();
        }


        /* =========================================================
           PAGINATION
        ========================================================= */

        function renderPagination() {
            const pagination = $(".transactions-wrapper .core-pagination");
            pagination.empty();
            const totalPages = Math.ceil(allTransactions.length / pageSize);
            if (totalPages <= 1) {
                return;
            }
        /* * FIRST */ pagination.append(
                ` <button type="button" class="transaction-page-btn first-last" data-page="1" ${currentPage === 1 ? "disabled" : ""}> First </button> `,
            );
        /* * PREVIOUS */ pagination.append(
                ` <button type="button" class="transaction-page-btn navigation" data-page="${currentPage - 1}" ${currentPage === 1 ? "disabled" : ""}> Previous </button> `,
            );
        /* * PAGE WINDOW */ let startPage = 1;
            let endPage = totalPages;
            if (totalPages > 7) {
                if (currentPage <= 4) {
                    startPage = 1;
                    endPage = 5;
                } else if (currentPage >= totalPages - 3) {
                    startPage = totalPages - 4;
                    endPage = totalPages;
                } else {
                    startPage = currentPage - 2;
                    endPage = currentPage + 2;
                }
            }
        /* * FIRST PAGE + DOTS */ if (startPage > 1) {
                pagination.append(
                    ` <button type="button" class="transaction-page-btn" data-page="1"> 1 </button> `,
                );
                pagination.append(
                    ` <span class="transaction-pagination-dots"> ... </span> `,
                );
            }
        /* * PAGE NUMBERS */ for (let i = startPage; i <= endPage; i++) {
                pagination.append(
                    ` <button type="button" class="transaction-page-btn ${i === currentPage ? "active" : ""}" data-page="${i}"> ${i} </button> `,
                );
            }
        /* * LAST PAGE + DOTS */ if (endPage < totalPages) {
                pagination.append(
                    ` <span class="transaction-pagination-dots"> ... </span> `,
                );
                pagination.append(
                    ` <button type="button" class="transaction-page-btn" data-page="${totalPages}"> ${totalPages} </button> `,
                );
            }
        /* * NEXT */ pagination.append(
                ` <button type="button" class="transaction-page-btn navigation" data-page="${currentPage + 1}" ${currentPage === totalPages ? "disabled" : ""}> Next </button> `,
            );
        /* * LAST */ pagination.append(
                ` <button type="button" class="transaction-page-btn first-last" data-page="${totalPages}" ${currentPage === totalPages ? "disabled" : ""}> Last </button> `,
            );
        }

        /* =========================================================
           PAGINATION CLICK
        ========================================================= */

        $(document).on(
            "click.transactionPagination",
            ".transaction-page-btn",
            function (e) {

                e.preventDefault();
                e.stopPropagation();


                if ($(this).prop("disabled")) {
                    return;
                }


                const page =
                    parseInt(
                        $(this).attr("data-page"),
                        10
                    );


                const totalPages =
                    Math.ceil(
                        allTransactions.length / pageSize
                    );


                if (
                    isNaN(page) ||
                    page < 1 ||
                    page > totalPages ||
                    page === currentPage
                ) {
                    return;
                }


                currentPage = page;

                renderMobileTransactions();


                $(".transactions-wrapper")[0]?.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        );


        /* =========================================================
           ACTIVITY TYPE
        ========================================================= */

        $(document).on(
            "click.transactionActivity",
            "#activitytype .modal-option",
            function (e) {

                e.preventDefault();
                e.stopPropagation();


                const value =
                    $(this)
                        .find("span")
                        .text()
                        .trim();


                if (!value) {
                    return;
                }


                selectedActivity = value;

                $("#selectedactivity")
                    .text(value);


                /*
                 * Reset status whenever activity changes.
                 */

                selectedStatus = "All";

                $("#selectedstatus")
                    .text("All");


                /*
                 * Rebuild status options.
                 */

                updateStatusOptions(
                    selectedActivity
                );


                /*
                 * Reset pagination.
                 */

                currentPage = 1;


                /*
                 * Active activity option.
                 */

                $("#activitytype .modal-option")
                    .removeClass("active")
                    .attr(
                        "aria-selected",
                        "false"
                    );


                $(this)
                    .addClass("active")
                    .attr(
                        "aria-selected",
                        "true"
                    );


                /*
                 * Close modal.
                 */

                $("#activitytype")
                    .removeClass("is-open");
            }
        );


        /* =========================================================
           STATUS
        ========================================================= */

        $(document).on(
            "click.transactionStatus",
            "#statusmodal .modal-option",
            function (e) {

                e.preventDefault();
                e.stopPropagation();


                const value =
                    $(this).attr("data-value");


                if (!value) {
                    return;
                }


                selectedStatus = value;


                $("#selectedstatus")
                    .text(
                        $(this)
                            .find("span")
                            .text()
                            .trim()
                    );


                /*
                 * Active state.
                 */

                $("#statusmodal .modal-option")
                    .removeClass("active")
                    .attr(
                        "aria-selected",
                        "false"
                    );


                $(this)
                    .addClass("active")
                    .attr(
                        "aria-selected",
                        "true"
                    );


                currentPage = 1;


                /*
                 * Dynamic options are not registered
                 * by the global ModalController.
                 */

                $("#statusmodal")
                    .removeClass("is-open");
            }
        );


        /* =========================================================
           CANCEL WITHDRAWAL
        ========================================================= */

        $(document).on(
            "click.transactionCancel",
            ".transaction-cancel-btn",
            function (e) {

                e.preventDefault();
                e.stopPropagation();


                selectedWithdrawalId =
                    $(this).data("id");


                if (!selectedWithdrawalId) {
                    return;
                }


                $("#cancelWithdrawalModal")
                    .addClass("show");
            }
        );


        function closeCancelWithdrawalModal() {

            selectedWithdrawalId = null;

            $("#cancelWithdrawalModal")
                .removeClass("show");

            $("#cancelWithdrawalYes")
                .prop("disabled", false)
                .text("Yes, Cancel");
        }


        $("#closeCancelWithdrawalModal")
            .on(
                "click.transactionCancel",
                function (e) {

                    e.preventDefault();

                    closeCancelWithdrawalModal();
                }
            );


        $("#cancelWithdrawalNo")
            .on(
                "click.transactionCancel",
                function (e) {

                    e.preventDefault();

                    closeCancelWithdrawalModal();
                }
            );


        $(".transaction-modal-overlay")
            .on(
                "click.transactionCancel",
                function (e) {

                    if (e.target === this) {

                        closeCancelWithdrawalModal();
                    }
                }
            );


        $("#cancelWithdrawalYes")
            .on(
                "click.transactionCancel",
                function (e) {

                    e.preventDefault();


                    if (!selectedWithdrawalId) {
                        return;
                    }


                    const withdrawalId =
                        selectedWithdrawalId;


                    $("#cancelWithdrawalYes")
                        .prop("disabled", true)
                        .text("Canceling...");


                    $.ajax({

                        url:
                            '@Url.Action("CancelWithdrawal", "User")',

                        type: "POST",

                        data: {
                            id: withdrawalId
                        },

                        success: function (response) {

                            if (!response.success) {

                                console.error(
                                    response.message
                                );

                                closeCancelWithdrawalModal();

                                return;
                            }


                            closeCancelWithdrawalModal();

                            currentPage = 1;

                            loadTransactions();
                        },

                        error: function (xhr) {

                            console.error(
                                "Cancel withdrawal error:",
                                xhr
                            );

                            closeCancelWithdrawalModal();
                        }
                    });
                }
            );


        /* =========================================================
           DATE PICKER
        ========================================================= */

        $("#fromDate, #toDate")
            .daterangepicker({

                autoUpdateInput: false,

                timePicker: true,

                timePicker24Hour: true,

                timePickerSeconds: true,

                locale: {
                    format: "YYYY-MM-DD HH:mm:ss",
                    cancelLabel: "Clear"
                }
            });


        /* =========================================================
           DATE PICKER APPLY
        ========================================================= */

        $("#fromDate")
            .on(
                "apply.daterangepicker",
                function (ev, picker) {

                    $("#fromDate")
                        .val(
                            picker.startDate.format(
                                "YYYY-MM-DD HH:mm:ss"
                            )
                        );

                    $("#toDate")
                        .val(
                            picker.endDate.format(
                                "YYYY-MM-DD HH:mm:ss"
                            )
                        );
                }
            );


        $("#toDate")
            .on(
                "apply.daterangepicker",
                function (ev, picker) {

                    $("#fromDate")
                        .val(
                            picker.startDate.format(
                                "YYYY-MM-DD HH:mm:ss"
                            )
                        );

                    $("#toDate")
                        .val(
                            picker.endDate.format(
                                "YYYY-MM-DD HH:mm:ss"
                            )
                        );
                }
            );


        /* =========================================================
           DATE PICKER CLEAR
        ========================================================= */

        $("#fromDate, #toDate")
            .on(
                "cancel.daterangepicker",
                function () {

                    $("#fromDate").val("");

                    $("#toDate").val("");
                }
            );


        /* =========================================================
           LOAD TRANSACTIONS
        ========================================================= */

        function loadTransactions() {

            const fromDate =
                $("#fromDate").val();

            const toDate =
                $("#toDate").val();


            $.ajax({

                url:
                    '@Url.Action("GetTransactions", "User")',

                type: "POST",

                data: {

                    activityType:
                        selectedActivity,

                    status:
                        selectedStatus,

                    fromDate:
                        fromDate,

                    toDate:
                        toDate,

                    timeZone:
                        userTimeZone
                },


                success: function (response) {

                    if (!response.success) {

                        console.error(
                            response.message
                        );

                        return;
                    }


                    allTransactions =
                        response.transactions || [];


                    currentPage = 1;


                    renderMobileTransactions();
                },


                error: function (xhr) {

                    console.error(
                        "Failed to load transactions.",
                        xhr
                    );
                }
            });
        }


        /* =========================================================
           SUBMIT
        ========================================================= */

        $(".transactions .filters-wrapper .core-button")
            .on(
                "click.transactionSubmit",
                function (e) {

                    e.preventDefault();

                    e.stopPropagation();

                    currentPage = 1;

                    loadTransactions();
                }
            );


        /* =========================================================
           INITIAL STATUS
        ========================================================= */

        updateStatusOptions(
            selectedActivity
        );


        /* =========================================================
           INITIAL PAGE STATE
        ========================================================= */

        allTransactions = [];

        currentPage = 1;


        $(".transactions-wrapper .transaction-table tbody")
            .empty();

        $(".transactions-wrapper .core-pagination")
            .empty();

    });
</script>
