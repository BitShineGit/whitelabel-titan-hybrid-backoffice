    ViewData["Title"] = "Transaction";
}
<script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<style>
  /* ========================================================= TRANSACTION TABLE ========================================================= */
    .transactions-wrapper .table-responsive {
        position: relative;
        width: 100%;
        max-width: 100%;
        overflow-x: scroll;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        touch-action: pan-x;
        overscroll-behavior-x: contain;
        margin-top: 18px;
        border-radius: 6px;
        scrollbar-width: thin;
    }

    .transactions-wrapper {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow: visible;
    }

        .transactions-wrapper .table-responsive {
            box-sizing: border-box;
            display: block;
        }
  .transactions-wrapper .transaction-table {
    width: max-content%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
  }
  .transactions-wrapper .transaction-table th,
  .transactions-wrapper .transaction-table td {
    padding: 13px 18px;
    font-size: 13px;
    line-height: 1.4;
    white-space: nowrap;
    vertical-align: middle;
  }
  .transactions-wrapper .transaction-table th {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }
  .transactions-wrapper .transaction-table th:first-child,
  .transactions-wrapper .transaction-table td:first-child {
    padding-left: 18px;
  }
  .transactions-wrapper .transaction-table th:last-child,
  .transactions-wrapper .transaction-table td:last-child {
    padding-right: 18px;
  } /* Column widths */
  .transactions-wrapper .transaction-table th:nth-child(1),
  .transactions-wrapper .transaction-table td:nth-child(1) {
    min-width: 165px;
  }
  .transactions-wrapper .transaction-table th:nth-child(2),
  .transactions-wrapper .transaction-table td:nth-child(2) {
    min-width: 145px;
  }
  .transactions-wrapper .transaction-table th:nth-child(3),
  .transactions-wrapper .transaction-table td:nth-child(3) {
    min-width: 140px;
  }
  .transactions-wrapper .transaction-table th:nth-child(4),
  .transactions-wrapper .transaction-table td:nth-child(4) {
    min-width: 145px;
  }
  .transactions-wrapper .transaction-table th:nth-child(5),
  .transactions-wrapper .transaction-table td:nth-child(5) {
    min-width: 150px;
  } /* ========================================================= AMOUNT ========================================================= */
  .transaction-amount {
    font-size: 13px;
    font-weight: 500;
  }
  .transaction-amount.amount-profit {
    color: #00c853;
  }
  .transaction-amount.amount-loss {
    color: #ff3b4d;
  }
  .transaction-amount-separator {
    margin: 0 5px;
    opacity: 0.55;
  } /* ========================================================= RESULT / STATUS ========================================================= */
  .transaction-result {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 28px;
  }
  .transaction-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    padding: 5px 9px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }
  .status-success {
    color: #00c853;
    background: rgba(0, 200, 83, 0.1);
  }
  .status-completed {
    color: #00c853;
    background: rgba(0, 200, 83, 0.1);
  }
  .status-pending {
    color: #ff9800;
    background: rgba(255, 152, 0, 0.1);
  }
  .status-processing {
    color: #00aaeb;
    background: rgba(0, 170, 235, 0.1);
  }
  .status-rejected {
    color: #ff3b4d;
    background: rgba(255, 59, 77, 0.1);
  }
  .status-failed {
    color: #ff3b4d;
    background: rgba(255, 59, 77, 0.1);
  }
  .status-canceled {
    color: #ff3b4d;
    background: rgba(255, 59, 77, 0.1);
  }
  .status-outstanding {
    color: #ff9800;
    background: rgba(255, 152, 0, 0.1);
  } /* ========================================================= CANCEL BUTTON ========================================================= */
  .transaction-cancel-btn {
    border: 0;
    outline: none;
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    color: #fff;
    background: #ff3b4d;
    transition: opacity 0.2s ease;
  }
  .transaction-cancel-btn:hover {
    opacity: 0.85;
  }
  .transaction-cancel-btn:active {
    opacity: 0.7;
  }
  .transaction-cancel-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  } /* ========================================================= PAGINATION Same structure/behavior as desktop ========================================================= */
  .transactions-wrapper .core-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    margin-top: 22px;
    padding: 5px 0 15px;
    flex-wrap: wrap;
  }
  .transactions-wrapper .transaction-page-btn {
    min-width: 34px;
    height: 34px;
    padding: 0 9px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
    font-weight: 500;
    line-height: 32px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .transactions-wrapper .transaction-page-btn:hover:not(:disabled) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .transactions-wrapper .transaction-page-btn.active {
    color: #fff;
    background: #00aaeb;
    border-color: #00aaeb;
  }
  .transactions-wrapper .transaction-page-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .transactions-wrapper .transaction-page-btn.navigation,
  .transactions-wrapper .transaction-page-btn.first-last {
    padding: 0 12px;
  }
  .transaction-pagination-dots {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    min-width: 20px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
  } /* ========================================================= EMPTY TABLE ========================================================= */
    .transactions-wrapper .transaction-table td.transaction-empty {
        padding: 35px 15px;
        text-align: left;
        color: rgba(255, 255, 255, 0.45);
        font-size: 13px;
    }
    /* ========================================================= CANCEL CONFIRMATION MODAL ========================================================= */
  .transaction-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.65);
  }
  .transaction-modal-overlay.show {
    display: flex;
  }
  .transaction-confirm-modal {
    width: 100%;
    max-width: 360px;
    padding: 24px 20px;
    border-radius: 8px;
    background: #1b1d24;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    text-align: center;
  }
  .transaction-confirm-modal-title {
    margin-bottom: 10px;
    color: #fff;
    font-size: 17px;
    font-weight: 600;
  }
  .transaction-confirm-modal-text {
    margin-bottom: 22px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
    line-height: 1.5;
  }
  .transaction-confirm-actions {
    display: flex;
    gap: 10px;
  }
  .transaction-confirm-actions button {
    flex: 1;
    height: 40px;
    border: 0;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  #cancelWithdrawalNo {
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.08);
  }
  #cancelWithdrawalYes {
    color: #fff;
    background: #ff3b4d;
  }
  #cancelWithdrawalYes:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  } /* ========================================================= SMALL MOBILE ========================================================= */
  @@media (max-width: 480px) {
    .transactions-wrapper .transaction-table th,
    .transactions-wrapper .transaction-table td {
      padding: 12px 14px;
      font-size: 12px;
    }
    .transactions-wrapper .transaction-table th {
      font-size: 11px;
    }
    .transactions-wrapper .transaction-page-btn {
      min-width: 32px;
      height: 32px;
      line-height: 30px;
      font-size: 11px;
    }
    .transactions-wrapper .transaction-page-btn.navigation,
    .transactions-wrapper .transaction-page-btn.first-last {
      padding: 0 9px;
    }
  }
</style>
<style>
@@media (max-width: 767px) {
    .daterangepicker {
        position: fixed !important;
        top: 50% !important;
        left: 10px !important;
        right: 10px !important;
        transform: translateY(-50%);
        width: auto !important;
        max-width: none !important;
        box-sizing: border-box;
    }
}
</style>
<style>
    .daterangepicker .calendar-time select {
        color: #000 !important;
    }

        .daterangepicker .calendar-time select option {
            color: #000 !important;
        }
</style>
