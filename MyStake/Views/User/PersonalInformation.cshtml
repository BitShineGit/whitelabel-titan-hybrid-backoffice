@using Titan.Repository;

@{
    ViewData["Title"] = "Profile";
    var player = (Titan.Repository.Database.User)ViewData["player"];
    var kycRequest = ViewData["kycRequest"] as Titan.Repository.Database.KycRequestLog;

    /*
     * KYC STATUS
     *
     * User.KycStatus
     *
     * 0 = Request / Pending
     * 1 = Verified
     * 2 = Rejected
     * 3 = Not Submitted
     */

    string kycStatus;
    string kycStatusClass;
    string kycStatusDescription;

    if (player != null && player.KycStatus == 1)
    {
        kycStatus = "Verified";
        kycStatusClass = "verified";
        kycStatusDescription = "Your identity has been successfully verified.";
    }
    else if (player != null && player.KycStatus == 0)
    {
        kycStatus = "Pending";
        kycStatusClass = "pending";
        kycStatusDescription = "Your KYC request has been submitted and is waiting for verification.";
    }
    else if (player != null && player.KycStatus == 2)
    {
        kycStatus = "Rejected";
        kycStatusClass = "rejected";
        kycStatusDescription = "Your KYC request was rejected. Please review your information and submit again.";
    }
    else
    {
        kycStatus = "Not Submitted";
        kycStatusClass = "not-submitted";
        kycStatusDescription = "You have not submitted a KYC verification request yet.";
    }

    /*
     * KYC EDIT PERMISSION
     *
     * Rejected / Not Submitted
     * -> User can edit and submit
     *
     * Pending / Verified
     * -> User cannot edit
     */

    var canEditKyc = player != null &&
                     (player.KycStatus == 2 || player.KycStatus == 3);
}


