<script>
    /* =========================================================
       ACCOUNT HEIGHT SYNCHRONIZATION
       ========================================================= */

    function msSyncAccountHeights() {

        const layout =
            document.querySelector(".ms-account-layout");

        const sidebar =
            document.querySelector(".ms-account-sidebar");

        if (!layout || !sidebar) {
            return;
        }

        if (window.innerWidth <= 1000) {

            layout.style.removeProperty("--ms-sidebar-height");

            return;
        }

        layout.style.removeProperty("--ms-sidebar-height");

        const sidebarHeight =
            sidebar.scrollHeight;

        if (!sidebarHeight || sidebarHeight <= 0) {
            return;
        }

        layout.style.setProperty(
            "--ms-sidebar-height",
            sidebarHeight + "px"
        );
    }


    document.addEventListener(
        "DOMContentLoaded",
        function () {

            requestAnimationFrame(
                function () {
                    msSyncAccountHeights();
                }
            );

        }
    );


    window.addEventListener(
        "load",
        function () {

            requestAnimationFrame(
                function () {
                    msSyncAccountHeights();
                }
            );

        }
    );


    let msResizeTimer = null;


    window.addEventListener(
        "resize",
        function () {

            clearTimeout(msResizeTimer);

            msResizeTimer =
                setTimeout(
                    function () {
                        msSyncAccountHeights();
                    },
                    100
                );

        }
    );


    document.addEventListener(
        "click",
        function (event) {

            const tab =
                event.target.closest(".ms-account-tab");

            if (!tab) {
                return;
            }

            setTimeout(
                function () {
                    msSyncAccountHeights();
                },
                50
            );

        }
    );


    if (window.ResizeObserver) {

        const sidebar =
            document.querySelector(".ms-account-sidebar");

        if (sidebar) {

            let msObserverTimer = null;

            const observer =
                new ResizeObserver(
                    function () {

                        clearTimeout(msObserverTimer);

                        msObserverTimer =
                            setTimeout(
                                function () {
                                    msSyncAccountHeights();
                                },
                                50
                            );

                    }
                );

            observer.observe(sidebar);
        }
    }
</script>


<script>
    /* =========================================================
       ACCOUNT TABS
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const accountTabs =
                document.querySelectorAll(
                    ".ms-account-tab"
                );

            const accountPanels =
                document.querySelectorAll(
                    ".ms-account-panel"
                );


            accountTabs.forEach(
                function (tab) {

                    tab.addEventListener(
                        "click",
                        function () {

                            const targetId =
                                this.getAttribute(
                                    "data-ms-target"
                                );


                            accountTabs.forEach(
                                function (item) {

                                    item.classList.remove(
                                        "ms-active"
                                    );

                                }
                            );


                            accountPanels.forEach(
                                function (panel) {

                                    panel.classList.remove(
                                        "ms-active"
                                    );

                                }
                            );


                            this.classList.add(
                                "ms-active"
                            );


                            const target =
                                document.getElementById(
                                    targetId
                                );


                            if (target) {

                                target.classList.add(
                                    "ms-active"
                                );

                            }

                            setTimeout(
                                function () {
                                    msSyncAccountHeights();
                                },
                                50
                            );

                        }
                    );

                }
            );

        }
    );
</script>


<script>
    /* =========================================================
       KYC SUBMIT + CONFIRMATION MODAL
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const kycForm =
                document.getElementById(
                    "msKycForm"
                );

            if (!kycForm) {
                return;
            }


            /* =====================================================
               ELEMENTS
               ===================================================== */

            const submitButton =
                document.getElementById(
                    "msKycSubmitButton"
                );

            const message =
                document.getElementById(
                    "msKycSubmitMessage"
                );

            const confirmModal =
                document.getElementById(
                    "kycConfirmModal"
                );

            const closeModalButton =
                document.getElementById(
                    "closeKycConfirmModal"
                );

            const cancelModalButton =
                document.getElementById(
                    "cancelKycConfirm"
                );

            const confirmSubmitButton =
                document.getElementById(
                    "confirmKycSubmit"
                );


            if (!submitButton || !message) {
                return;
            }


            /* =====================================================
               MODAL FUNCTIONS
               ===================================================== */

            function openKycConfirmModal() {

                if (!confirmModal) {
                    return;
                }

                confirmModal.classList.add("active");

                document.body.classList.add(
                    "kyc-confirm-modal-open"
                );

            }


            function closeKycConfirmModal() {

                if (!confirmModal) {
                    return;
                }

                /*
                 * Do not allow the modal to close while
                 * the request is being submitted.
                 */
                if (
                    confirmSubmitButton &&
                    confirmSubmitButton.disabled
                ) {
                    return;
                }

                confirmModal.classList.remove("active");

                document.body.classList.remove(
                    "kyc-confirm-modal-open"
                );

            }


            /* =====================================================
               ORIGINAL KYC FORM SUBMIT

               Do NOT submit here.
               Only open the confirmation modal.
               ===================================================== */

            kycForm.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    openKycConfirmModal();

                }
            );


            /* =====================================================
               CLOSE BUTTON
               ===================================================== */

            if (closeModalButton) {

                closeModalButton.addEventListener(
                    "click",
                    function () {

                        closeKycConfirmModal();

                    }
                );

            }


            /* =====================================================
               CANCEL BUTTON
               ===================================================== */

            if (cancelModalButton) {

                cancelModalButton.addEventListener(
                    "click",
                    function () {

                        closeKycConfirmModal();

                    }
                );

            }


            /* =====================================================
               CLICK OUTSIDE MODAL
               ===================================================== */

            if (confirmModal) {

                confirmModal.addEventListener(
                    "click",
                    function (event) {

                        /*
                         * Only close when clicking the dark
                         * overlay itself, not the modal content.
                         */
                        if (
                            event.target === confirmModal
                        ) {

                            closeKycConfirmModal();

                        }

                    }
                );

            }


            /* =====================================================
               ESC KEY
               ===================================================== */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        confirmModal &&
                        confirmModal.classList.contains("active")
                    ) {

                        closeKycConfirmModal();

                    }

                }
            );


            /* =====================================================
               CONFIRM & SUBMIT
               ===================================================== */

            if (confirmSubmitButton) {

                confirmSubmitButton.addEventListener(
                    "click",
                    function () {

                        /*
                         * Prevent double click / double submission.
                         */
                        if (
                            confirmSubmitButton.disabled
                        ) {
                            return;
                        }


                        confirmSubmitButton.disabled =
                            true;


                        confirmSubmitButton.classList.add(
                            "loading"
                        );


                        /*
                         * Also disable the original form button.
                         */
                        submitButton.disabled =
                            true;


                        /*
                         * Keep the original submit message
                         * behavior.
                         */
                        message.className =
                            "ms-kyc-submit-message";

                        message.textContent =
                            "";


                        /*
                         * Collect the complete KYC form.
                         */
                        const formData =
                            new FormData(kycForm);


                        fetch(
                            kycForm.action,
                            {
                                method: "POST",
                                body: formData,
                                credentials: "same-origin"
                            }
                        )
                            .then(
                                function (response) {

                                    if (!response.ok) {

                                        throw new Error(
                                            "Request failed."
                                        );

                                    }

                                    return response.json();

                                }
                            )
                            .then(
                                function (result) {

                                    if (result.success) {

                                        /*
                                         * Show success message
                                         * behind the modal as well.
                                         */
                                        message.className =
                                            "ms-kyc-submit-message success";

                                        message.textContent =
                                            result.message ||
                                            "Your KYC request has been submitted successfully.";


                                        /*
                                         * Update the original
                                         * submit button.
                                         */
                                        submitButton.textContent =
                                            "Submitted";


                                        /*
                                         * Update confirmation
                                         * button.
                                         */
                                        confirmSubmitButton.classList.remove(
                                            "loading"
                                        );

                                        confirmSubmitButton.textContent =
                                            "Submitted";


                                        /*
                                         * Reload after a short delay.
                                         *
                                         * This allows the user to see
                                         * the successful submission state
                                         * before the page refreshes.
                                         */
                                        setTimeout(
                                            function () {

                                                window.location.reload();

                                            },
                                            1000
                                        );

                                        return;

                                    }


                                    /*
                                     * Server returned success = false
                                     */
                                    message.className =
                                        "ms-kyc-submit-message error";

                                    message.textContent =
                                        result.message ||
                                        "Unable to submit your KYC request.";


                                    confirmSubmitButton.disabled =
                                        false;

                                    confirmSubmitButton.classList.remove(
                                        "loading"
                                    );


                                    submitButton.disabled =
                                        false;

                                    submitButton.textContent =
                                        "@(player.KycStatus == 2 ? "Resubmit KYC" : "Submit KYC")";

                                }
                            )
                            .catch(
                                function () {

                                    message.className =
                                        "ms-kyc-submit-message error";

                                    message.textContent =
                                        "An error occurred while submitting your KYC request. Please try again.";


                                    confirmSubmitButton.disabled =
                                        false;

                                    confirmSubmitButton.classList.remove(
                                        "loading"
                                    );


                                    submitButton.disabled =
                                        false;

                                    submitButton.textContent =
                                        "@(player.KycStatus == 2 ? "Resubmit KYC" : "Submit KYC")";

                                }
                            );

                    }
                );

            }

        }
    );
</script>


<script>
    /* =========================================================
       PASSWORD MODAL
       ========================================================= */

    function openpasswordModal() {

        const modal =
            document.getElementById(
                "passwordModal"
            );

        modal.classList.add("show");

        document.body.style.overflow =
            "hidden";
    }


    function closepasswordModal() {

        const modal =
            document.getElementById(
                "passwordModal"
            );

        modal.classList.remove("show");

        document.body.style.overflow =
            "";
    }
</script>


<script>
    /* =========================================================
       PASSWORD VALIDATION
       ========================================================= */

    $("#currentpassword-validation").hide();

    $("#newpassword-validation").hide();

    $("#confirmpassword-validation").hide();


    function validatecurrentpassword() {

        if ($("#currentpassword").val() == "") {

            $("#currentpassword-validation").show();

            $("#currentpassword-validation").text(
                "Please input your current password!"
            );

            return false;

        } else {

            $("#currentpassword-validation").hide();

            $("#currentpassword-validation").text("");

            return true;
        }
    }


    function validatenewpassword() {

        const password =
            $("#newpassword").val();


        const valid =
            password.length >= 8 &&
            password.length <= 20 &&
            /[A-Z]/.test(password) &&
            /[a-z]/.test(password) &&
            /[0-9]/.test(password);


        if (password == "") {

            $("#newpassword-validation").show();

            $("#newpassword-validation").text(
                "Please input new password!"
            );

            return false;
        }


        if (!valid) {

            $("#newpassword-validation").show();

            $("#newpassword-validation").text(
                "Invalid format"
            );

            return false;
        }


        $("#newpassword-validation").hide();

        $("#newpassword-validation").text("");

        return true;
    }


    function validateconfirmpassword() {

        if ($("#confirmpassword").val() == "") {

            $("#confirmpassword-validation").show();

            $("#confirmpassword-validation").text(
                "Please confirm your password!"
            );

            return false;
        }


        if (
            $("#confirmpassword").val() !=
            $("#newpassword").val()
        ) {

            $("#confirmpassword-validation").show();

            $("#confirmpassword-validation").text(
                "The two passwords that you entered do not match!"
            );

            return false;
        }


        $("#confirmpassword-validation").hide();

        $("#confirmpassword-validation").text("");

        return true;
    }


    function togglevalidate() {

        const isValid =
            validatecurrentpassword() &&
            validatenewpassword() &&
            validateconfirmpassword();


        if (isValid) {

            $("#change-password-button").css(
                "opacity",
                "1"
            );

            $("#change-password-button").css(
                "pointerEvents",
                "all"
            );

        } else {

            $("#change-password-button").css(
                "opacity",
                "0.5"
            );

            $("#change-password-button").css(
                "pointerEvents",
                "none"
            );
        }
    }


    $("#currentpassword").on(
        "input",
        function () {

            validatecurrentpassword();

            togglevalidate();

        }
    );


    $("#newpassword").on(
        "input",
        function () {

            validatenewpassword();

            togglevalidate();

        }
    );


    $("#confirmpassword").on(
        "input",
        function () {

            validateconfirmpassword();

            togglevalidate();

        }
    );


    $("#change-password-button").on(
        "click",
        function (e) {

            $.ajax({

                url: "/account/changepassword",

                method: "POST",

                data: {

                    CurrentPassword:
                        $("#currentpassword").val(),

                    NewPassword:
                        $("#newpassword").val(),

                    ConfirmPassword:
                        $("#confirmpassword").val()

                },

                success: function (res) {

                    if (res.success) {

                        closepasswordModal();

                        $("#success-header").text(
                            "Change Password"
                        );

                        $("#success-body").text(
                            "Successfully change password"
                        );

                        const modal =
                            document.getElementById(
                                "success-notice-modal"
                            );

                        modal.style.transform =
                            "translateX(0%)";


                        setTimeout(
                            function () {

                                modal.style.transform =
                                    "translateX(110%)";

                            },
                            2000
                        );

                        return;
                    }


                    if (res.errorPassword) {

                        closepasswordModal();

                        $("#failed-header").text(
                            "Change Password"
                        );

                        $("#failed-body").text(
                            "Incorrect username or password"
                        );

                        const modal =
                            document.getElementById(
                                "failed-notice-modal"
                            );

                        modal.style.transform =
                            "translateX(0%)";


                        setTimeout(
                            function () {

                                modal.style.transform =
                                    "translateX(110%)";

                            },
                            2000
                        );

                        return;
                    }

                }

            });

        }
    );
</script>