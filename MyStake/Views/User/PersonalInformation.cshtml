<style>
    /* =========================================================
   KYC CONFIRMATION MODAL
   Site Accent: #00aaeb
   ========================================================= */

.ms-kyc-confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(3, 8, 13, 0.78);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
}

.ms-kyc-confirm-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}


/* =========================================================
   MODAL
   ========================================================= */

.ms-kyc-confirm-modal {
    position: relative;

    width: 100%;
    max-width: 455px;

    padding: 32px 30px 28px;

    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 20px;

    background:
        radial-gradient(
            circle at 50% -15%,
            rgba(0, 170, 235, 0.12),
            transparent 48%
        ),
        linear-gradient(
            145deg,
            #151b21 0%,
            #0e1318 100%
        );

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.60),
        0 0 45px rgba(0, 170, 235, 0.06);

    transform: translateY(18px) scale(0.97);

    transition:
        transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ms-kyc-confirm-overlay.active .ms-kyc-confirm-modal {
    transform: translateY(0) scale(1);
}


/* =========================================================
   CLOSE BUTTON
   ========================================================= */

.ms-kyc-confirm-close {
    position: absolute;

    top: 14px;
    right: 14px;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;

    background: rgba(255, 255, 255, 0.045);

    color: rgba(255, 255, 255, 0.55);

    font-size: 14px;

    cursor: pointer;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
}

.ms-kyc-confirm-close:hover {
    background: rgba(0, 170, 235, 0.10);

    border-color: rgba(0, 170, 235, 0.20);

    color: #00aaeb;

    transform: rotate(4deg);
}


/* =========================================================
   ICON
   ========================================================= */

.ms-kyc-confirm-icon {
    width: 60px;
    height: 60px;

    margin: 2px auto 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 17px;

    border: 1px solid rgba(0, 170, 235, 0.20);

    background:
        linear-gradient(
            145deg,
            rgba(0, 170, 235, 0.14),
            rgba(0, 170, 235, 0.045)
        );

    color: #00aaeb;

    font-size: 24px;

    box-shadow:
        0 10px 30px rgba(0, 170, 235, 0.10),
        inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.ms-kyc-confirm-icon i {
    filter: drop-shadow(
        0 0 8px rgba(0, 170, 235, 0.25)
    );
}


/* =========================================================
   CONTENT
   ========================================================= */

.ms-kyc-confirm-content {
    text-align: center;
}

.ms-kyc-confirm-content h3 {
    margin: 0 0 9px;

    color: #ffffff;

    font-size: 21px;
    font-weight: 700;

    line-height: 1.3;

    letter-spacing: -0.25px;
}

.ms-kyc-confirm-content p {
    max-width: 370px;

    margin: 0 auto;

    color: rgba(255, 255, 255, 0.56);

    font-size: 13px;
    font-weight: 400;

    line-height: 1.65;
}


/* =========================================================
   INFORMATION NOTICE
   ========================================================= */

.ms-kyc-confirm-notice {
    display: flex;
    align-items: flex-start;

    gap: 10px;

    margin-top: 19px;
    padding: 13px 14px;

    text-align: left;

    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 12px;

    background: rgba(255, 255, 255, 0.032);

    color: rgba(255, 255, 255, 0.52);

    font-size: 12px;
    line-height: 1.55;
}

.ms-kyc-confirm-notice i {
    flex: 0 0 auto;

    margin-top: 2px;

    color: #00aaeb;

    font-size: 13px;

    filter: drop-shadow(
        0 0 6px rgba(0, 170, 235, 0.22)
    );
}


/* =========================================================
   ACTIONS
   ========================================================= */

.ms-kyc-confirm-actions {
    display: flex;

    gap: 10px;

    margin-top: 24px;
}

.ms-kyc-confirm-actions button {
    flex: 1;

    height: 45px;

    padding: 0 18px;

    border-radius: 11px;

    font-family: inherit;

    font-size: 13px;
    font-weight: 600;

    line-height: 1;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        opacity 0.2s ease;
}


/* =========================================================
   CANCEL
   ========================================================= */

.ms-kyc-confirm-cancel {
    border: 1px solid rgba(255, 255, 255, 0.085);

    background: rgba(255, 255, 255, 0.045);

    color: rgba(255, 255, 255, 0.68);
}

.ms-kyc-confirm-cancel:hover {
    border-color: rgba(255, 255, 255, 0.13);

    background: rgba(255, 255, 255, 0.075);

    color: #ffffff;
}


/* =========================================================
   CONFIRM & SUBMIT
   ========================================================= */

.ms-kyc-confirm-submit {
    position: relative;

    border: 1px solid rgba(0, 170, 235, 0.45);

    background:
        linear-gradient(
            135deg,
            #00b4ed 0%,
            #009edb 100%
        );

    color: #ffffff;

    box-shadow:
        0 7px 22px rgba(0, 170, 235, 0.18);
}

.ms-kyc-confirm-submit:hover {
    border-color: rgba(0, 190, 255, 0.65);

    background:
        linear-gradient(
            135deg,
            #09b9ef 0%,
            #00a6e5 100%
        );

    box-shadow:
        0 9px 28px rgba(0, 170, 235, 0.27);

    transform: translateY(-1px);
}

.ms-kyc-confirm-submit:active {
    transform: translateY(0);
}


/* =========================================================
   DISABLED STATE
   ========================================================= */

.ms-kyc-confirm-submit:disabled {
    opacity: 0.55;

    cursor: not-allowed;

    transform: none;

    box-shadow: none;
}


/* =========================================================
   LOADING
   ========================================================= */

.kyc-confirm-loading {
    display: none;
}

.ms-kyc-confirm-submit.loading
.kyc-confirm-submit-text {
    display: none;
}

.ms-kyc-confirm-submit.loading
.kyc-confirm-loading {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 7px;
}

.kyc-confirm-loading i {
    font-size: 12px;
}


/* =========================================================
   BODY WHEN MODAL IS OPEN
   ========================================================= */

body.kyc-confirm-modal-open {
    overflow: hidden;
}


/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 520px) {

    .ms-kyc-confirm-overlay {
        padding: 16px;
    }

    .ms-kyc-confirm-modal {
        max-width: 100%;

        padding: 30px 20px 22px;

        border-radius: 18px;
    }

    .ms-kyc-confirm-icon {
        width: 56px;
        height: 56px;

        margin-bottom: 17px;

        border-radius: 15px;

        font-size: 22px;
    }

    .ms-kyc-confirm-content h3 {
        font-size: 19px;
    }

    .ms-kyc-confirm-content p {
        font-size: 12.5px;
    }

    .ms-kyc-confirm-notice {
        margin-top: 17px;

        padding: 12px;

        font-size: 11.5px;
    }

    .ms-kyc-confirm-actions {
        flex-direction: column-reverse;

        gap: 9px;

        margin-top: 21px;
    }

    .ms-kyc-confirm-actions button {
        width: 100%;

        height: 44px;
    }
}
