    }

    .dark-confirm-title {
        color: #ffffff !important;
        font-size: 20px !important;
    }

    .dark-confirm-message {
        color: #c9c9d2 !important;
        font-size: 15px !important;
    }

    .dark-confirm-button,
    .dark-cancel-button {
        border: 0;
        border-radius: 5px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .dark-confirm-button {
        background: rgba(var(--color-primary), 1);
        color: rgba(var(--color-text-primary), 1);
        margin-right: 8px;
    }

        .dark-confirm-button:hover {
            opacity: 0.9;
        }

    .dark-cancel-button {
        background: #2c2c35;
        color: #ffffff;
    }

        .dark-cancel-button:hover {
            background: #3a3a45;
        }
</style>
<script>
        function showmore(id) {
            const content = document.getElementById(id);
            content.classList.toggle("show-hide");
        }
</script>
<script>
    function showDarkConfirm(title, message, onConfirm) {

        Swal.fire({
            icon: "question",
            title: title,
            html: message,

            background: "#1f1f27",
            color: "#ffffff",

            confirmButtonText: "Confirm",
            cancelButtonText: "Cancel",

            showCancelButton: true,
            buttonsStyling: false,

            customClass: {
                popup: "dark-confirm-popup",
                title: "dark-confirm-title",
                htmlContainer: "dark-confirm-message",
                confirmButton: "dark-confirm-button",
                cancelButton: "dark-cancel-button"
            },

            allowOutsideClick: false,
            allowEscapeKey: true,

            didOpen: () => {
                document.body.style.paddingRight = "0px";
            },

            willClose: () => {
                document.body.style.paddingRight = "0px";
            }
        }).then((result) => {

            if (result.isConfirmed && typeof onConfirm === "function") {
                onConfirm();
            }

        });
    }
</script>
<script>
    function confirmDeposit() {

        const value = document.getElementById("deposit-input").value;

        // Keep the existing validation inside deposit()
        // if the amount is invalid.
        if (value === "" || isNaN(value) || Number(value) <= 0) {
            deposit();
            return;
        }

        const amount = Number(value).toFixed(2);

        showDarkConfirm(
            "Confirm Deposit",
            "Are you sure you want to deposit <strong>" +
            amount +
            " USD</strong>?",
            function () {
                deposit();
            }
        );
    }
</script>
<script>
    async function deposit() {

        let value = document.getElementById("deposit-input").value;

        if (value !== "" && !isNaN(value) && Number(value) > 20) {

        } else {
            console.log("Please enter a number greater than 20");
            $("#failed-header").text("Deposit");
            $("#failed-body").text("Please enter a number greater than 20");
            const modal = document.getElementById("failed-notice-modal");
            modal.style.transform = "translateX(0%)";
            setTimeout(function () {
                modal.style.transform = "translateX(110%)";
            }, 2000);
            return
        }

        const amount = Number(value);
        try {
            $.ajax({
                url: "/Checkout/GenerateCheckoutUrl",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: JSON.stringify({
                    UserCode: "@User.Identity.Name",
                    Amount: amount.toFixed(2),
                }),
                success: function (result) {
                    if (!result.success) {
                        Swal.fire({
                            icon: "error",
                            title: result.message
                        });
                        $("#failed-header").text("Deposit");
                        $("#failed-body").text(result.message);
                        const modal = document.getElementById("failed-notice-modal");
                        modal.style.transform = "translateX(0%)";
                        setTimeout(function () {
                            modal.style.transform = "translateX(110%)";
                        }, 2000);
                        return;
                    }
                    else {
                        console.log(result.checkoutUrl);
                        window.open(`${result.checkoutUrl}`, "_blank");
                    }
                },
                error: function () {
                    $("#failed-header").text("Deposit");
                    $("#failed-body").text("Deposit failed");
                    const modal = document.getElementById("failed-notice-modal");
                    modal.style.transform = "translateX(0%)";
                    setTimeout(function () {
                        modal.style.transform = "translateX(110%)";
                    }, 2000);
                }
            });
        }
        catch (err) {
            console.error(err);
            $("#failed-header").text("Deposit");
            $("#failed-body").text("Network Error");
            const modal = document.getElementById("failed-notice-modal");
            modal.style.transform = "translateX(0%)";
            setTimeout(function () {
                modal.style.transform = "translateX(110%)";
            }, 2000);

        }
    }


</script>

