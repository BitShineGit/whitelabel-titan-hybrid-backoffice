<script>
    function showDarkConfirm(title, message, onConfirm) {

        Swal.fire({
            icon: "question",
            title: title,
            html: message,

            background: "#1f1f27",
            color: "#ffffff",

            confirmButtonText: "Confirm",
            cancelButtonText: "Cancel",

            showCancelButton: true,
            buttonsStyling: false,

            customClass: {
                popup: "dark-confirm-popup",
                title: "dark-confirm-title",
                htmlContainer: "dark-confirm-message",
                confirmButton: "dark-confirm-button",
                cancelButton: "dark-cancel-button"
            },

            allowOutsideClick: false,
            allowEscapeKey: true,

            didOpen: () => {
                document.body.style.paddingRight = "0px";
            },

            willClose: () => {
                document.body.style.paddingRight = "0px";
            }
        }).then((result) => {

            if (result.isConfirmed && typeof onConfirm === "function") {
                onConfirm();
            }

        });
    }
</script>
<script>
    // ============================================
    // Quick amount select buttons
    // ============================================
    document.addEventListener("click", function (e) {
        const btn = e.target.closest(".quick-amount-btn");
        if (!btn) return;

        e.preventDefault();

        const container = btn.closest(".payment-withdraw-logic");
        const amountInput = container.querySelector("input#withdrawAmount");
        const allQuickBtns = btn.closest(".quick-amounts").querySelectorAll(".quick-amount-btn");

        allQuickBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        const selected = btn.dataset.amount;

        if (selected === "custom") {
            amountInput.value = "";
            amountInput.disabled = false;
            amountInput.focus();
        } else {
            const currentValue = parseFloat(amountInput.value) || 0;
            const addedValue = parseFloat(selected) || 0;
            amountInput.value = currentValue + addedValue;
            amountInput.disabled = true;
        }
    });

    // ============================================
    // Withdraw submit
    // ============================================
    document.addEventListener("click", function (e) {
        const button = e.target.closest(".payment-withdraw-logic .submit-button");
        if (!button) return;

        e.preventDefault();

        const container = button.closest(".payment-withdraw-logic");
        const amountInput = container.querySelector("input#withdrawAmount");
        const amountValue = parseFloat(amountInput.value);

        if (!amountValue || isNaN(amountValue)) {
            showFailedModal("Withdraw", "Please enter a valid amount");
            return;
        }

        if (amountValue <= 5) {
            showFailedModal("Withdraw", "Amount must be greater than 5");
            return;
        }

        if (amountValue >= 5000) {
            showFailedModal("Withdraw", "Amount must be less than 5000");
            return;
        }

        showDarkConfirm(
            "Confirm Withdraw",
            "Are you sure you want to withdraw <strong>" +
            amountValue.toFixed(2) +
            " USD</strong>?",
            function () {

                button.disabled = true;

                fetch("/Withdraw/CreateWithdrawRequest", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        amount: amountValue,
                        usercode: "@User.Identity.Name"
                    })
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }

                        return response.json();
                    })
                    .then(function (result) {

                        button.disabled = false;

                        if (!result.success) {
                            Swal.fire({
                                icon: "error",
                                title: result.message
                            });

                            showFailedModal("Withdraw", result.message);
                            return;
                        }

                        showSuccessModal(
                            "Withdraw",
                            "Withdraw request submitted."
                        );
                    })
                    .catch(function (err) {

                        button.disabled = false;

                        console.error(err);

                        showFailedModal(
                            "Withdraw",
                            "Network Error"
                        );
                    });
            }
        )
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Network response was not ok");
                }
                return response.json();
            })
            .then(function (result) {
                button.disabled = false;

                if (!result.success) {
                    Swal.fire({
                        icon: "error",
                        title: result.message
                    });
                    showFailedModal("Withdraw", result.message);
                    return;
                }

                showSuccessModal("Withdraw", "Withdraw request submitted.");
            })
            .catch(function (err) {
                button.disabled = false;
                console.error(err);
                showFailedModal("Withdraw", "Network Error");
            });
    });

    function showFailedModal(header, body) {
        document.getElementById("failed-header").textContent = header;
        document.getElementById("failed-body").textContent = body;
        const modal = document.getElementById("failed-notice-modal");
        modal.style.transform = "translateX(0%)";
        setTimeout(function () {
            modal.style.transform = "translateX(110%)";
        }, 2000);
    }

    function showSuccessModal(header, body) {
        document.getElementById("success-header").textContent = header;
        document.getElementById("success-body").textContent = body;
        const modal = document.getElementById("success-notice-modal");
        modal.style.transform = "translateX(0%)";
        setTimeout(function () {
            modal.style.transform = "translateX(110%)";
        }, 2000);
    }
</script>
