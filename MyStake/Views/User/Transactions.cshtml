<style>
    .transaction-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
    }

        .transaction-modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .transaction-modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(3px);
    }

    .transaction-modal-content {
        position: relative;
        width: 420px;
        max-width: calc(100% - 30px);
        background: #1b1d24;
        border: 1px solid #30333d;
        border-radius: 10px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        z-index: 1;
    }

    .transaction-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        border-bottom: 1px solid #30333d;
    }

        .transaction-modal-header h3 {
            margin: 0;
            color: #ffffff;
            font-size: 18px;
            font-weight: 600;
        }

    .transaction-modal-close {
        border: 0;
        background: transparent;
        color: #8d919d;
        font-size: 26px;
        line-height: 1;
        cursor: pointer;
    }

        .transaction-modal-close:hover {
            color: #ffffff;
        }

    .transaction-modal-body {
        padding: 22px 20px;
    }

        .transaction-modal-body p {
            margin: 0 0 8px;
            color: #ffffff;
            font-size: 15px;
        }

        .transaction-modal-body span {
            color: #8d919d;
            font-size: 13px;
        }

    .transaction-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 15px 20px;
        border-top: 1px solid #30333d;
    }

    .transaction-modal-btn {
        min-width: 90px;
        padding: 9px 16px;
        border-radius: 6px;
        border: 1px solid transparent;
        font-size: 14px;
        cursor: pointer;
    }

        .transaction-modal-btn.secondary {
            background: #292c35;
            border-color: #3a3d47;
            color: #ffffff;
        }

            .transaction-modal-btn.secondary:hover {
                background: #333640;
            }

        .transaction-modal-btn.danger {
            background: #00aaeb;
            border-color: #00aaeb;
            color: white;
        }

            .transaction-modal-btn.danger:hover {
                background: #00aaeb;
            }
    /* =========================================================
       TRANSACTION STATUS
    ========================================================= */

    .transaction-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 80px;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.2;
    }


        /* Pending */

        .transaction-status.status-pending {
            background: rgba(255, 193, 7, 0.12);
            color: #ffc107;
        }


        /* Processing */

        .transaction-status.status-processing {
            background: rgba(33, 150, 243, 0.12);
            color: #2196f3;
        }


        /* Completed / Success */

        .transaction-status.status-completed,
        .transaction-status.status-success {
            background: rgba(0, 200, 83, 0.12);
            color: #00c853;
        }


        /* Rejected / Failed / Canceled */

        .transaction-status.status-rejected,
        .transaction-status.status-failed,
        .transaction-status.status-canceled {
            background: rgba(255, 59, 77, 0.12);
            color: #ff3b4d;
        }


        /* Outstanding */

        .transaction-status.status-outstanding {
            background: rgba(255, 193, 7, 0.12);
            color: #ffc107;
        }


    /* =========================================================
       BET / WIN AMOUNT
    ========================================================= */

    .transaction-amount {
        font-weight: 500;
    }

        .transaction-amount.amount-profit {
            color: #00c853;
        }

        .transaction-amount.amount-loss {
            color: #ff3b4d;
        }

        .transaction-amount.amount-even {
            color: #ffc107;
        }


    /* =========================================================
       PAGINATION
    ========================================================= */

    .transactions-wrapper .core-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 24px;
        padding: 10px 0;
        flex-wrap: wrap;
    }

    .transaction-page-btn {
        min-width: 38px;
        height: 36px;
        padding: 0 12px;
        border: 1px solid #30333d;
        border-radius: 5px;
        background: #1b1d24;
        color: #8d919d;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .transaction-page-btn:hover:not(:disabled) {
            background: #292c35;
            color: #ffffff;
            border-color: #444854;
        }

        .transaction-page-btn.active {
            background: #00aaeb;
            border-color: #00aaeb;
            color: #ffffff;
        }

        .transaction-page-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

        .transaction-page-btn.navigation {
            min-width: 78px;
        }

        .transaction-page-btn.first-last {
            min-width: 65px;
        }

    .transaction-pagination-dots {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 36px;
        color: #8d919d;
        font-size: 13px;
    }
</style>
