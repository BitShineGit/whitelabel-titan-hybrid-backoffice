                                <th><span>Name</span></th>
                                <th><span>Amount</span></th>
                                <th><span>Result</span></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <!---->
                    </table>
                    <!---->
                    <!----><!---->
                    <div class="core-pagination"><!----></div>
                    <!---->
                </section>
            </main>
            <!---->
        </div>
    </div>
    <!---->
</main>

<div id="cancelWithdrawalModal" class="transaction-modal">
    <div class="transaction-modal-overlay"></div>

    <div class="transaction-modal-content">
        <div class="transaction-modal-header">
            <h3>Cancel Withdrawal</h3>

            <button type="button"
                    id="closeCancelWithdrawalModal"
                    class="transaction-modal-close">
                ×
            </button>
        </div>

        <div class="transaction-modal-body">
            <p>Are you sure you want to cancel this withdrawal?</p>
            <span>This action cannot be undone.</span>
        </div>

        <div class="transaction-modal-footer">
            <button type="button"
                    id="cancelWithdrawalNo"
                    class="transaction-modal-btn secondary">
                No
            </button>

            <button type="button"
                    id="cancelWithdrawalYes"
                    class="transaction-modal-btn danger">
                Yes, Cancel
            </button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        /* =========================================================
           TRANSACTION SETTINGS
        ========================================================= */

        const pageSize = 10;

        let currentPage = 1;

        let allTransactions = [];

        const userTimeZone =
            Intl.DateTimeFormat().resolvedOptions().timeZone;

        let selectedActivity = "All";

        let selectedStatus = "Status";

        let selectedWithdrawalId = null;


        /* =========================================================
           DATE FORMAT
        ========================================================= */

        function formatDateTime(dateTime) {

            if (!dateTime) {
                return "-";
            }

            return moment
                .utc(dateTime)
                .local()
                .format("YYYY-MM-DD HH:mm:ss");
        }




        /* =========================================================
           STATUS OPTIONS
        ========================================================= */

        function updateStatusOptions() {

            const statusContainer =
                $(".transactions .user-dropdown")
                    .eq(1)
                    .find(".options-container");

            statusContainer.empty();


            /* -----------------------------------------------------
               BET / WIN
               ----------------------------------------------------- */

            if (selectedActivity === "Bet/Win") {

                statusContainer.append(`
                            <button
                                type="button"
                                role="option"
                                class="option"
                                aria-selected="false">
                                <span>All</span>
                            </button>

                            <button
                                type="button"
                                role="option"
                                class="option"
                                aria-selected="false">
                                <span>Outstanding</span>
                            </button>

                            <button
                                type="button"
                                role="option"
                                class="option"
                                aria-selected="false">
                                <span>Success</span>
                            </button>

                            <button
                                type="button"
                                role="option"
                                class="option"
                                aria-selected="false">
                                <span>Canceled</span>
                            </button>
                        `);

                return;
            }


            /* -----------------------------------------------------
               DEPOSIT / WITHDRAW / ALL
               ----------------------------------------------------- */

            statusContainer.append(`
                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>All</span>
                        </button>

                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>Pending</span>
                        </button>

                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>Processing</span>
                        </button>

                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>Completed</span>
                        </button>

                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>Rejected</span>
                        </button>

                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>Failed</span>
                        </button>

                        <button
                            type="button"
                            role="option"
                            class="option"
                            aria-selected="false">
                            <span>Canceled</span>
                        </button>
                    `);
        }


        /* =========================================================
           OPEN / CLOSE TRANSACTION DROPDOWNS
        ========================================================= */

        $(".transactions .user-dropdown-toggle").on(
            "click",
            function (e) {

                e.preventDefault();

                e.stopPropagation();

                const dropdown =
                    $(this).closest(".user-dropdown");


                $(".transactions .user-dropdown")
                    .not(dropdown)
                    .removeClass("open");


                dropdown.toggleClass("open");
            }
        );


        /* =========================================================
           ACTIVITY TYPE
        ========================================================= */

        $(".transactions .user-dropdown")
            .eq(0)
            .find(".user-dropdown-menu")
            .on(
                "click",
                ".option",
                function (e) {

                    e.preventDefault();

                    e.stopPropagation();

                    const value =
                        $(this)
                            .find("span")
                            .text()
                            .trim();


                    if (!value) {
                        return;
                    }


                    selectedActivity = value;

                    $("#selectedactivity")
                        .text(value);


                    /*
                     * Reset status whenever Activity changes.
                     */

                    selectedStatus = "Status";

                    $("#selectedstatus")
                        .text("Status");


                    /*
                     * Rebuild the Status dropdown.
                     */

                    updateStatusOptions();


                    currentPage = 1;


                    /*
                     * Close dropdown.
                     */

                    $(".transactions .user-dropdown")
                        .removeClass("open");
                }
            );


        /* =========================================================
           STATUS
        ========================================================= */

        $(".transactions .user-dropdown")
            .eq(1)
            .find(".user-dropdown-menu")
            .on(
                "click",
                ".option",
                function (e) {

                    e.preventDefault();

                    e.stopPropagation();


                    const value =
                        $(this)
                            .find("span")
                            .text()
                            .trim();


                    if (!value) {
                        return;
                    }


                    selectedStatus = value;

                    $("#selectedstatus")
                        .text(value);


                    currentPage = 1;


                    /*
                     * Close dropdown.
                     */

                    $(".transactions .user-dropdown")
                        .removeClass("open");
                }
            );


        /* =========================================================
           CLOSE DROPDOWNS WHEN CLICKING OUTSIDE
        ========================================================= */

        $(document).on(
            "click.transactionDropdown",
            function () {

                $(".transactions .user-dropdown")
                    .removeClass("open");
            }
        );


        /* =========================================================
           PREVENT TRANSACTION DROPDOWN CLICKS FROM REACHING
           OTHER PAGE NAVIGATION HANDLERS
        ========================================================= */

        $(".transactions .user-dropdown-menu").on(
            "click.transactionDropdown",
            function (e) {

                e.stopPropagation();
            }
        );


        /* =========================================================
           CANCEL WITHDRAWAL
        ========================================================= */

        $(document).on(
            "click",
            ".transaction-cancel-btn",
            function (e) {

                e.preventDefault();

                e.stopPropagation();

                selectedWithdrawalId =
                    $(this).data("id");

                if (!selectedWithdrawalId) {
                    return;
                }

                $("#cancelWithdrawalModal")
                    .addClass("show");
            }
        );


        function closeCancelWithdrawalModal() {

            selectedWithdrawalId = null;

            $("#cancelWithdrawalModal")
                .removeClass("show");

            $("#cancelWithdrawalYes")
                .prop("disabled", false)
                .text("Yes, Cancel");
        }


        $("#closeCancelWithdrawalModal").on(
            "click",
            function (e) {

                e.preventDefault();

                closeCancelWithdrawalModal();
            }
        );


        $("#cancelWithdrawalNo").on(
            "click",
            function (e) {

                e.preventDefault();

                closeCancelWithdrawalModal();
            }
        );


        $(".transaction-modal-overlay").on(
            "click",
            function () {

                closeCancelWithdrawalModal();
            }
        );


        $("#cancelWithdrawalYes").on(
            "click",
            function (e) {

                e.preventDefault();

                if (!selectedWithdrawalId) {
                    return;
                }


                const withdrawalId =
                    selectedWithdrawalId;


                $("#cancelWithdrawalYes")
                    .prop("disabled", true)
                    .text("Canceling...");


                $.ajax({

                    url:
                        '@Url.Action("CancelWithdrawal", "User")',

                    type: "POST",

                    data: {
                        id: withdrawalId
                    },

                    success:
                        function (response) {

                            if (!response.success) {

                                console.error(
                                    response.message
                                );

                                closeCancelWithdrawalModal();

                                return;
                            }


                            closeCancelWithdrawalModal();


                            /*
                             * Reload current filter results.
                             */

                            currentPage = 1;

                            loadTransactions();
                        },

                    error:
                        function (xhr) {

                            console.error(
                                "Cancel withdrawal error:",
                                xhr
                            );

                            closeCancelWithdrawalModal();
                        }
                });
            }
        );


        /* =========================================================
    STATUS CLASS
    ========================================================= */

        function getStatusClass(status) {

            if (!status) {
                return "";
            }

            switch (status.toLowerCase()) {

                case "success":
                    return "status-success";

                case "completed":
                    return "status-completed";

                case "pending":
                    return "status-pending";

                case "processing":
                    return "status-processing";

                case "rejected":
                    return "status-rejected";

                case "failed":
                    return "status-failed";

                case "canceled":
                case "cancelled":
                    return "status-canceled";

                case "outstanding":
                    return "status-outstanding";

                default:
                    return "";
            }
        }
        /* =========================================================
           RENDER DESKTOP TRANSACTIONS
        ========================================================= */

        function renderDesktopTransactions() {

            const tbody =
                $(".transactions .core-table tbody");

            tbody.empty();


            const start =
                (currentPage - 1) * pageSize;


            const end =
                start + pageSize;


            const transactions =
                allTransactions.slice(start, end);


            if (transactions.length === 0) {

                tbody.append(`
                <tr>
                    <td colspan="5" style="text-align:center;">
                        No transactions found.
                    </td>
                </tr>
            `);

                renderPagination();

                return;
            }


            transactions.forEach(
                function (transaction) {

                    /* =====================================================
                       AMOUNT
                    ===================================================== */

                    let amountHtml = "-";

                    if (transaction.type === "Bet/Win") {

                        const betAmount =
                            transaction.amount !== undefined &&
                                transaction.amount !== null
                                ? transaction.amount
                                : 0;


                        const winAmount =
                            transaction.winAmount !== undefined &&
                                transaction.winAmount !== null
                                ? transaction.winAmount
                                : 0;


                        amountHtml = `
                            <span class="transaction-amount amount-loss">
                                -${betAmount}
                            </span>
                            /
                            <span class="transaction-amount amount-profit">
                                +${winAmount}
                            </span>
                        `;
                    }
                    else if (
                        transaction.amount !== undefined
                    ) {

                        amountHtml =
                            transaction.amount;
                    }


                    /* =====================================================
                       RESULT
                    ===================================================== */

                    const result =
                        transaction.result || "-";


                    const statusClass =
                        getStatusClass(result);


                    let resultHtml = "";


                    if (transaction.canCancel) {

                        resultHtml = `
                        <div class="transaction-result">

                            <span
                                style="margin-right:30px;"
                                class="transaction-status ${statusClass}">
                                ${result}
                            </span>

                            <button
                                type="button"
                                class="transaction-cancel-btn"
                                data-id="${transaction.id}">
                                Cancel
                            </button>

                        </div>
                    `;
                    }
                    else {

                        resultHtml = `
                        <span
                            class="transaction-status ${statusClass}">
                            ${result}
                        </span>
                    `;
                    }


                    /* =====================================================
                       ROW
                    ===================================================== */

                    tbody.append(`
                    <tr>

                        <td>
                            ${formatDateTime(
                        transaction.dateTime
                    )}
                        </td>

                        <td>
                            ${transaction.type || "-"}
                        </td>

                        <td>
                            ${transaction.name || "-"}
                        </td>

                        <td>
                            ${amountHtml}
                        </td>

                        <td>
                            ${resultHtml}
                        </td>

                    </tr>
                `);
                }
            );


            renderPagination();
        }



        /* =========================================================
           PAGINATION CLICK
        ========================================================= */


        function renderPagination() {

            const pagination =
                $(".transactions-wrapper .core-pagination");


            pagination.empty();


            const totalPages =
                Math.ceil(
                    allTransactions.length / pageSize
                );


            /*
             * No pagination required for zero or one page.
             */

            if (totalPages <= 1) {
                return;
            }


            /* =====================================================
               FIRST PAGE
            ===================================================== */

            pagination.append(`
            <button
                type="button"
                class="transaction-page-btn first-last"
                data-page="1"
                title="Go to First Page"
                ${currentPage === 1 ? "disabled" : ""}>
                First
            </button>
        `);


            /* =====================================================
               PREVIOUS
            ===================================================== */

            pagination.append(`
            <button
                type="button"
                class="transaction-page-btn navigation"
                data-page="${currentPage - 1}"
                title="Previous Page"
                ${currentPage === 1 ? "disabled" : ""}>
                Previous
            </button>
        `);


            /* =====================================================
               PAGE NUMBERS
            ===================================================== */

            let startPage = 1;
            let endPage = totalPages;


            /*
             * Show all pages when there are 7 or fewer.
             */

            if (totalPages > 7) {

                if (currentPage <= 4) {

                    startPage = 1;
                    endPage = 5;

                }
                else if (currentPage >= totalPages - 3) {

                    startPage = totalPages - 4;
                    endPage = totalPages;

                }
                else {

                    startPage = currentPage - 2;
                    endPage = currentPage + 2;
                }
            }


            /*
             * First page + ellipsis.
             */

            if (startPage > 1) {

                pagination.append(`
                <button
                    type="button"
                    class="transaction-page-btn"
                    data-page="1">
                    1
                </button>
            `);

                pagination.append(`
                <span class="transaction-pagination-dots">
                    ...
                </span>
            `);
            }


            /*
             * Page numbers.
             */

            for (
                let i = startPage;
                i <= endPage;
                i++
            ) {

                pagination.append(`
                <button
                    type="button"
                    class="transaction-page-btn ${i === currentPage
                        ? "active"
                        : ""
                    }"
                    data-page="${i}">
                    ${i}
                </button>
            `);
            }


            /*
             * Last page + ellipsis.
             */

            if (endPage < totalPages) {

                pagination.append(`
                <span class="transaction-pagination-dots">
                    ...
                </span>
            `);

                pagination.append(`
                <button
                    type="button"
                    class="transaction-page-btn"
                    data-page="${totalPages}">
                    ${totalPages}
                </button>
            `);
            }


            /* =====================================================
               NEXT
            ===================================================== */

            pagination.append(`
            <button
                type="button"
                class="transaction-page-btn navigation"
                data-page="${currentPage + 1}"
                title="Next Page"
                ${currentPage === totalPages ? "disabled" : ""}>
                Next
            </button>
        `);


            /* =====================================================
               LAST PAGE
            ===================================================== */

            pagination.append(`
            <button
                type="button"
                class="transaction-page-btn first-last"
                data-page="${totalPages}"
                title="Go to Last Page"
                ${currentPage === totalPages ? "disabled" : ""}>
                Last
            </button>
        `);
        }
        /* =========================================================
    PAGINATION CLICK
    ========================================================= */

        $(document).on(
            "click.transactionPagination",
            ".transaction-page-btn",
            function (e) {

                e.preventDefault();
                e.stopPropagation();

                if ($(this).prop("disabled")) {
                    return;
                }

                const page = parseInt(
                    $(this).attr("data-page"),
                    10
                );

                const totalPages = Math.ceil(
                    allTransactions.length / pageSize
                );

                if (
                    isNaN(page) ||
                    page < 1 ||
                    page > totalPages ||
                    page === currentPage
                ) {
                    return;
                }

                currentPage = page;

                renderDesktopTransactions();

                $(".transactions-wrapper .core-table")[0]
                    ?.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
            }
        );
        /* =========================================================
           LOAD TRANSACTIONS
        ========================================================= */

        function loadTransactions() {

            const fromDate =
                $("#fromDate").val();


            const toDate =
                $("#toDate").val();


            $.ajax({

                url:
                    '@Url.Action("GetTransactions", "User")',

                type: "POST",

                data: {

                    activityType:
                        selectedActivity,

                    status:
                        selectedStatus,

                    fromDate:
                        fromDate,

                    toDate:
                        toDate,

                    timeZone:
                        userTimeZone
                },

                success:
                    function (response) {

                        if (!response.success) {

                            console.error(
                                response.message
                            );

                            return;
                        }


                        allTransactions =
                            response.transactions || [];


                        currentPage = 1;


                        renderDesktopTransactions();
                    },

                error:
                    function (xhr) {

                        console.error(
                            "Failed to load transactions.",
                            xhr
                        );
                    }
            });
        }


        /* =========================================================
           SUBMIT
        ========================================================= */

        $(".transactions .filters-wrapper > .core-button")
            .on(
                "click",
                function (e) {

                    e.preventDefault();

                    e.stopPropagation();


                    currentPage = 1;


                    loadTransactions();
                }
            );


        /* =========================================================
           INITIAL STATUS OPTIONS
        ========================================================= */

        updateStatusOptions();


        /*
         * Do NOT load transactions automatically.
         * AJAX happens only after Submit.
         */

        allTransactions = [];

        currentPage = 1;

        $(".transactions .core-table tbody")
            .empty();

        $(".transactions-wrapper .core-pagination")
            .empty();

    });
</script>