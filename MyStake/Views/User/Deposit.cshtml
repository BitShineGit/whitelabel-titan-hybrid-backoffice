</script>
<script>
    $(".select-button").on("click", function () {
        $(this).siblings().removeClass("active");
        $(this).siblings().removeClass("highlight");
        $(this).addClass("active");
        $(this).addClass("highlight")
    });
</script>
<script>
    function showDarkConfirm(title, message, onConfirm) {

        Swal.fire({
            icon: "question",
            title: title,
            html: message,

            background: "#1f1f27",
            color: "#ffffff",

            confirmButtonText: "Confirm",
            cancelButtonText: "Cancel",

            showCancelButton: true,
            buttonsStyling: false,

            customClass: {
                popup: "dark-confirm-popup",
                title: "dark-confirm-title",
                htmlContainer: "dark-confirm-message",
                confirmButton: "dark-confirm-button",
                cancelButton: "dark-cancel-button"
            },

            allowOutsideClick: false,
            allowEscapeKey: true,

            didOpen: () => {
                document.body.style.paddingRight = "0px";
            },

            willClose: () => {
                document.body.style.paddingRight = "0px";
            }
        }).then((result) => {

            if (result.isConfirmed && typeof onConfirm === "function") {
                onConfirm();
            }

        });
    }
</script>
<script>
    function confirmDeposit() {

        const value = document.getElementById("deposit-input").value;

        // Keep the existing validation inside deposit()
        // if the amount is invalid.
        if (value === "" || isNaN(value) || Number(value) <= 0) {
            deposit();
            return;
        }

        const amount = Number(value).toFixed(2);

        showDarkConfirm(
            "Confirm Deposit",
            "Are you sure you want to deposit <strong>" +
            amount +
            " USD</strong>?",
            function () {
                deposit();
            }
        );
    }
</script>
<script>
    async function deposit() {

        let value = document.getElementById("deposit-input").value;

        if (value !== "" && !isNaN(value) && Number(value) > 20) {
            
        } else {
            console.log("Please enter a number greater than 20");
            $("#failed-header").text("Deposit");
            $("#failed-body").text("Please enter a number greater than 20");
            const modal = document.getElementById("failed-notice-modal");
            modal.style.transform = "translateX(0%)";
            setTimeout(function () {
                modal.style.transform = "translateX(110%)";
            }, 2000);
            return
        }
        $('#depositLoading').addClass('show');
        const amount = Number(value);
        try {
            $.ajax({
                url: "/Checkout/GenerateCheckoutUrl",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: JSON.stringify({
                    UserCode: "@User.Identity.Name",
                    Amount: amount.toFixed(2),
                }),
                success: function (result) {
                    if (!result.success) {
                        Swal.fire({
                            icon: "error",
                            title: result.message
                        });
                        $("#failed-header").text("Deposit");
                        $("#failed-body").text(result.message);
                        const modal = document.getElementById("failed-notice-modal");
                        modal.style.transform = "translateX(0%)";
                        setTimeout(function () {
                            modal.style.transform = "translateX(110%)";
                        }, 2000);
                        return;
                    }
                    else {
                        console.log(result.checkoutUrl);
                        window.open(`${result.checkoutUrl}`, "_blank");
                        $('#depositLoading').removeClass('show');
                    }
                },
                error: function () {
                    $('#depositLoading').removeClass('show');
                    $("#failed-header").text("Deposit");
                    $("#failed-body").text("Deposit failed");
                    const modal = document.getElementById("failed-notice-modal");
                    modal.style.transform = "translateX(0%)";
                    setTimeout(function () {
                        modal.style.transform = "translateX(110%)";
                    }, 2000);
                }
            });
        }
        catch (err) {
            $('#depositLoading').removeClass('show');
            console.error(err);
            $("#failed-header").text("Deposit");
            $("#failed-body").text("Network Error");
            const modal = document.getElementById("failed-notice-modal");
            modal.style.transform = "translateX(0%)";
            setTimeout(function () {
                modal.style.transform = "translateX(110%)";
            }, 2000);

        }
    }


</script>



