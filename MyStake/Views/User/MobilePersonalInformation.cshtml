<script>

    /* =========================================================
       ACCOUNT TABS
    ========================================================= */

    $(document).on("click", ".ms-account-tab", function () {

        const tab = $(this).data("tab");


        $(".ms-account-tab")
            .removeClass("ms-account-tab-active");


        $(this)
            .addClass("ms-account-tab-active");


        $(".ms-account-tab-content")
            .removeClass("ms-account-tab-content-active");



        if (tab === "personal") {

            $("#ms-personal-tab")
                .addClass("ms-account-tab-content-active");

        }
        else if (tab === "kyc") {

            $("#ms-kyc-tab")
                .addClass("ms-account-tab-content-active");

        }

    });



    /* =========================================================
       PASSWORD MODAL
    ========================================================= */

    function openpasswordModal() {

        const modal =
            document.getElementById("passwordModal");


        modal.classList.add("show");


        document.body.style.overflow = "hidden";

    }



    function closepasswordModal() {

        const modal =
            document.getElementById("passwordModal");


        modal.classList.remove("show");


        document.body.style.overflow = "";

    }



    /* =========================================================
       PASSWORD VALIDATION
    ========================================================= */

    $("#currentpassword-validation").hide();
    $("#newpassword-validation").hide();
    $("#confirmpassword-validation").hide();



    function validatecurrentpassword() {

        if ($("#currentpassword").val() == "") {

            $("#currentpassword-validation")
                .show()
                .text("Please input your current password!");

            return false;
        }


        $("#currentpassword-validation")
            .hide()
            .text("");


        return true;

    }



    function validatenewpassword() {

        const password =
            $("#newpassword").val();


        const valid =
            password.length >= 8 &&
            password.length <= 20 &&
            /[A-Z]/.test(password) &&
            /[a-z]/.test(password) &&
            /[0-9]/.test(password);



        if (password == "") {

            $("#newpassword-validation")
                .show()
                .text("Please input new password!");

            return false;

        }



        if (!valid) {

            $("#newpassword-validation")
                .show()
                .text("Invalid format");

            return false;

        }



        $("#newpassword-validation")
            .hide()
            .text("");


        return true;

    }



    function validateconfirmpassword() {

        const confirmPassword =
            $("#confirmpassword").val();


        const newPassword =
            $("#newpassword").val();



        if (confirmPassword == "") {

            $("#confirmpassword-validation")
                .show()
                .text("Please confirm your password!");


            return false;

        }



        if (confirmPassword != newPassword) {

            $("#confirmpassword-validation")
                .show()
                .text(
                    "The two passwords that you entered do not match!"
                );


            return false;

        }



        $("#confirmpassword-validation")
            .hide()
            .text("");


        return true;

    }



    function togglevalidate() {

        const isValid =
            validatecurrentpassword() &&
            validatenewpassword() &&
            validateconfirmpassword();



        if (isValid) {

            $("#change-password-button")
                .css("opacity", "1")
                .css("pointerEvents", "all");

        }
        else {

            $("#change-password-button")
                .css("opacity", "0.5")
                .css("pointerEvents", "none");

        }

    }



    $("#currentpassword").on("input", function () {

        validatecurrentpassword();

        togglevalidate();

    });



    $("#newpassword").on("input", function () {

        validatenewpassword();

        togglevalidate();

    });



    $("#confirmpassword").on("input", function () {

        validateconfirmpassword();

        togglevalidate();

    });



    /* =========================================================
       CHANGE PASSWORD AJAX
    ========================================================= */

    $("#change-password-button").on("click", function (e) {

        e.preventDefault();



        $.ajax({

            url: "/account/changepassword",

            method: "POST",

            data: {

                CurrentPassword:
                    $("#currentpassword").val(),

                NewPassword:
                    $("#newpassword").val(),

                ConfirmPassword:
                    $("#confirmpassword").val()

            },


            success: function (res) {


                if (res.success) {


                    closepasswordModal();


                    $("#success-header")
                        .text("Change Password");


                    $("#success-body")
                        .text("Successfully change password");



                    const modal =
                        document.getElementById(
                            "success-notice-modal"
                        );


                    modal.style.transform =
                        "translateX(0%)";



                    setTimeout(function () {

                        modal.style.transform =
                            "translateX(110%)";

                    }, 2000);


                    return;

                }



                if (res.errorPassword) {


                    closepasswordModal();


                    $("#failed-header")
                        .text("Change Password");


                    $("#failed-body")
                        .text(
                            "Incorrect username or password"
                        );



                    const modal =
                        document.getElementById(
                            "failed-notice-modal"
                        );


                    modal.style.transform =
                        "translateX(0%)";



                    setTimeout(function () {

                        modal.style.transform =
                            "translateX(110%)";

                    }, 2000);


                    return;

                }

            }

        });

    });





    /* =========================================================
       KYC SUBMIT
    ========================================================= */

    $("#kycSubmitButton").on("click", function (e) {

        e.preventDefault();



        const country =
            $("#kycCountry").val();


        const region =
            $("#kycRegion").val();


        const birthday =
            $("#kycBirthday").val();


        const gender =
            $("#kycGender").val();



        if (!country ||
            !region ||
            !birthday ||
            !gender) {


            $("#failed-header")
                .text("KYC Verification");


            $("#failed-body")
                .text("Please complete all required information.");



            const modal =
                document.getElementById(
                    "failed-notice-modal"
                );


            modal.style.transform =
                "translateX(0%)";



            setTimeout(function () {

                modal.style.transform =
                    "translateX(110%)";

            }, 2000);



            return;

        }




        $.ajax({

            url: "/user/submit-kyc",

            type: "POST",


            data: {


                Country: country,


                Region: region,


                Birthday: birthday,


                Gender: gender,


                __RequestVerificationToken:
                    $('input[name="__RequestVerificationToken"]').val()

            },


            success: function (res) {


                if (res.success) {


                    $("#success-header")
                        .text("KYC Verification");


                    $("#success-body")
                        .text(res.message);



                    const modal =
                        document.getElementById(
                            "success-notice-modal"
                        );



                    modal.style.transform =
                        "translateX(0%)";



                    setTimeout(function () {


                        modal.style.transform =
                            "translateX(110%)";


                        location.reload();


                    }, 2000);



                    return;

                }



                $("#failed-header")
                    .text("KYC Verification");


                $("#failed-body")
                    .text(res.message);



                const modal =
                    document.getElementById(
                        "failed-notice-modal"
                    );


                modal.style.transform =
                    "translateX(0%)";



                setTimeout(function () {

                    modal.style.transform =
                        "translateX(110%)";

                }, 2000);


            }


        });


    });


</script>