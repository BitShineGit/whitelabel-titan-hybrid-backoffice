@using Titan.Repository;

@{
    ViewData["Title"] = "Profile";
    var player = ViewData["player"] as Titan.Repository.Database.User;
    var kycRequest = ViewData["kycRequest"] as Titan.Repository.Database.KycRequestLog;


    string kycStatus;
    string kycStatusClass;
    string kycStatusDescription;


    switch (player?.KycStatus)
    {
        case 0:

            kycStatus = "Request";
            kycStatusClass = "pending";
            kycStatusDescription =
                "Your KYC request has been submitted and is waiting for verification.";

            break;


        case 1:

            kycStatus = "Verified";
            kycStatusClass = "verified";
            kycStatusDescription =
                "Your identity has been successfully verified.";

            break;


        case 2:

            kycStatus = "Rejected";
            kycStatusClass = "rejected";
            kycStatusDescription =
                "Your KYC request was rejected. Please review your information and submit again.";

            break;


        case 3:

            kycStatus = "Not Submitted";
            kycStatusClass = "not-submitted";
            kycStatusDescription =
                "You have not submitted a KYC verification request yet.";

            break;


        default:

            kycStatus = "Not Submitted";
            kycStatusClass = "not-submitted";
            kycStatusDescription =
                "You have not submitted a KYC verification request yet.";

            break;
    }

    /*
     * KYC EDIT PERMISSION
     *
     * Rejected (2)
     * NotSubmitted (3)
     *
     * User can submit/edit
     *
     * Request (0)
     * Verified (1)
     *
     * User cannot edit
     */

    var canEditKyc =
        player != null &&
        (player.KycStatus == 2 || player.KycStatus == 3);

}
