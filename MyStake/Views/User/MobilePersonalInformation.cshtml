/* =========================================================
   CHANGE PASSWORD MODAL
   ========================================================= */

.password-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    visibility: hidden;
    opacity: 0;

    transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
}

.password-modal.show {
    visibility: visible;
    opacity: 1;
}


/* Background */
.password-modal .password-modal-overlay {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100%;

    background: rgba(0, 0, 0, 0.76);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}


/* =========================================================
   MODAL BOX
   ========================================================= */

.password-modal .core-popup.app-change-password-popup {
    position: relative;

    z-index: 2;

    width: 100%;
    max-width: 440px;

    margin: 0;

    transform: translateY(20px) scale(0.97);
    opacity: 0;

    transition:
        transform 0.28s ease,
        opacity 0.28s ease;
}

.password-modal.show .core-popup.app-change-password-popup {
    transform: translateY(0) scale(1);
    opacity: 1;
}


/* Remove unwanted positioning from global popup styles */
.password-modal .overlay {
    position: relative;

    width: 100%;
    height: auto;

    margin: 0;
    padding: 0;

    background: transparent;
}


/* Actual white/dark modal container */
.password-modal .content {
    position: relative;

    width: 100%;

    padding: 28px;

    border-radius: 18px;

    background: #181a21;

    border: 1px solid rgba(255, 255, 255, 0.07);

    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.55),
        0 8px 30px rgba(0, 0, 0, 0.3);

    box-sizing: border-box;
}


/* =========================================================
   TITLE
   ========================================================= */

.password-modal .popup-title {
    display: flex;
    align-items: center;

    min-height: 28px;

    margin: 0 42px 24px 0;

    color: #ffffff;

    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
}


/* Close button */
.password-modal .close {
    position: absolute;

    top: 18px;
    right: 18px;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    border-radius: 10px;

    background: rgba(255, 255, 255, 0.05);

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.password-modal .close:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: scale(1.05);
}

.password-modal .close img {
    width: 16px;
    height: 16px;

    display: block;

    opacity: 0.75;
}


/* =========================================================
   FORM
   ========================================================= */

.password-modal .app-change-password {
    width: 100%;
}

.password-modal .app-change-password-form {
    width: 100%;
}

.password-modal form {
    width: 100%;
    margin: 0;
}


/* Input wrapper */
.password-modal .core-input {
    position: relative;

    width: 100%;

    margin-bottom: 16px;
}


/* Input */
.password-modal .core-input-helper {
    position: relative;

    width: 100%;
}

.password-modal input[type="password"] {
    width: 100%;
    height: 52px;

    display: block;

    padding: 0 16px;

    box-sizing: border-box;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 11px;

    outline: none;

    background: #101217;

    color: #ffffff;

    font-size: 14px;
    font-weight: 400;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.password-modal input[type="password"]::placeholder {
    color: rgba(255, 255, 255, 0.42);
}

.password-modal input[type="password"]:focus {
    border-color: #00aaeb;

    background: #12151b;

    box-shadow:
        0 0 0 3px rgba(0, 170, 235, 0.10);
}


/* Error input */
.password-modal .core-input.error input[type="password"],
.password-modal input.error-border {
    border-color: #ff4d5e;
}

.password-modal .core-input.error input[type="password"]:focus {
    box-shadow:
        0 0 0 3px rgba(255, 77, 94, 0.10);
}


/* =========================================================
   VALIDATION MESSAGES
   ========================================================= */

.password-modal .error {
    margin-top: 7px;
    padding: 0 2px;

    color: #ff5969;

    font-size: 12px;
    line-height: 1.4;
}


/* =========================================================
   CHANGE PASSWORD BUTTON
   ========================================================= */

.password-modal #change-password-button {
    width: 100%;
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-top: 8px;

    border-radius: 11px;

    background: linear-gradient(
        135deg,
        #00aaeb 0%,
        #008fd0 100%
    );

    color: #ffffff;

    cursor: pointer;

    transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.password-modal #change-password-button[style*="pointer-events: none"] {
    cursor: default;
}

.password-modal #change-password-button:not([style*="pointer-events: none"]):hover {
    transform: translateY(-1px);

    box-shadow:
        0 8px 24px rgba(0, 170, 235, 0.22);
}

.password-modal #change-password-button:active {
    transform: translateY(0);
}

.password-modal #change-password-button .button-content {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
}

.password-modal #change-password-button span {
    color: #ffffff;

    font-size: 14px;
    font-weight: 700;
}


/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 600px) {

    .password-modal {
        padding: 16px;
    }

    .password-modal .core-popup.app-change-password-popup {
        max-width: 100%;
    }

    .password-modal .content {
        padding: 24px 20px 22px;

        border-radius: 16px;
    }

    .password-modal .popup-title {
        margin-bottom: 20px;

        font-size: 18px;
    }

    .password-modal .close {
        top: 15px;
        right: 15px;

        width: 32px;
        height: 32px;
    }

    .password-modal input[type="password"] {
        height: 50px;
    }

    .password-modal #change-password-button {
        height: 50px;
    }
}


/* Very small phones */
@@media (max-width: 380px) {

    .password-modal {
        padding: 12px;
    }

    .password-modal .content {
        padding: 22px 16px 18px;

        border-radius: 15px;
    }

    .password-modal .popup-title {
        font-size: 17px;
    }

    .password-modal .core-input {
        margin-bottom: 14px;
    }
}

