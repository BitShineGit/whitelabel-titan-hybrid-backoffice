    <script>
        let socket = new WebSocket(`wss://${window.location.host}/ws`);

        socket.onopen = () => {
            socket.send(JSON.stringify({
                type: "register",
                userId: "@User.Identity.Name"
            }));

            console.log("Connected!");
        };

        socket.onmessage = (event) => {
            let payload;

            try {
                payload = JSON.parse(event.data);
            } catch {
                // Backward-compat fallback for any plain-text message.
                document.getElementById("balance").innerText = event.data;
                return;
            }

            switch (payload.type) {
                case "balance":
                    document.getElementById("balance").innerText = payload.message;
                    break;

                case "jackpotUpdated":
                    updateJackpots(payload.data);
                    break;

                default:
                    console.warn("Unhandled socket message type:", payload.type);
            }
        };

        socket.onclose = () => {
            console.log("Disconnected!");
        };
    </script>
</body>
