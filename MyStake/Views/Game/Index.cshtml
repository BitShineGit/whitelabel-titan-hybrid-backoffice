        .pc-country-dropdown-menu {
            position: absolute;
            right: 0;
            width: 140px;
            background: #383848;
            border-radius: 8px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(12px) scale(0.97);
            transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
            z-index: 100;
        }

        .pc-country-dropdown.active .pc-country-dropdown-menu {
            opacity: 1;
            visibility: visible;
