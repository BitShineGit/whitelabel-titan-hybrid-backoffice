                                                            onclick="viewmore('${message.id}')">

                                                        <div class="button-content">

                                                            <span data-group="NOTIFICATION"
                                                                  data-key="VIEW_MORE">
                                                                View More
                                                            </span>

                                                        </div>

                                                    </button>

                                                </div>

                                            </div>

                                        </div>
                                    `;
                }</script>
            <script>

                $.ajax({
                    url: "/Home/GetNotifications",
                    method: "POST",
                    data: {},
                    success: function (res) {

                        if (res.success) {

                            var deletedNotifications =
                                getDeletedNotifications().map(String);

                            var notification = "";
                            var visibleCount = 0;

                            for (var i = 0; i < res.messages.length; i++) {

                                var message = res.messages[i];
                                var messageId = String(message.id);

                                // Never display locally deleted notifications.
                                if (deletedNotifications.includes(messageId)) {
                                    continue;
                                }

                                // Build notification.
                                notification += buildNotificationHtml(message);

                                visibleCount++;
                            }

                            $("#notification-box").html(notification);

                            if (visibleCount === 0) {

                                $("#notification-count-box")
                                    .css("display", "none");

                            } else {

                                $("#notification-count-box")
                                    .css("display", "")
                                    .html(visibleCount);
                            }
                        }
                    }
                });</script>
        }
    }
    <script>
        var showingUnreadOnly = false;

        function GetUnreadMessages() {

            // Toggle the filter state
            showingUnreadOnly = !showingUnreadOnly;

            $.ajax({
                url: "/Home/GetUnreadMessages",
                method: "POST",
                data: {},
                success: function (res) {

                    if (res.success) {

                        var viewedNotifications =
                            getViewedNotifications().map(String);

                        var deletedNotifications =
                            getDeletedNotifications().map(String);

                        var notification = "";
                        var visibleCount = 0;

                        for (var i = 0; i < res.messages.length; i++) {

                            var message = res.messages[i];
                            var messageId = String(message.id);

                            // Never show locally deleted notifications
                            if (deletedNotifications.includes(messageId)) {
                                continue;
                            }

                            // When Unread filter is active,
                            // hide notifications that have already been viewed.
                            if (
                                showingUnreadOnly &&
                                viewedNotifications.includes(messageId)
                            ) {
                                continue;
                            }

                            // Show notification
                            notification += buildNotificationHtml(message);

                            visibleCount++;
                        }

                        $("#notification-box").html(notification);

                        if (visibleCount === 0) {

                            $("#notification-count-box")
                                .css("display", "none");

                        } else {

                            $("#notification-count-box")
                                .css("display", "")
                                .html(visibleCount);
                        }
                    }
                }
            });
        }
    </script>
