<!-- =============================================================
     LIBRARIES
============================================================= -->

<script src="~/assets/plugins/datatables/dataTables.min.js"></script>
<script src="~/assets/plugins/datatables/dataTables.bootstrap5.min.js"></script>
<script src="~/assets/plugins/datatables/dataTables.responsive.min.js"></script>
<script src="~/assets/plugins/datatables/responsive.bootstrap5.min.js"></script>

<script src="~/assets/plugins/sweetalert2/sweetalert2.min.js"></script>

<script src="~/assets/plugins/select2/js/select2.min.js"></script>
<script src="~/assets/plugins/moment/moment.min.js"></script>
<script src="~/assets/plugins/daterangepicker/daterangepicker.js"></script>


<script>
    $(document).ready(function () {

        if (
            !window.jQuery ||
            !$.fn.DataTable ||
            !$("#financeLogsTable").length
        ) {
            return;
        }


        /* =========================================================
           HTML ESCAPE
        ========================================================= */

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {
                return "";
            }

            return $("<div>")
                .text(String(value))
                .html();
        }



        /* =========================================================
           MONEY
        ========================================================= */

        function formatMoney(value) {

            var number =
                Number(value);

            return Number.isFinite(number)
                ? number.toFixed(2)
                : "0.00";
        }



        /* =========================================================
           FINANCE TYPE
        ========================================================= */

        function getFinanceTypeName(value) {

            switch (Number(value)) {

                case 0:
                    return "Self Deposit";

                case 1:
                    return "Manual Deposit";

                case 2:
                    return "Self Withdraw";

                case 3:
                    return "Manual Withdraw";

                default:
                    return "Unknown";
            }
        }



        /* =========================================================
           TARGET ACCOUNT
        ========================================================= */

        function getTargetAccountTypeName(value) {

            switch (Number(value)) {

                case 0:
                    return "Player";

                case 1:
                    return "Agent";

                default:
                    return "Unknown";
            }
        }



        /* =========================================================
           STATUS
        ========================================================= */

        function getStatusName(value) {

            switch (Number(value)) {

                case 0:
                    return "Pending";

                case 1:
                    return "Processing";

                case 2:
                    return "Completed";

                case 3:
                    return "Rejected";

                case 4:
                    return "Failed";

                case 5:
                    return "Cancelled";

                case 6:
                    return "Auto Cancelled";

                default:
                    return "Unknown";
            }
        }



        /* =========================================================
           BALANCE
        ========================================================= */

        function getFinanceBalanceText(beforeValue, afterValue) {
            var before = Number(beforeValue || 0);
            var after = Number(afterValue || 0);

            if (before === after) {
                return formatMoney(before);
            }

            return formatMoney(before) + " → " + formatMoney(after);
        }



        function renderFinanceBalance(beforeValue, afterValue) {
            var before = Number(beforeValue);
            var after = Number(afterValue);

            if (!Number.isFinite(before)) before = 0;
            if (!Number.isFinite(after)) after = 0;

            if (before === after) {
                return formatMoney(before);
            }

            var afterClass = after > before
                ? "text-success"
                : after < before
                    ? "text-danger"
                    : "";

            return (
                '<span class="text-nowrap">' +
                formatMoney(before) +
                ' <span class="text-muted mx-1">→</span> ' +
                '<span class="' + afterClass + '">' +
                formatMoney(after) +
                '</span></span>'
            );
        }



        function renderFinanceType(value) {
            var financeType = Number(value);
            var financeTypeName = getFinanceTypeName(financeType);
            var badgeClass = "status-unknown";

            switch (financeType) {
                case 0:
                    badgeClass = "finance-type-self-deposit";
                    break;

                case 1:
                    badgeClass = "finance-type-manual-deposit";
                    break;

                case 2:
                    badgeClass = "finance-type-self-withdraw";
                    break;

                case 3:
                    badgeClass = "finance-type-manual-withdraw";
                    break;
            }

            return '<span class="status-badge ' + badgeClass + '">' +
                escapeHtml(financeTypeName) +
                '</span>';
        }



        function renderStatus(value) {
            var status = Number(value);
            var statusName = getStatusName(status);
            var badgeClass = "status-unknown";

            switch (status) {
                case 0:
                    badgeClass = "status-pending"; // Pending
                    break;

                case 1:
                    badgeClass = "status-processing"; // Processing
                    break;

                case 2:
                    badgeClass = "status-completed"; // Completed
                    break;

                case 3:
                    badgeClass = "status-rejected"; // Rejected
                    break;

                case 4:
                    badgeClass = "status-failed"; // Failed
                    break;

                case 5:
                    badgeClass = "status-cancelled"; // Cancelled
                    break;

                case 6:
                    badgeClass = "status-auto-cancelled"; // Auto Cancelled
                    break;
            }

            return '<span class="status-badge ' + badgeClass + '">' +
                escapeHtml(statusName) +
                '</span>';
        }


        /* =========================================================
           SELECT2
        ========================================================= */

        if ($.fn.select2) {

            $("#filterExecTypes")
                .select2({
                    width: "100%"
                });


            $("#filterStatus")
                .select2({
                    width: "100%"
                });

        }



        /* =========================================================
           DATE RANGE
        ========================================================= */

        var defaultStart =
            moment()
                .subtract(1, "month");


        var defaultEnd =
            moment();



        function updateDateRange(start, end) {
            $("#dateRange").val(
                start.format("YYYY-MM-DD HH:mm:ss") +
                " - " +
                end.format("YYYY-MM-DD HH:mm:ss")
            );

            $("#selectedValue").text(
                start.format("M D, YYYY HH:mm:ss") +
                " - " +
                end.format("M D, YYYY HH:mm:ss")
            );
        }


        if ($.fn.daterangepicker) {

            $("#reportrange")
                .daterangepicker({

                    startDate:
                        defaultStart,

                    endDate:
                        defaultEnd,

                    autoUpdateInput: false,

                    opens: "left",

                    drops: "down",

                    timePicker: true,

                    timePicker24Hour: true,

                    timePickerSeconds: true,

                    locale: {
                        format:
                            "MMMM D, YYYY HH:mm:ss",

                        cancelLabel: "Cancel",

                        applyLabel: "Apply"
                    }

                });


            updateDateRange(
                defaultStart,
                defaultEnd
            );


            $("#reportrange")
                .on(
                    "apply.daterangepicker.finance",
                    function (
                        event,
                        picker
                    ) {
                        $("#selectedValue").text(

                            picker.startDate.format(
                                "MMMM D, YYYY HH:mm:ss"
                            )

                            +

                            " - "

                            +

                            picker.endDate.format(
                                "MMMM D, YYYY HH:mm:ss"
                            )

                        );
                        updateDateRange(
                            picker.startDate,
                            picker.endDate
                        );

                    }
                );

        }
        /* =========================================================
    DATATABLE
    ========================================================= */

        var table =
            $("#financeLogsTable")
                .DataTable({

                    processing: true,

                    serverSide: true,

                    responsive: true,

                    autoWidth: false,

                    searching: false,

                    deferRender: true,

                    pageLength: 25,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    dom: "lrtip",

                    order: [
                        [8, "desc"]
                    ],


                    columnDefs: [
                        {
                            responsivePriority: 1,
                            targets: 0
                        },
                        {
                            responsivePriority: 2,
                            targets: 11
                        },
                        {
                            responsivePriority: 3,
                            targets: 10
                        },
                        {
                            responsivePriority: 4,
                            targets: 9
                        },
                        {
                            responsivePriority: 5,
                            targets: [5, 6, 7, 8]
                        },
                        {
                            responsivePriority: 6,
                            targets: [2, 3, 4]
                        },
                        {
                            responsivePriority: 7,
                            targets: 1
                        },
                        {
                            orderable: false,
                            targets: [0, 2, 10, 11]
                        }
                    ],



                    ajax: {

                        url:
                            "@Url.Action("GetFinanceLogs", "Dashboard")",

                        type: "POST",


                        data: function (d) {


                            d.__RequestVerificationToken =
                                $("input[name='__RequestVerificationToken']")
                                    .val();



                            d.agentCode =
                                $("#filterAgent")
                                    .val();



                            d.targetCode =
                                $("#filterTarget")
                                    .val();



                            d.financeType =
                                $("#filterExecTypes")
                                    .val();



                            d.amount =
                                $("#filterAmount")
                                    .val();



                            d.orderId =
                                $("#filterOrderId")
                                    .val();



                            d.status =
                                $("#filterStatus")
                                    .val();

                            d.userNickname = 
                                $("#filterUserNickname")
                                    .val();

                            var range =
                                $("#dateRange")
                                    .val();



                            if (range) {

                                var dates =
                                    range.split(" - ");


                                if (dates.length === 2) {

                                    d.fromDate =
                                        dates[0];

                                    d.toDate =
                                        dates[1];

                                }

                            }

                        }

                    },



                    columns: [


                        /* 0 No */

                        {
                            data: null,

                            orderable: false,

                            searchable: false,

                            className:
                                "text-center text-muted",

                            render: function (
                                data,
                                type,
                                row,
                                meta
                            ) {

                                return (
                                    meta.row +
                                    meta.settings._iDisplayStart +
                                    1
                                );

                            }

                        },



                        /* 1 Order Id */

                        {
                            data: "orderId",

                            defaultContent: "",

                            render: function (data) {

                                return escapeHtml(data);

                            }

                        },

                        {
                            data: "userNickname",
                            orderable: false,
                            defaultContent: ""
                        },

                        /* 2 Target */

                        {
                            data: "targetCode",

                            defaultContent: "",

                            render: function (data) {

                                return escapeHtml(data);

                            }

                        },



                        /* 3 Agent */

                        {
                            data: "agentCode",

                            defaultContent: "",

                            render: function (data) {

                                return escapeHtml(data);

                            }

                        },



                        /* 4 Finance Type */

                        {
                            data: "financeType",

                            render: function (data) {

                                return renderFinanceType(data);

                            }

                        },



                        /* 5 Amount */

                        {
                            data: "amount",

                            className:
                                "text-end text-nowrap",

                            render: function (data) {

                                return formatMoney(data);

                            }

                        },



                        /* 6 Balance */

                        {
                            data: null,

                            orderable: false,

                            className:
                                "text-end",

                            render: function (
                                data,
                                type,
                                row
                            ) {

                                return renderFinanceBalance(

                                    row.targetBeforeBalance,

                                    row.targetAfterBalance

                                );

                            }

                        },



                        /* 7 Date */

                        {
                            data: "createdAt",

                            render: function (data) {

                                return escapeHtml(data);

                            }

                        },



                        /* 8 Status */

                        {
                            data: "status",

                            render: function (data) {

                                return renderStatus(data);

                            }

                        },



                        /* 9 Details */

                        {
                            data: null,

                            orderable: false,

                            searchable: false,

                            className:
                                "text-center",

                            render: function (data) {

                                return (

                                    '<button type="button" ' +

                                    'class="btn btn-sm btn-light js-finance-details" ' +

                                    'data-log-id="' +

                                    escapeHtml(data.id)

                                    +

                                    '">' +

                                    '<i class="ti ti-eye"></i>' +

                                    '</button>'

                                );

                            }

                        },



                        /* =================================================
                           10 Actions

                           Flow:

                           Pending(0)
                               Approve
                               Reject

                           Processing(1)
                               Complete
                               Reject

                           Completed/Rejected/Failed
                               No actions

                        ================================================= */

                        {
                            data: null,

                            orderable: false,

                            searchable: false,

                            className:
                                "text-center",


                            render: function (data) {


                                if (!data) {

                                    return "";

                                }



                                var isSelfWithdraw =

                                    Number(data.financeType) === 2

                                    &&

                                    Number(data.targetAccountType) === 0;



                                if (!isSelfWithdraw) {

                                    return (

                                        '<span class="text-muted small">' +

                                        'No actions' +

                                        '</span>'

                                    );

                                }



                                var buttons = "";

                                var status =
                                    Number(data.status);



                                /*
                                    Pending
                                    0
                                */

                                if (status === 0) {


                                    buttons +=

                                        '<button type="button" ' +

                                        'class="btn btn-sm btn-success js-finance-action" ' +

                                        'data-action="approve" ' +

                                        'data-log-id="' +

                                        escapeHtml(data.id)

                                        +

                                        '">' +

                                        '<i class="ti ti-check me-1"></i>' +

                                        'Approve' +

                                        '</button>';



                                    buttons +=

                                        '<button type="button" ' +

                                        'class="btn btn-sm btn-danger js-finance-action" ' +

                                        'data-action="reject" ' +

                                        'data-log-id="' +

                                        escapeHtml(data.id)

                                        +

                                        '">' +

                                        '<i class="ti ti-x me-1"></i>' +

                                        'Reject' +

                                        '</button>';

                                }




                                /*
                                    Processing
                                    1
                                */

                                if (status === 1) {


                                    buttons +=

                                        '<button type="button" ' +

                                        'class="btn btn-sm btn-warning js-finance-action" ' +

                                        'data-action="complete" ' +

                                        'data-log-id="' +

                                        escapeHtml(data.id)

                                        +

                                        '">' +

                                        '<i class="ti ti-check me-1"></i>' +

                                        'Send Money' +

                                        '</button>';



                                    buttons +=

                                        '<button type="button" ' +

                                        'class="btn btn-sm btn-danger js-finance-action" ' +

                                        'data-action="reject" ' +

                                        'data-log-id="' +

                                        escapeHtml(data.id)

                                        +

                                        '">' +

                                        '<i class="ti ti-x me-1"></i>' +

                                        'Reject' +

                                        '</button>';

                                }



                                if (!buttons) {

                                    return (

                                        '<span class="text-muted small">' +

                                        'No actions' +

                                        '</span>'

                                    );

                                }



                                return (

                                    '<div class="d-inline-flex gap-1">' +

                                    buttons +

                                    '</div>'

                                );


                            }

                        }


                    ]

                });
        /* =========================================================
    SEARCH
    ========================================================= */

        $("#financeFilterForm")
            .on(
                "submit",
                function (e) {

                    e.preventDefault();


                    table.ajax.reload(
                        null,
                        true
                    );

                }
            );



        $(
            "#filterAgent," +
            "#filterTarget," +
            "#filterAmount," +
            "#filterOrderId"
        )
            .on(
                "keydown",
                function (e) {

                    if (e.key === "Enter") {

                        e.preventDefault();


                        $("#financeFilterForm")
                            .trigger("submit");

                    }

                }
            );



        /* =========================================================
           CLEAR FILTERS
        ========================================================= */

        $("#clearFiltersBtn")
            .on(
                "click",
                function () {


                    $(
                        "#filterAgent," +
                        "#filterTarget," +
                        "#filterAmount," +
                        "#filterOrderId"
                    )
                        .val("");



                    $(
                        "#filterExecTypes," +
                        "#filterStatus"
                    )
                        .val("")
                        .trigger("change");



                    var start =
                        moment()
                            .subtract(
                                1,
                                "month"
                            );


                    var end =
                        moment();



                    var picker =
                        $("#reportrange")
                            .data(
                                "daterangepicker"
                            );


                    if (picker) {
                        $("#selectedValue").text(

                            defaultStart.format(
                                "MMMM D, YYYY HH:mm:ss"
                            )

                            +

                            " - "

                            +

                            defaultEnd.format(
                                "MMMM D, YYYY HH:mm:ss"
                            )

                        );

                        picker.setStartDate(start);

                        picker.setEndDate(end);

                    }



                    updateDateRange(
                        start,
                        end
                    );



                    table.ajax.reload(
                        null,
                        true
                    );


                }
            );





        /* =========================================================
           FIND CURRENT ROW
        ========================================================= */

        function getSelectedRow(id) {

            var rows =
                table.rows()
                    .data();



            for (
                var i = 0;
                i < rows.length;
                i++
            ) {

                if (
                    Number(rows[i].id)
                    ===
                    Number(id)
                ) {

                    return rows[i];

                }

            }


            return null;

        }





        /* =========================================================
           APPROVE / COMPLETE / REJECT
        ========================================================= */

        $(document)
            .on(
                "click",
                ".js-finance-action",
                function () {


                    var button =
                        $(this);



                    var action =
                        String(
                            button.data("action")
                        );



                    var id =
                        Number(
                            button.data("log-id")
                        );



                    if (!Number.isFinite(id)) {

                        return;

                    }

                    var selected =
                        getSelectedRow(id);


                    if (!selected) {

                        return;

                    }

                    var title = "";

                    var message = "";

                    var endpoint = "";



                    /*
                        Pending
                        0 -> 1
                    */

                    if (action === "approve") {


                        title =
                            "Approve Withdrawal?";


                        message =
                            "Withdrawal will move to Processing status.";


                        endpoint =
                            "@Url.Action("ApproveWithdraw", "Dashboard")";


                    }



                    /*
                        Processing
                        1 -> 2
                    */
                    else if (action === "complete") {


                        title =
                            "Complete Withdrawal?";


                        message =
                            "Wallet Address:\n" +
                            (selected.walletAddress || "-") +
                            "\n\nNetwork: " +
                            (selected.network || "-") +
                            "\nCurrency: " +
                            (selected.currency || "-") +
                            "\n\nPayment will be completed and balances will update.";


                        endpoint =
                            "@Url.Action("CompleteWithdraw", "Dashboard")";


                    }


                    /*
                        Pending/Processing
                        -> Rejected
                    */

                    else if (action === "reject") {


                        title =
                            "Reject Withdrawal?";


                        message =
                            "This withdrawal will be rejected.";


                        endpoint =
                            "@Url.Action("RejectFinanceLog", "Dashboard")";


                    }



                    else {

                        return;

                    }





                    Swal.fire({

                        title: title,

                        text: message,

                        icon: "warning",

                        showCancelButton: true,

                        confirmButtonText: "Confirm",

                        cancelButtonText: "Cancel"


                    })
                        .then(function (result) {


                            if (!result.isConfirmed) {

                                return;

                            }




                            $.ajax({

                                url: endpoint,

                                type: "POST",


                                data: {

                                    __RequestVerificationToken:
                                        $("input[name='__RequestVerificationToken']")
                                            .val(),


                                    id: id

                                },


                                success: function (res) {


                                    if (
                                        res
                                        &&
                                        res.success
                                    ) {


                                        Swal.fire({

                                            title: "Success",

                                            text:
                                                res.message
                                                ||
                                                "Operation completed.",

                                            icon: "success",

                                            timer: 1800,

                                            showConfirmButton: false

                                        });



                                        table.ajax.reload(
                                            null,
                                            false
                                        );


                                    }
                                    else {


                                        showFinanceError(
                                            res.message
                                            ||
                                            "Operation failed."
                                        );

                                    }


                                },


                                error: function (xhr) {


                                    showFinanceError(

                                        xhr.responseJSON?.message

                                        ||

                                        "Unexpected error."

                                    );


                                }


                            });



                        });



                }
            );





        /* =========================================================
           ERROR
        ========================================================= */

        function showFinanceError(message) {


            Swal.fire({

                title:
                    "Operation Failed",

                text:
                    message,

                icon:
                    "error"

            });


        }







        /* =========================================================
           DETAILS MODAL
        ========================================================= */

        $(document)
            .on(
                "click",
                ".js-finance-details",
                function () {


                    var id =
                        Number(
                            $(this)
                                .data("log-id")
                        );



                    var selected =
                        getSelectedRow(id);



                    if (!selected) {

                        return;

                    }



                    $("#detailId")
                        .text(selected.id);



                    $("#detailOrderId")
                        .text(
                            selected.orderId || ""
                        );



                    $("#detailAgentCode")
                        .text(
                            selected.agentCode || ""
                        );



                    $("#detailTargetCode")
                        .text(
                            selected.targetCode || ""
                        );



                    $("#detailFinanceType")
                        .text(
                            getFinanceTypeName(
                                selected.financeType
                            )
                        );



                    $("#detailTargetAccountType")
                        .text(
                            getTargetAccountTypeName(
                                selected.targetAccountType
                            )
                        );



                    $("#detailAmount")
                        .text(
                            formatMoney(
                                selected.amount
                            )
                        );



                    $("#detailStatus")
                        .text(
                            getStatusName(
                                selected.status
                            )
                        );



                    $("#detailTargetBalance")
                        .text(
                            getFinanceBalanceText(

                                selected.targetBeforeBalance,

                                selected.targetAfterBalance

                            )
                        );



                    $("#detailAgentBalance")
                        .text(
                            getFinanceBalanceText(

                                selected.agentBeforeBalance,

                                selected.agentAfterBalance

                            )
                        );



                    $("#detailCreatedAt")
                        .text(
                            selected.createdAt || ""
                        );


                    var modal =
                        document.getElementById(
                            "financeLogDetailsModal"
                        );



                    if (
                        modal
                        &&
                        typeof bootstrap !== "undefined"
                        &&
                        bootstrap.Modal
                    ) {

                        bootstrap.Modal
                            .getOrCreateInstance(modal)
                            .show();

                    }



                }
            );






        /* =========================================================
           RESIZE
        ========================================================= */

        $(window)
            .on(
                "resize",
                function () {


                    table.columns.adjust();



                    if (
                        table.responsive
                        &&
                        typeof table.responsive.recalc === "function"
                    ) {

                        table.responsive.recalc();

                    }


                }
            );



    });
</script>