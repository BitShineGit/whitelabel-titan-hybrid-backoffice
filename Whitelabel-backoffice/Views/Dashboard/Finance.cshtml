@{
    ViewData["Title"] = "Finance Logs";
}

<link rel="stylesheet" href="~/assets/plugins/datatables/responsive.bootstrap5.min.css" />
<link rel="stylesheet" href="~/assets/plugins/select2/css/select2.min.css" />
<link rel="stylesheet" href="~/assets/plugins/daterangepicker/daterangepicker.css" />
<link rel="stylesheet" href="~/assets/plugins/sweetalert2/sweetalert2.min.css" />
<link id="app-style" href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
<style>
    /* Finance Type Badges */
    .finance-type-self-deposit {
        background-color: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .finance-type-manual-deposit {
        background-color: rgba(13, 202, 240, 0.15);
        color: #0dcaf0;
    }

    .finance-type-manual-withdraw {
        background-color: rgba(255, 193, 7, 0.15);
        color: #ffc107;
    }

    .finance-type-self-withdraw {
        background-color: rgba(220, 53, 69, 0.12);
        color: #dc3545;
    }
    .dt-length {
        margin-top: 20px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.65rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 500;
        white-space: nowrap;
    }

    /* 0 - Pending */
    .status-pending {
        background-color: rgba(255, 193, 7, 0.15);
        color: #ffc107;
    }

    /* 1 - Processing */
    .status-processing {
        background-color: rgba(13, 202, 240, 0.15);
        color: #0dcaf0;
    }

    /* 2 - Completed */
    .status-completed {
        background-color: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    /* 3 - Rejected */
    .status-rejected {
        background-color: rgba(220, 53, 69, 0.12);
        color: #dc3545;
    }

    /* 4 - Failed */
    .status-failed {
        background-color: rgba(239, 68, 68, 0.15);
        color: #60a5fa;
    }

    /* 5 - Cancelled */
    .status-cancelled {
        background-color: rgba(248, 113, 113, 0.15);
        color: #f87171;
    }

    /* 6 - Auto Cancelled */
    .status-auto-cancelled {
        background-color: rgba(236, 72, 153, 0.15);
        color: #f472b6;
    }

    /* Unknown status */
    .status-unknown {
        background-color: rgba(156, 163, 175, 0.12);
        color: #9ca3af;
    }
</style>
<div class="page-title-head d-flex align-items-center">

    <div class="flex-grow-1 ms-3">

        <h4 class="page-main-title m-0">
            Finance Logs
        </h4>

    </div>

    <div class="text-end">

        <ol class="breadcrumb m-0 py-0">

            <li class="breadcrumb-item">
                <a href="~/account/index">
                    TITANBET
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="javascript:void(0);">
                    Dashboard
                </a>
            </li>

            <li class="breadcrumb-item active">
                Finance Logs
            </li>

        </ol>

    </div>

</div>


<div class="container-fluid">


    <!-- =========================================================
         FILTER CARD
    ========================================================= -->

    <div class="card">

        <div class="card-body">

            @Html.AntiForgeryToken()


            <form id="financeFilterForm">

                <div class="row g-3">


                    <!-- ORDER ID -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterOrderId"
                               class="form-label">

                            Order ID

                        </label>


                        <div class="app-search">

                            <input type="search"
                                   class="form-control"
                                   id="filterOrderId"
                                   placeholder="Search Order ID..."
                                   autocomplete="off">


                            <i class="ti ti-hash app-search-icon text-muted"></i>

                        </div>

                    </div>


                    <!-- TARGET CODE -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterTarget"
                               class="form-label">

                            Target Code

                        </label>


                        <div class="app-search">

                            <input type="search"
                                   class="form-control"
                                   id="filterTarget"
                                   placeholder="Search user code..."
                                   autocomplete="off">


                            <i class="ti ti-user-circle app-search-icon text-muted"></i>

                        </div>

                    </div>


                    <!-- AGENT CODE -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterAgent"
                               class="form-label">

                            Agent Code

                        </label>


                        <div class="app-search">

                            <input type="search"
                                   class="form-control"
                                   id="filterAgent"
                                   placeholder="Search agent code..."
                                   autocomplete="off">


                            <i class="ti ti-user app-search-icon text-muted"></i>

                        </div>

                    </div>


                    <!-- FINANCE TYPE -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterExecTypes"
                               class="form-label">

                            Finance Types

                        </label>


                        <select id="filterExecTypes"
                                class="form-select">

                            <option value="">
                                All Finance Types
                            </option>

                            <option value="0">
                                Self Deposit
                            </option>

                            <option value="1">
                                Manual Deposit
                            </option>

                            <option value="2">
                                Self Withdraw
                            </option>

                            <option value="3">
                                Manual Withdraw
                            </option>

                        </select>

                    </div>


                    <!-- AMOUNT -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterAmount"
                               class="form-label">

                            Amount

                        </label>


                        <div class="app-search">

                            <input type="number"
                                   class="form-control"
                                   id="filterAmount"
                                   placeholder="Search amount..."
                                   autocomplete="off"
                                   min="0"
                                   step="0.01"
                                   inputmode="decimal">


                            <i class="ti ti-currency-dollar app-search-icon text-muted"></i>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterStatus"
                               class="form-label">

                            Status

                        </label>


                        <select id="filterStatus"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            <option value="0">
                                Pending
                            </option>

                            <option value="2">
                                Completed
                            </option>

                            <option value="3">
                                Rejected
                            </option>

                            <option value="4">
                                Failed
                            </option>

                            <option value="5">
                                Cancelled
                            </option>

                            <option value="6">
                                Auto Cancelled
                            </option>
                        </select>

                    </div>


                    <!-- DATE RANGE -->

                    <div class="col-xl-3 col-md-6">

                        <label class="form-label">
                            Date Range
                        </label>


                        <div class="position-relative">

                            <div id="reportrange"
                                 class="form-control"
                                 data-toggle="date-picker-range"
                                 data-target-display="#selectedValue"
                                 data-cancel-class="btn-light">

                                <i class="ti ti-calendar me-2"></i>

                                <span id="selectedValue">
                                </span>

                                <i class="ti ti-chevron-down position-absolute end-0 top-50 translate-middle me-1"></i>

                            </div>

                        </div>


                        <input type="hidden"
                               id="dateRange"
                               value="" />

                    </div>


                    <!-- AGENT CODE -->

                    <div class="col-xl-3 col-md-6">

                        <label for="filterUserNickname"
                               class="form-label">

                            User Nickname

                        </label>


                        <div class="app-search">

                            <input type="search"
                                   class="form-control"
                                   id="filterUserNickname"
                                   placeholder="Search user nicknname..."
                                   autocomplete="off">


                            <i class="ti ti-user app-search-icon text-muted"></i>

                        </div>

                    </div>


                    <!-- SEARCH / CLEAR -->

                    <div class="col-xl-3 col-md-6 d-flex align-items-end">

                        <div class="d-flex gap-2 w-100">

                            <button class="btn btn-primary flex-fill"
                                    type="submit"
                                    id="applyFiltersBtn">

                                <i class="ti ti-search me-2"></i>

                                Search

                            </button>


                            <button class="btn btn-light flex-fill"
                                    type="button"
                                    id="clearFiltersBtn">

                                <i class="ti ti-refresh me-2"></i>

                                Clear

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         FINANCE TABLE
    ========================================================= -->

    <div class="card">

        <div class="card-header">

            <h5 class="card-title mb-1">
                Finance Logs
            </h5>

            <small class="text-muted">
                Finance transactions within your agent hierarchy
            </small>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="financeLogsTable"
                       class="table table-hover table-striped align-middle w-100">

                    <thead>

                        <tr>

                            <th class="text-center">
                                No
                            </th>

                            <th>
                                Order Id
                            </th>
                            <th>User Nickname</th>

                            <th>
                                Target Code
                            </th>

                            <th>
                                Agent Code
                            </th>

                            <th>
                                Finance Type
                            </th>

                            <th class="text-end">
                                Amount
                            </th>

                            <th class="text-end">
                                Balance
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Details
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>


            <div class="row mt-2">

                <div class="col-md-4">

                    <div id="dataTableLengthContainer"
                         class="d-flex align-items-center h-100">
                    </div>

                </div>


                <div class="col-md-4">

                    <div id="dataTableInfoContainer"
                         class="d-flex align-items-center justify-content-center h-100">
                    </div>

                </div>


                <div class="col-md-4">

                    <div id="dataTablePagingContainer"
                         class="d-flex align-items-center justify-content-md-end justify-content-center h-100">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     DETAILS MODAL
============================================================= -->

