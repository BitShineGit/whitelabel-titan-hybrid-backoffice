                        .val("")
                        .trigger(
                            "change"
                        );


                    var start =
                        moment().subtract(
                            1,
                            "month"
                        );


                    var end =
                        moment();


                    var picker =
                        $("#reportrange")
                            .data(
                                "daterangepicker"
                            );


                    if (picker) {

                        picker.setStartDate(
                            start
                        );

                        picker.setEndDate(
                            end
                        );


                        $("#selectedValue")
                            .text(

                                start.format(
                                    "MMMM D, YYYY HH:mm:ss"
                                )

                                +

                                " - "

                                +

