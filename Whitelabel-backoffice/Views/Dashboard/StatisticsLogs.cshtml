                    e
                ) {

                    e.preventDefault();


                    /*
                     * Current page becomes a fresh
                     * statistics view after filtering.
                     */

                    table.ajax.reload(
                        null,
                        true
                    );


                    /*
                     * Existing player data is no longer
                     * guaranteed to match the new filters.
                     */

                    if (
                        directPlayersTable
                    ) {

                        directPlayersTable
                            .clear()
                            .draw();

                    }


                    directPlayersLoaded =
                        false;


                    if (
                        directPlayersVisible
                    ) {

                        $("#directPlayersCard")
                            .hide();

                        directPlayersVisible =
                            false;

                    }


                    $("#toggleDirectPlayersBtn")
