                                    .columns
                                    .adjust();

                            }


                            var card =
                                document.getElementById(
                                    "directPlayersCard"
                                );


                            if (card) {

                                card.scrollIntoView({
                                    behavior:
                                        "smooth",

                                    block:
                                        "start"
                                });

                            }

                        },
                        180
                    );

                }
            );


    });

</script>