@{
    ViewData["Title"] = "KYC Verification";
}




<!-- ============================================================= -->
<!-- DATATABLES -->
<!-- ============================================================= -->

<script src="~/assets/plugins/datatables/dataTables.min.js"></script>
<script src="~/assets/plugins/datatables/dataTables.bootstrap5.min.js"></script>
<script src="~/assets/plugins/datatables/dataTables.responsive.min.js"></script>
<script src="~/assets/plugins/datatables/responsive.bootstrap5.min.js"></script>


<!-- ============================================================= -->
<!-- SELECT2 -->
<!-- ============================================================= -->

<script src="~/assets/plugins/select2/js/select2.min.js"></script>

<link href="~/assets/plugins/select2/css/select2.min.css"
      rel="stylesheet" />



<!-- ============================================================= -->
<!-- MOMENT / DATE RANGE PICKER -->
<!-- ============================================================= -->

<script src="~/assets/plugins/moment/moment.min.js"></script>

<script src="~/assets/plugins/daterangepicker/daterangepicker.js"></script>


<link href="~/assets/plugins/datatables/responsive.bootstrap5.min.css"
      rel="stylesheet" />

<link href="~/assets/plugins/daterangepicker/daterangepicker.css"
      rel="stylesheet" />


<link id="app-style"
      href="/assets/css/app.min.css"
      rel="stylesheet" />



<!-- ============================================================= -->
<!-- PAGE TITLE -->
<!-- ============================================================= -->


<div class="page-title-head d-flex align-items-center">


    <div class="flex-grow-1"
         style="margin-left:15px;">


        <h4 class="page-main-title m-0">

            KYC Verification

        </h4>


    </div>



    <div class="text-end">


        <ol class="breadcrumb m-0 py-0">


            <li class="breadcrumb-item">

                <a href="~/dashboard/index">

                    MyStake

                </a>

            </li>


            <li class="breadcrumb-item">

                Dashboard

            </li>


            <li class="breadcrumb-item active">

                KYC Verification

            </li>


        </ol>


    </div>


</div>




<div class="container-fluid">



    <!-- ============================================================= -->
    <!-- FILTER CARD -->
    <!-- ============================================================= -->


    <div class="card mb-3">


        <div class="card-header">


            <div>


                <h4 class="card-title mb-1">

                    Search KYC Requests

                </h4>


                <p class="text-muted mb-0">

                    Search and filter KYC request logs by user, status and request time.

                </p>


            </div>


        </div>



        <div class="card-body">


            <form id="kycFilterForm">


                <div class="row g-3">



                    <!-- USER ID -->

                    <div class="col-xl-3 col-md-6">


                        <label class="form-label">

                            User ID

                        </label>


                        <div class="app-search">


                            <input type="number"
                                   class="form-control"
                                   id="filterUserId"
                                   placeholder="Search user ID..."
                                   autocomplete="off" />


                            <i class="ti ti-user-circle app-search-icon text-muted"></i>


                        </div>


                    </div>





                    <!-- STATUS -->


                    <div class="col-xl-3 col-md-6">


                        <label class="form-label">

                            Status

                        </label>


                        <select id="filterStatus"
                                class="form-select">


                            <option value="">

                                All Statuses

                            </option>


                            <option value="0">

                                Pending

                            </option>


                            <option value="1">

                                Verified

                            </option>


                            <option value="2">

                                Rejected

                            </option>


                            <option value="3">

                                Not Submitted

                            </option>


                        </select>


                    </div>





                    <!-- DATE RANGE -->


                    <div class="col-xl-3 col-md-6">


                        <label class="form-label">

                            Request Time

                        </label>


                        <div class="position-relative">


                            <div id="reportrange"
                                 class="form-control">


                                <i class="ti ti-calendar me-2"></i>


                                <span id="selectedValue"></span>


                                <i class="ti ti-chevron-down position-absolute end-0 top-50 translate-middle me-1"></i>


                            </div>


                        </div>


                        <input type="hidden"
                               id="dateRange" />


                    </div>





                    <!-- BUTTONS -->


                    <div class="col-xl-3 col-md-6 d-flex align-items-end">


                        <div class="d-flex gap-2 w-100">


                            <button type="submit"
                                    class="btn btn-primary flex-fill">


                                <i class="ti ti-search me-2"></i>

                                Search


                            </button>



                            <button type="button"
                                    id="clearFiltersBtn"
                                    class="btn btn-light flex-fill">


                                <i class="ti ti-refresh me-2"></i>

                                Clear


                            </button>


                        </div>


                    </div>


                </div>


            </form>


        </div>


    </div>






    <!-- ============================================================= -->
    <!-- TABLE CARD -->
    <!-- ============================================================= -->


    <div class="card">



        <div class="card-header justify-content-between">



            <div>


                <h4 class="card-title mb-1">

                    KYC Request Logs

                </h4>


                <p class="text-muted mb-0">

                    KYC request history and verification status.

                </p>


            </div>




            <!-- COLUMN BUTTON -->


            @* <div class="dropdown">


                <button type="button"
                        class="btn btn-light"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside">


                    <i class="ti ti-columns-3 me-1"></i>

                    Columns


                </button>




                <div class="dropdown-menu dropdown-menu-end p-2">


                    <div class="dropdown-header">

                        Show / Hide Columns

                    </div>



                    @for (int i = 0; i < 7; i++)
                    {

                        string name = i switch
                        {

                            0 => "ID",

                            1 => "User ID",

                            2 => "Request Time",

                            3 => "Created At",

                            4 => "Updated At",

                            5 => "Status",

                            6 => "Action",

                            _ => ""

                        };


                        <label class="dropdown-item d-flex align-items-center gap-2">


                            <input type="checkbox"
                                   class="form-check-input column-toggle"
                                   data-column="@i"
                                   checked />


                            <span>

                                @name

                            </span>


                        </label>


                    }


                </div>


            </div> *@



        </div>






        <div class="card-body">



            <div class="table-responsive">


                <table id="kycTable"
                       class="table table-hover table-nowrap align-middle mb-0"
                       style="width:100%">



                    <thead>


                        <tr>


                            <th>ID</th>


                            <th>User ID</th>


                            <th>Request Time</th>


                            <th>Created At</th>


                            <th>Updated At</th>


                            <th>Status</th>


                            <th>Action</th>


                        </tr>


                    </thead>



                    <tbody>
                    </tbody>


                </table>



            </div>




            <div id="dataTableLengthContainer"
                 class="mt-3 pt-2">
            </div>



            <div class="d-flex justify-content-between align-items-center mt-3">


                <div id="dataTableInfoContainer"></div>


                <div id="dataTablePagingContainer"></div>


            </div>



        </div>


    </div>


</div>





<style>


    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .35rem .65rem;
        border-radius: .375rem;
        font-size: .75rem;
        font-weight: 500;
        white-space: nowrap;
    }



    .status-pending {
        background: rgba(255,193,7,.15);
        color: #b58100;
    }



    .status-verified {
        background: rgba(25,135,84,.12);
        color: #198754;
    }



    .status-rejected {
        background: rgba(220,53,69,.12);
        color: #dc3545;
    }



    .status-not-submitted {
        background: rgba(108,117,125,.12);
        color: #6c757d;
    }



    .status-unknown {
        background: rgba(108,117,125,.12);
        color: #6c757d;
    }




    #dataTableLengthContainer select {
        width: auto !important;
        min-width: 65px;
    }

    .dt-length{
        margin-top:20px
    }
    </style>

<script>

    $(document).ready(function () {


        /* =========================================================
           DATE RANGE
        ========================================================= */


        var defaultStart =
            moment().subtract(1, "month");


        var defaultEnd =
            moment();



        function updateDateRange(start, end) {

            var backendValue =
                start.format("YYYY-MM-DD HH:mm:ss")
                +
                " - "
                +
                end.format("YYYY-MM-DD HH:mm:ss");


            $("#dateRange").val(
                backendValue
            );

        }



        /* =========================================================
           DATE PICKER INIT
        ========================================================= */


        if ($.fn.daterangepicker) {


            $("#reportrange").daterangepicker({

                startDate:
                    defaultStart,

                endDate:
                    defaultEnd,

                autoUpdateInput: false,


                opens: "left",

                drops: "down",


                timePicker: true,

                timePicker24Hour: true,

                timePickerSeconds: true,


                locale:
                {

                    format:
                        "MMMM D, YYYY HH:mm:ss",

                    cancelLabel:
                        "Cancel",

                    applyLabel:
                        "Apply"

                },


                ranges:
                {

                    "Today":
                        [
                            moment().startOf("day"),
                            moment().endOf("day")
                        ],


                    "Yesterday":
                        [
                            moment()
                                .subtract(1, "days")
                                .startOf("day"),

                            moment()
                                .subtract(1, "days")
                                .endOf("day")
                        ],


                    "Last 7 Days":
                        [
                            moment()
                                .subtract(6, "days")
                                .startOf("day"),

                            moment()
                                .endOf("day")
                        ],


                    "Last 30 Days":
                        [
                            moment()
                                .subtract(29, "days")
                                .startOf("day"),

                            moment()
                                .endOf("day")
                        ],


                    "This Month":
                        [
                            moment().startOf("month"),
                            moment().endOf("month")
                        ],


                    "Last Month":
                        [
                            moment()
                                .subtract(1, "month")
                                .startOf("month"),

                            moment()
                                .subtract(1, "month")
                                .endOf("month")
                        ]

                }


            });



            var picker =
                $("#reportrange")
                    .data("daterangepicker");



            if (picker) {


                $("#selectedValue").text(

                    defaultStart.format(
                        "MMMM D, YYYY HH:mm:ss"
                    )

                    +

                    " - "

                    +

                    defaultEnd.format(
                        "MMMM D, YYYY HH:mm:ss"
                    )

                );



                updateDateRange(
                    defaultStart,
                    defaultEnd
                );


            }



        }



        /* =========================================================
           DATATABLE
        ========================================================= */


        var table =
            $("#kycTable").DataTable({

                processing: true,

                serverSide: true,

                responsive: true,


                dom:
                    "lrtip",


                pageLength:
                    25,


                lengthMenu:
                    [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],



                order:
                    [
                        [2, "desc"]
                    ],



                ajax:
                {

                    url:
                        "@Url.Action("GetKycRequestLogs", "Dashboard")",


                    type:
                        "POST",



                    data: function (d) {


                        d.userId =
                            $("#filterUserId").val();



                        d.status =
                            $("#filterStatus").val();



                        var range =
                            $("#dateRange").val();



                        if (range) {

                            var dates =
                                range.split(" - ");



                            if (dates.length === 2) {

                                d.fromDate =
                                    dates[0];


                                d.toDate =
                                    dates[1];

                            }

                        }


                    }

                },



                columns:
                    [

                        {
                            data: "id"
                        },


                        {
                            data: "userId"
                        },


                        {
                            data: "requestTime"
                        },


                        {
                            data: "createdAt"
                        },


                        {
                            data: "updatedAt"
                        },



                        {

                            data: "status",


                            render: function (data) {


                                if (Number(data) === 0) {
                                    return `
                                <span class="status-badge status-pending">
                                    Pending
                                </span>`;
                                }


                                if (Number(data) === 1) {
                                    return `
                                <span class="status-badge status-verified">
                                    Verified
                                </span>`;
                                }


                                if (Number(data) === 2) {
                                    return `
                                <span class="status-badge status-rejected">
                                    Rejected
                                </span>`;
                                }


                                return `
                            <span class="status-badge status-unknown">
                                Unknown
                            </span>`;

                            }

                        },



                        {


                            data: null,


                            orderable: false,


                            searchable: false,


                            render: function (data, type, row) {


                                if (Number(row.status) !== 0) {

                                    return `
                                <span class="text-muted">
                                    No Action
                                </span>`;

                                }


                                return `

                            <button class="btn btn-success btn-sm kyc-action"
                                    data-id="${row.id}"
                                    data-status="1">

                                <i class="ti ti-check"></i>
                                Approve

                            </button>


                            <button class="btn btn-danger btn-sm kyc-action"
                                    data-id="${row.id}"
                                    data-status="2">

                                <i class="ti ti-x"></i>
                                Reject

                            </button>

                            `;


                            }


                        }


                    ]

            });




        /* =========================================================
           DATE APPLY EVENT
        ========================================================= */


        $("#reportrange")
            .off("apply.daterangepicker.kyc")
            .on(
                "apply.daterangepicker.kyc",
                function (event, picker) {


                    $("#selectedValue").text(

                        picker.startDate.format(
                            "MMMM D, YYYY HH:mm:ss"
                        )

                        +

                        " - "

                        +

                        picker.endDate.format(
                            "MMMM D, YYYY HH:mm:ss"
                        )

                    );



                    updateDateRange(

                        picker.startDate,

                        picker.endDate

                    );



                    table.ajax.reload(
                        null,
                        true
                    );


                }
            );




        /* =========================================================
           APPROVE / REJECT
        ========================================================= */


        $(document).on(
            "click",
            ".kyc-action",
            function () {


                var id =
                    $(this).data("id");


                var status =
                    $(this).data("status");



                var text =
                    status == 1
                        ?
                        "approve"
                        :
                        "reject";



                Swal.fire({

                    icon: "question",

                    title:
                        "Confirm " + text.toUpperCase(),


                    html:
                        "Are you sure you want to "
                        +
                        "<strong>"
                        +
                        text
                        +
                        "</strong>"
                        +
                        " this KYC request?",


                    showCancelButton: true,


                    confirmButtonText:
                        "Confirm",


                    cancelButtonText:
                        "Cancel"


                })
                    .then(function (result) {


                        if (!result.isConfirmed)
                            return;



                        $.post(
                            "@Url.Action("UpdateKycStatus", "Dashboard")",
                            {
                                id: id,
                                status: status
                            },
                            function (res) {

                                if (res.success) {

                                    Swal.fire(
                                        "Success",
                                        res.message,
                                        "success"
                                    );


                                    table.ajax.reload(
                                        null,
                                        false
                                    );

                                }
                                else {

                                    Swal.fire(
                                        "Failed",
                                        res.message,
                                        "error"
                                    );

                                }

                            }
                        );


                    });


            }
        );



        /* =========================================================
           FILTER
        ========================================================= */


        $("#kycFilterForm")
            .submit(function (e) {

                e.preventDefault();


                table.ajax.reload(
                    null,
                    true
                );


            });



        /* =========================================================
           CLEAR
        ========================================================= */


        $("#clearFiltersBtn")
            .click(function () {


                $("#filterUserId")
                    .val("");



                $("#filterStatus")
                    .val("");



                var start =
                    moment().subtract(1, "month");


                var end =
                    moment();



                var picker =
                    $("#reportrange")
                        .data("daterangepicker");



                if (picker) {

                    picker.setStartDate(start);

                    picker.setEndDate(end);

                }



                $("#selectedValue").text(

                    start.format(
                        "MMMM D, YYYY HH:mm:ss"
                    )
                    +
                    " - "
                    +
                    end.format(
                        "MMMM D, YYYY HH:mm:ss"
                    )

                );



                updateDateRange(
                    start,
                    end
                );



                table.ajax.reload(
                    null,
                    true
                );


            });



    });

</script>
