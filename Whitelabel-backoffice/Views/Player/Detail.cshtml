                success: function (data) {
                    var agentSelect =
                        $("#financeFilterAgentCode");

                    agentSelect.empty();

                    agentSelect.append(
                        new Option(
                            "All Agents",
                            "",
                            true,
                            true
                        )
                    );

                    if (Array.isArray(data)) {
                        data.forEach(function (item) {
                            if (!item.agentCode) {
                                return;
                            }

                            agentSelect.append(
                                new Option(
                                    item.agentCode,
                                    item.agentCode,
                                    false,
                                    false
                                )
                            );
                        });
                    }

                    agentSelect.trigger("change");
                },
                error: function (xhr) {
                    console.error(
                        "Failed to load finance log agents.",
                        xhr
                    );
                }
            });
        }

        loadFinanceLogAgents();

        function escapeHtml(value) {
            if (
                value === null ||
                value === undefined
            ) {
                return "";
            }

            return $("<div>")
                .text(
                    String(value)
                )
                .html();
        }

        function formatMoney(value) {
            var number =
                Number(value);

            return Number.isFinite(number)
                ? number.toFixed(2)
                : "0.00";
        }

        function getFinanceTypeName(value) {
            switch (Number(value)) {
                case 0:
                    return "Self Deposit";
                case 1:
                    return "Manual Deposit";
                case 2:
                    return "Self Withdraw";
                case 3:
                    return "Manual Withdraw";
                default:
                    return "Unknown";
            }
        }

        function getTargetAccountTypeName(value) {
            switch (Number(value)) {
                case 0:
                    return "Player";
                case 1:
                    return "Agent";
                case 2:
                    return "Subaccount";
                default:
                    return "Unknown";
            }
        }

        function getStatusName(value) {
            switch (Number(value)) {
                case 0:
                    return "Pending";
                case 1:
                    return "";
                case 2:
                    return "Completed";
                case 3:
                    return "Rejected";
                case 4:
                    return "Failed";
                case 5:
                    return "Cancelled";
                case 6:
                    return "Auto Cancelled";
                default:
                    return "Unknown";
            }
        }

        function getFinanceBalanceText(
            beforeValue,
            afterValue
        ) {
            var before =
                Number(beforeValue);

            var after =
                Number(afterValue);

            if (!Number.isFinite(before)) {
                before = 0;
            }

            if (!Number.isFinite(after)) {
                after = 0;
            }

            return (
                formatMoney(before) +
                " → " +
                formatMoney(after)
            );
        }

        function renderFinanceBalance(
            beforeValue,
            afterValue
        ) {
            var before =
                Number(beforeValue);

            var after =
                Number(afterValue);

            if (!Number.isFinite(before)) {
                before = 0;
            }

            if (!Number.isFinite(after)) {
                after = 0;
            }

            var afterClass =
                after > before
                    ? "text-success"
                    : after < before
                        ? "text-danger"
                        : "";

            return (
                '<span class="text-nowrap">' +
                formatMoney(before) +
                ' <span class="text-muted mx-1">→</span> ' +
                '<span class="' +
                afterClass +
                '">' +
                formatMoney(after) +
                "</span>" +
                "</span>"
            );
        }

        function renderFinanceType(value) {
            return escapeHtml(
                getFinanceTypeName(value)
            );
        }

        function renderStatus(value) {
            return escapeHtml(
                getStatusName(value)
            );
        }

        var defaultStart =
            moment()
                .subtract(
                    1,
                    "month"
                );

        var defaultEnd =
            moment();

        function updateDateRange(
            start,
            end
        ) {
            $("#dateRange")
                .val(
                    start.format(
                        "YYYY-MM-DD HH:mm:ss"
                    ) +
                    "|" +
                    end.format(
                        "YYYY-MM-DD HH:mm:ss"
                    )
                );
        }

        if ($.fn.daterangepicker) {
            $("#financeReportrange")
                .daterangepicker({
                    startDate:
                        defaultStart,
                    endDate:
                        defaultEnd,
                    autoUpdateInput:
                        false,
                    opens:
                        "left",
                    drops:
                        "down",
                    timePicker:
                        true,
                    timePicker24Hour:
                        true,
                    timePickerSeconds:
                        true,
                    locale: {
                        format:
                            "MMMM D, YYYY HH:mm:ss",
                        cancelLabel:
                            "Cancel",
                        applyLabel:
                            "Apply"
                    },
                    ranges: {
                        "Today": [
                            moment()
                                .startOf("day"),
                            moment()
                                .endOf("day")
                        ],
                        "Yesterday": [
                            moment()
                                .subtract(
                                    1,
                                    "days"
                                )
                                .startOf("day"),
                            moment()
                                .subtract(
                                    1,
                                    "days"
                                )
                                .endOf("day")
                        ],
                        "Last 7 Days": [
                            moment()
                                .subtract(
                                    6,
                                    "days"
                                )
                                .startOf("day"),
                            moment()
                                .endOf("day")
                        ],
                        "Last 30 Days": [
                            moment()
                                .subtract(
                                    29,
                                    "days"
                                )
                                .startOf("day"),
                            moment()
                                .endOf("day")
                        ],
                        "This Month": [
                            moment()
                                .startOf("month"),
                            moment()
                                .endOf("month")
                        ],
                        "Last Month": [
                            moment()
                                .subtract(
                                    1,
                                    "month"
                                )
                                .startOf("month"),
                            moment()
                                .subtract(
                                    1,
                                    "month"
                                )
                                .endOf("month")
                        ]
                    }
                });

            $("#selectedValue")
                .text(
                    defaultStart.format(
                        "MMMM D, YYYY HH:mm:ss"
                    ) +
                    " - " +
                    defaultEnd.format(
                        "MMMM D, YYYY HH:mm:ss"
                    )
                );

            updateDateRange(
                defaultStart,
                defaultEnd
            );

            $("#financeReportrange")
                .off(
                    "apply.daterangepicker.finance"
                )
                .on(
                    "apply.daterangepicker.finance",
                    function (
                        event,
                        picker
                    ) {
                        $("#selectedValue")
                            .text(
                                picker.startDate.format(
                                    "MMMM D, YYYY HH:mm:ss"
                                ) +
                                " - " +
                                picker.endDate.format(
                                    "MMMM D, YYYY HH:mm:ss"
                                )
                            );

                        updateDateRange(
                            picker.startDate,
                            picker.endDate
                        );
                    }
                );
        }

        /* =========================================================
           DATATABLE
        ========================================================= */

        var financeLogsTable = $("#financeLogsTable").DataTable({
            processing: true,
            serverSide: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            deferRender: true,
            stateSave: false,
            pageLength: 25,
            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],
            dom: "lrtip",
            order: [[6, "desc"]],
            columnDefs: [
                {
                    responsivePriority: 1,
                    targets: 0
                },
                {
                    responsivePriority: 2,
                    targets: 9
                },
                {
                    responsivePriority: 3,
                    targets: 8
                },
                {
                    responsivePriority: 4,
                    targets: 7
                },
                {
                    responsivePriority: 5,
                    targets: [2, 3]
                },
                {
                    responsivePriority: 6,
                    targets: 4
                },
                {
                    responsivePriority: 7,
                    targets: 5
                },
                {
                    responsivePriority: 8,
                    targets: 1
                },
                {
                    orderable: false,
                    targets: [0, 8, 9]
                }
            ],
            ajax: {
                url: "@Url.Action("GetFinanceLogs", "Player")",
                type: "POST",
                data: function (d) {
                    d.playerId = @id;
                    d.orderId = $("#financeFilterOrderId").val();
                    d.agentCode = $("#financeFilterAgent").val();
                    d.financeType = $("#financeFilterExecTypes").val();
                    d.amount = $("#financeFilterAmount").val();
                    d.status = $("#financeFilterStatus").val();

                    var range = $("#dateRange").val();

                    if (range) {
                        var dates = range.split("|");

                        if (dates.length === 2) {
                            d.fromDate = dates[0];
                            d.toDate = dates[1];
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error(
                        "GetFinanceLogs AJAX ERROR",
                        xhr.status,
                        status,
                        error,
                        xhr.responseText
                    );
                }
            },
            columns: [
                {
                    data: null,
                    defaultContent: "",
                    orderable: false,
                    searchable: false,
                    className: "text-center text-muted",
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                {
                    data: "orderId",
                    defaultContent: "",
                    render: function (data) {
                        return data == null ? "" : escapeHtml(data);
                    }
                },
                {
                    data: "agentCode",
                    defaultContent: "",
                    render: function (data) {
                        return data == null ? "" : escapeHtml(data);
                    }
                },
                {
                    data: "financeType",
                    defaultContent: "",
                    render: function (data) {
                        return renderFinanceType(data);
                    }
                },
                {
                    data: "amount",
                    defaultContent: "",
                    className: "text-end text-nowrap",
                    render: function (data) {
                        return formatMoney(data);
                    }
                },
                {
                    data: null,
                    defaultContent: "",
                    orderable: false,
                    className: "text-end",
                    render: function (data, type, row) {
                        if (!row) {
                            return "";
                        }

                        return renderFinanceBalance(
                            row.targetBeforeBalance,
                            row.targetAfterBalance
                        );
                    }
                },
                {
                    data: "createdAt",
                    defaultContent: "",
                    render: function (data) {
                        return data == null ? "" : escapeHtml(data);
                    }
                },
                {
                    data: "status",
                    defaultContent: "",
                    render: function (data) {
                        return renderStatus(data);
                    }
                },
                {
                    data: null,
                    defaultContent: "",
                    orderable: false,
                    searchable: false,
                    className: "text-center",
                    render: function (data) {
                        if (!data) {
                            return "";
                        }

                        return '<button type="button" ' +
                            'class="btn btn-sm btn-light js-finance-details" ' +
                            'data-log-id="' + escapeHtml(data.id) + '" ' +
                            'title="View details" ' +
                            'aria-label="View finance log details">' +
                            '<i class="ti ti-eye"></i>' +
                            '</button>';
                    }
                },
                {
                    data: null,
                    defaultContent: "",
                    orderable: false,
                    searchable: false,
                    className: "text-center",
                    render: function (data) {
                        if (!data) {
                            return '<span class="text-muted small">No actions</span>';
                        }

                        var canManage =
                            Number(data.financeType) === 2 &&
                            Number(data.status) === 0;

                        if (!canManage) {
                            return '<span class="text-muted small">No actions</span>';
                        }

                        return '<div class="d-inline-flex gap-1">' +
                            '<button type="button" ' +
                            'class="btn btn-sm btn-success js-finance-action" ' +
                            'data-action="complete" ' +
                            'data-log-id="' + escapeHtml(data.id) + '" ' +
                            'title="Complete transaction">' +
                            '<i class="ti ti-check me-1"></i>' +
                            'Complete' +
                            '</button>' +
                            '<button type="button" ' +
                            'class="btn btn-sm btn-danger js-finance-action" ' +
                            'data-action="reject" ' +
                            'data-log-id="' + escapeHtml(data.id) + '" ' +
                            'title="Reject transaction">' +
                            '<i class="ti ti-x me-1"></i>' +
                            'Reject' +
                            '</button>' +
                            '</div>';
                    }
                }
            ],
            initComplete: function () {
                var api = this.api();
                var container = $(api.table().container());
                var length = container.find(".dt-length, .dataTables_length").first();
                var info = container.find(".dt-info, .dataTables_info").first();
                var paging = container.find(".dt-paging, .dataTables_paginate").first();

                if (length.length) {
                    $("#dataTableLengthContainer").empty().append(length);
                }

                if (info.length) {
                    $("#dataTableInfoContainer").empty().append(info);
                }

                if (paging.length) {
                    $("#dataTablePagingContainer").empty().append(paging);
                }

                api.columns.adjust();

                if (api.responsive && typeof api.responsive.recalc === "function") {
                    api.responsive.recalc();
                }
            }
        });

        $("#financeFilterForm")
            .on(
                "submit",
                function (e) {
                    e.preventDefault();

                    financeLogsTable.ajax.reload(
                        null,
                        true
                    );
                }
            );

        $(
            "#financeFilterAgentCode, " +
            "#financeFilterAmount, " +
            "#financeFilterOrderId"
        )
            .on(
                "keydown",
                function (e) {
                    if (
                        e.key ===
                        "Enter"
                    ) {
                        e.preventDefault();

                        $("#financeFilterForm")
                            .trigger(
                                "submit"
                            );
                    }
                }
            );

        /* =========================================================
           CLEAR
        ========================================================= */

        $("#financeClearFiltersBtn")
            .on(
                "click",
                function () {
                    $("#financeFilterAgentCode")
                        .val("")
                        .trigger(
                            "change"
                        );

                    $("#financeFilterExecTypes, " +
                        "#financeFilterStatus")
                        .val("")
                        .trigger(
                            "change"
                        );

                    $("#financeFilterAmount")
                        .val("");

                    $("#financeFilterOrderId")
                        .val("");

                    var start =
                        moment()
                            .subtract(
                                1,
                                "month"
                            );

                    var end =
                        moment();

                    var picker =
                        $("#financeReportrange")
                            .data(
                                "daterangepicker"
                            );

                    if (picker) {
                        picker.setStartDate(
                            start
                        );

                        picker.setEndDate(
                            end
                        );
                    }

                    $("#selectedValue")
                        .text(
                            start.format(
                                "MMMM D, YYYY HH:mm:ss"
                            ) +
                            " - " +
                            end.format(
                                "MMMM D, YYYY HH:mm:ss"
                            )
                        );

                    updateDateRange(
                        start,
                        end
                    );

                    financeLogsTable.ajax.reload(
                        null,
                        true
                    );
                }
            );

        /* =========================================================
           FIND CURRENT ROW
        ========================================================= */

        function getSelectedRow(id) {

            var rows =
                financeLogsTable.rows().data();

            for (
                var i = 0;
                i < rows.length;
                i++
            ) {

                if (
                    Number(rows[i].id) ===
                    Number(id)
                ) {

                    return rows[i];

                }

            }

            return null;
        }


        /* =========================================================
           COMPLETE / REJECT
        ========================================================= */

        $(document)
            .off(
                "click.financeAction",
                ".js-finance-action"
            )
            .on(
                "click.financeAction",
                ".js-finance-action",
                function () {

                    var $button =
                        $(this);

                    var action =
                        String(
                            $button.data("action")
                        );

                    var logId =
                        Number(
                            $button.data("log-id")
                        );

                    if (
                        (
                            action !== "complete" &&
                            action !== "reject"
                        ) ||
                        !Number.isFinite(logId) ||
                        $button.prop("disabled")
                    ) {
                        return;
                    }

                    var selected =
                        getSelectedRow(logId);

                    if (
                        !selected ||
                        Number(selected.financeType) !== 2 ||
                        Number(selected.status) !== 0
                    ) {
                        return;
                    }

                    var amount =
                        formatMoney(selected.amount);

                    var targetCode =
                        selected.targetCode || "";

                    var orderId =
                        selected.orderId || "-";

                    var isComplete =
                        action === "complete";

                    var title =
                        isComplete
                            ? "Complete Self Withdraw?"
                            : "Reject Self Withdraw?";

                    var confirmText =
                        isComplete
                            ? "Complete"
                            : "Reject";

                    var message =
                        isComplete
                            ?
                            "Target: " +
                            targetCode +
                            "\nAmount: " +
                            amount +
                            "\nOrder ID: " +
                            orderId +
                            "\n\nPlayer CurrentBalance will decrease and agent Balance will increase."
                            :
                            "Target: " +
                            targetCode +
                            "\nAmount: " +
                            amount +
                            "\nOrder ID: " +
                            orderId +
                            "\n\nNo balance will be changed.";

                    $button.prop(
                        "disabled",
                        true
                    );

                    Swal.fire({

                        title: title,

                        text: message,

                        icon: "warning",

                        showCancelButton: true,

                        confirmButtonText:
                            confirmText,

                        cancelButtonText:
                            "Cancel",

                        reverseButtons: true

                    })
                        .then(
                            function (result) {

                                if (
                                    !result ||
                                    !result.isConfirmed
                                ) {

                                    $button.prop(
                                        "disabled",
                                        false
                                    );

                                    return;

                                }

                                var endpoint =
                                    isComplete
                                        ?
                                        "@Url.Action("CompleteFinanceLog", "Player")"
                                        :
                                        "@Url.Action("RejectFinanceLog", "Player")";

                                $.ajax({

                                    url: endpoint,

                                    type: "POST",

                                    data: {
                                        __RequestVerificationToken:
                                            $("input[name='__RequestVerificationToken']").val(),

                                        id: selected.id
                                    },

                                    success:
                                        function (response) {

                                            if (
                                                !response ||
                                                !response.success
                                            ) {

                                                $button.prop(
                                                    "disabled",
                                                    false
                                                );

                                                showFinanceError(
                                                    response?.message ||
                                                    (
                                                        isComplete
                                                            ?
                                                            "Unable to complete this transaction."
                                                            :
                                                            "Unable to reject this transaction."
                                                    )
                                                );

                                                return;

                                            }

                                            showFinanceSuccess(
                                                isComplete
                                                    ?
                                                    "Completed. Player and agent balances updated."
                                                    :
                                                    "Rejected. No balance was changed."
                                            );

                                            financeLogsTable.ajax.reload(
                                                null,
                                                false
                                            );

                                        },

                                    error:
                                        function (xhr) {

                                            $button.prop(
                                                "disabled",
                                                false
                                            );

                                            var message =
                                                xhr.responseJSON?.message ||
                                                "An unexpected error occurred.";

                                            showFinanceError(
                                                message
                                            );

                                        }

                                });

                            }
                        );

                }
            );


        /* =========================================================
           SWEETALERT ERROR
        ========================================================= */

        function showFinanceError(message) {

            Swal.fire({

                title:
                    "Operation Failed",

                text:
                    message,

                icon:
                    "error"

            });

        }


        /* =========================================================
           SWEETALERT SUCCESS TOAST
        ========================================================= */

        function showFinanceSuccess(message) {

            Swal.fire({

                toast:
                    true,

                position:
                    "top-end",

                icon:
                    "success",

                title:
                    message,

                timer:
                    1800,

                showConfirmButton:
                    false

            });

        }


        /* =========================================================
           DETAILS
        ========================================================= */

        $(document)
            .off(
                "click.financeDetails",
                ".js-finance-details"
            )
            .on(
                "click.financeDetails",
                ".js-finance-details",
                function () {

                    var logId =
                        Number(
                            $(this).data("log-id")
                        );

                    if (
                        !Number.isFinite(logId)
                    ) {

                        return;

                    }

                    var selected =
                        getSelectedRow(logId);

                    if (!selected) {

                        return;

                    }

                    $("#detailId")
                        .text(
                            selected.id ?? ""
                        );

                    $("#detailOrderId")
                        .text(
                            selected.orderId ?? ""
                        );

                    $("#detailAgentCode")
                        .text(
                            selected.agentCode ?? ""
                        );

                    $("#detailTargetCode")
                        .text(
                            selected.targetCode ?? ""
                        );

                    $("#detailFinanceType")
                        .text(
                            getFinanceTypeName(
                                selected.financeType
                            )
                        );

                    $("#detailTargetAccountType")
                        .text(
                            getTargetAccountTypeName(
                                selected.targetAccountType
                            )
                        );

                    $("#detailAmount")
                        .text(
                            formatMoney(
                                selected.amount
                            )
                        );

                    $("#detailStatus")
                        .text(
                            getStatusName(
                                selected.status
                            )
                        );

                    $("#detailTargetBalance")
                        .text(
                            getFinanceBalanceText(
                                selected.targetBeforeBalance,
                                selected.targetAfterBalance
                            )
                        );

                    $("#detailAgentBalance")
                        .text(
                            getFinanceBalanceText(
                                selected.agentBeforeBalance,
                                selected.agentAfterBalance
                            )
                        );

                    $("#detailCreatedAt")
                        .text(
                            selected.createdAt ?? ""
                        );

                    $("#detailAgentPath")
                        .text(
                            selected.agentPath ?? ""
                        );

                    $("#detailTargetPath")
                        .text(
                            selected.targetPath ?? ""
                        );

                    var modalElement =
                        document.getElementById(
                            "financeLogDetailsModal"
                        );

                    if (
                        modalElement &&
                        typeof bootstrap !== "undefined" &&
                        bootstrap.Modal
                    ) {

                        bootstrap.Modal
                            .getOrCreateInstance(
                                modalElement
                            )
                            .show();

                    }

                }
            );


        /* =========================================================
           RESIZE
        ========================================================= */

        $(window)
            .off(
                "resize.financeLogs"
            )
            .on(
                "resize.financeLogs",
                function () {

                    financeLogsTable
                        .columns
                        .adjust();

                    if (
                        financeLogsTable.responsive &&
                        typeof financeLogsTable.responsive.recalc ===
                        "function"
                    ) {

                        financeLogsTable
                            .responsive
                            .recalc();

                    }

                }
            );
    });
</script>