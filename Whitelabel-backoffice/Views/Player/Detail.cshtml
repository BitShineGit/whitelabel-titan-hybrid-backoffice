<script>
    const profileFormDiv = document.querySelector('#profileForm .row-cols-2');
    const btnBackToList = document.querySelector('#btnBackToList');
    const btnRemove = document.querySelector('#btnRemove');

    const mediaQuery = window.matchMedia('(max-width: 767px)');

    function checkScreenWidth(e) {
        profileFormDiv.classList.toggle('row-cols-2', !e.matches);

        if (e.matches) {
            btnBackToList.innerHTML = '<i class="ti ti-list"></i>';
            btnRemove.innerHTML = '<i class="ti ti-trash"></i>';
        } else {
            btnBackToList.innerHTML = '<i class="ti ti-list"></i>List';
            btnRemove.innerHTML = '<i class="ti ti-trash"></i>Remove';
        }
    }

    checkScreenWidth(mediaQuery);
    mediaQuery.addEventListener('change', checkScreenWidth);

    $('#btnRemove').on('click', function (e) {
        e.preventDefault();
        Swal.fire({
            title: 'Are you sure?',
            html: `You are about to delete player <b>@userCode</b>. This action cannot be undone.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#dc3545',
            reverseButtons: true
        }).then(function (result) {

            if (!result.isConfirmed) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeletePlayer", "Player")',
                type: 'POST',
                data: { id: @id },

                success: function (response) {

                    if (response.success) {

                        Swal.fire({
                            title: 'Deleted!',
                            text: response.message || 'Player has been deleted.',
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(function () {
                            window.location.href = '@Url.Action("Index", "Player")';
                        });

                    } else {

                        Swal.fire({
                            title: 'Failed',
                            text: response.message || 'Unable to delete player.',
                            icon: 'error'
                        });
                    }
                },

                error: function () {

                    Swal.fire({
                        title: 'Error',
                        text: 'An error occurred while deleting the player.',
                        icon: 'error'
                    });
                }
            });
        });
    });

    jQuery().select2 && $('[data-toggle="select2"]').select2();
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("userStatus").value = @user.Status;
        document.getElementById("currency").value = "@user.CurrencyCode";

        const form = document.getElementById("profileForm");
        const saveButton = document.getElementById("btnSaveProfile");
        const cancelButton = document.getElementById("btnCancelProfile");

        if (!form) return;

        let originalValues = {};

        const fields = form.querySelectorAll(
            "input:not([disabled]), select, textarea"
        );

        function getCurrentValues() {
            const values = {};

            fields.forEach(field => {
                values[field.id] = field.value;
            });

            return values;
        }

        function hasChanges() {
            const currentValues = getCurrentValues();

            return Object.keys(originalValues).some(id =>
                originalValues[id] !== currentValues[id]
            );
        }

        function updateButtons() {

            const changed = hasChanges();

            saveButton.disabled = !changed;
            cancelButton.disabled = !changed;
        }

        // Store original values
        originalValues = getCurrentValues();

        // Detect changes
        fields.forEach(field => {

            field.addEventListener("input", updateButtons);
            field.addEventListener("change", updateButtons);

        });


        // ==========================================
        // CANCEL
        // ==========================================

        cancelButton.addEventListener("click", function () {

            fields.forEach(field => {
                field.value = originalValues[field.id];
            });

            updateButtons();
        });


        // ==========================================
        // SAVE / CONFIRM
        // ==========================================

        form.addEventListener("submit", async function (e) {

            e.preventDefault();

            if (!hasChanges()) {
                return;
            }


            // Show confirmation
            const result = await Swal.fire({

                title: "Confirm Changes",

                text: "Are you sure you want to save these changes?",

                icon: "warning",

                showCancelButton: true,

                confirmButtonText: "Yes, save changes",

                cancelButtonText: "Cancel",

                showCloseButton: true,

                buttonsStyling: false,

                customClass: {
                    confirmButton: "btn btn-primary me-2 mt-2",
                    cancelButton: "btn btn-danger mt-2"
                }

            });


            // User clicked Cancel / closed alert
            if (!result.isConfirmed) {
                return;
            }


            // ==========================================
            // USER CONFIRMED
            // ==========================================

            const data = {

                userCode: "@userCode",

                status:
                    document.getElementById("userStatus").value,

                nickName:
                    document.getElementById("userName").value,

                userEmail:
                    document.getElementById("userEmail").value,

                phoneNumber:
                    document.getElementById("userPhone").value,

                currencyId:
                    document.getElementById("currency").value
            };


            try {

                saveButton.disabled = true;
                cancelButton.disabled = true;


                const response = await fetch(
                    '@Url.Action("UpdateProfile", "Player")',
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify(data)
                    }
                );


                if (!response.ok) {
                    throw new Error("Failed to update profile.");
                }


                const responseData =
                    await response.json();


                if (!responseData.success) {

                    throw new Error(
                        responseData.message ||
                        "Unable to update profile."
                    );
                }


                // ==========================================
                // UPDATE ORIGINAL VALUES
                // ==========================================

                originalValues = getCurrentValues();

                updateButtons();


                // ==========================================
                // SUCCESS ALERT
                // ==========================================

                Swal.fire({

                    title: "Updated!",

                    text: "Player profile has been updated successfully.",

                    icon: "success",

                    confirmButtonText: "OK",

                    buttonsStyling: false,

                    customClass: {
                        confirmButton: "btn btn-primary mt-2"
                    }

                });


            }
            catch (error) {

                console.error(error);

                updateButtons();


                Swal.fire({

                    title: "Update Failed",

                    text: error.message ||
                          "Something went wrong while updating the profile.",

                    icon: "error",

                    confirmButtonText: "OK",

                    buttonsStyling: false,

                    customClass: {
                        confirmButton: "btn btn-primary mt-2"
                    }

                });
            }

        });

    });
</script>
<script>
    // ============================================================
    // BETTING LOG FILTER VARIABLES
    // ============================================================

    let bettingCreatedAtStart = '';
    let bettingCreatedAtEnd = '';


    // ============================================================
    // PROVIDER CODE - SELECT2
    // ============================================================

    $('#filterProviderCode').select2({
        placeholder: 'All Providers',
        allowClear: true,
        width: '100%'
    });


    // ============================================================
    // LOAD PROVIDERS FROM BETTING LOGS
    // ============================================================

    function loadBettingLogProviders() {

        $.ajax({
            url: '@Url.Action("GetBettingLogProviders", "Player")',
            type: 'GET',
            dataType: 'json',

            success: function (data) {

                const providerSelect =
                    $('#filterProviderCode');

                providerSelect.empty();

                providerSelect.append(
                    new Option(
                        'All Providers',
                        '',
                        true,
                        true
                    )
                );

                if (Array.isArray(data)) {

                    data.forEach(function (item) {

                        if (!item.providerCode) {
                            return;
                        }

                        providerSelect.append(
                            new Option(
                                item.providerCode,
                                item.providerCode,
                                false,
                                false
                            )
                        );
                    });
                }

                providerSelect.trigger('change');
            },

            error: function (xhr) {

                console.error(
                    'Failed to load betting log providers.',
                    xhr
                );
            }
        });
    }


    // Load providers
    loadBettingLogProviders();


    // ============================================================
    // DATE RANGE
    // ============================================================

    function updateBettingDateDisplay(start, end) {

        $('#selectedValue').html(
            start.format('MMMM D, YYYY HH:mm:ss') +
            ' - ' +
            end.format('MMMM D, YYYY HH:mm:ss')
        );

        bettingCreatedAtStart =
            start.format('YYYY-MM-DD HH:mm:ss');

        bettingCreatedAtEnd =
            end.format('YYYY-MM-DD HH:mm:ss');

        $('#dateRange').val(
            bettingCreatedAtStart +
            '|' +
            bettingCreatedAtEnd
        );
    }


    $('#reportrange').daterangepicker({

        startDate: moment().subtract(29, 'days').startOf('day'),

        endDate: moment().endOf('day'),

        timePicker: true,

        timePicker24Hour: true,

        timePickerSeconds: true,

        ranges: {

            'Today': [
                moment().startOf('day'),
                moment().endOf('day')
            ],

            'Yesterday': [
                moment().subtract(1, 'days').startOf('day'),
                moment().subtract(1, 'days').endOf('day')
            ],

            'Last 7 Days': [
                moment().subtract(6, 'days').startOf('day'),
                moment().endOf('day')
            ],

            'Last 30 Days': [
                moment().subtract(29, 'days').startOf('day'),
                moment().endOf('day')
            ],

            'This Month': [
                moment().startOf('month').startOf('day'),
                moment().endOf('month').endOf('day')
            ],

            'Last Month': [
                moment().subtract(1, 'month').startOf('month').startOf('day'),
                moment().subtract(1, 'month').endOf('month').endOf('day')
            ]

        },

        locale: {

            format: 'MM/DD/YYYY HH:mm:ss',

            applyLabel: 'Apply',

            cancelLabel: 'Cancel',

            customRangeLabel: 'Custom Range'
        },

        cancelClass: 'btn-light',

        applyButtonClasses: 'btn-success'

    }, function (start, end) {

        updateBettingDateDisplay(
            start,
            end
        );

    });


    // Initial date
    updateBettingDateDisplay(
        moment().subtract(29, 'days').startOf('day'),
        moment().endOf('day')
    );

    // ============================================================
    // BETTING LOG DATATABLE
    // ============================================================

    const bettingTable = new DataTable(
        '#bettingLogTable',
        {

            responsive: true,

            processing: true,

            serverSide: true,

            searching: false,

            select: true,

            pageLength: 10,

            stateSave: false,

            lengthMenu: [
                10,
                25,
                50,
                100
            ],

            // Newest logs first
            order: [
                [0, 'desc']
            ],


            // ====================================================
            // DOM
            // ====================================================

            dom: `
                <'row align-items-center mt-2 mb-3'
                    <'col-md-6'
                        <'columnToggleWrapper'>
                    >
                    <'col-md-6 text-end'
                        l
                    >
                >
                rt
                <'row align-items-center mt-2'
                    <'col-md-6'
                        i
                    >
                    <'col-md-6 text-end'
                        p
                    >
                >
            `,


            // ====================================================
            // LANGUAGE
            // ====================================================

            language: {

                paginate: {

                    first:
                        '<i class="ti ti-chevrons-left"></i>',

                    previous:
                        '<i class="ti ti-chevron-left"></i>',

                    next:
                        '<i class="ti ti-chevron-right"></i>',

                    last:
                        '<i class="ti ti-chevrons-right"></i>'
                }
            },


            // ====================================================
            // AJAX
            // ====================================================

            ajax: {

                url:
                    '@Url.Action("GetBettingLogs", "Player")',

                type: 'POST',

                data: function (d) {

                    d.playerCode = '@userCode';

                    // Provider
                    d.providerCode =
                        $('#filterProviderCode').val() || '';

                    // Game Code
                    d.gameCode =
                        $('#filterGameCode').val().trim();

                    // Round ID
                    d.roundId =
                        $('#filterRoundId').val().trim();

                    // History ID
                    d.historyId =
                        $('#filterHistoryId').val().trim();

                    // Status
                    d.status =
                        $('#filterStatus').val() || '';

                    // Date
                    d.createdFrom =
                        bettingCreatedAtStart || '';

                    d.createdTo =
                        bettingCreatedAtEnd || '';
                }
            },


            // ====================================================
            // COLUMNS
            // ====================================================

            columns: [

                // 0 - ID
                {
                    data: 'id'
                },

                // 1 - Provider Code
                {
                    data: 'providerCode',

                    render: function (data) {
                        return data || '-';
                    }
                },

                // 2 - Game Code
                {
                    data: 'gameCode',

                    render: function (data) {
                        return data || '-';
                    }
                },

                // 3 - Round ID
                {
                    data: 'roundId',

                    render: function (data) {
                        return data || '-';
                    }
                },

                // 4 - History ID
                {
                    data: 'historyId',

                },

                // 5 - Bet Amount
                {
                    data: 'betAmount',

                    render: function (data) {

                        return Number(
                            data || 0
                        ).toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );
                    }
                },

                // 6 - Win Amount
                {
                    data: 'winAmount',

                    render: function (data) {

                        return Number(
                            data || 0
                        ).toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );
                    }
                },

                // 7 - Before Balance
                {
                    data: 'beforeBalance',

                    render: function (data) {

                        return Number(
                            data || 0
                        ).toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );
                    }
                },

                // 8 - After Balance
                {
                    data: 'afterBalance',

                    render: function (data) {

                        return Number(
                            data || 0
                        ).toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );
                    }
                },

                // 9 - Status
                {
                    data: 'status',

                    render: (e, t, n) => {
                        const status = Number(e);

                        if (status === 1)
                            return `<span class="badge badge-label badge-soft-success">Success</span>`;

                        if (status === 2)
                            return `<span class="badge badge-label badge-soft-warning">Outstanding</span>`;

                        return `<span class="badge badge-label badge-soft-danger">Canceled</span>`;
                    }
                },

                // 10 - Created At
                {
                    data: 'createdAt',

                    render: function (data) {

                        if (!data) {
                            return '-';
                        }

                        return moment(data)
                            .format(
                                'YYYY-MM-DD HH:mm:ss'
                            );
                    }
                }

            ],


            // ====================================================
            // SORTABLE COLUMNS
            // ====================================================

            columnDefs: [

                {
                    orderable: true,
                    targets: [0, 5, 6, 10]
                },

                {
                    orderable: false,
                    targets: [
                        1,
                        2,
                        3,
                        4,
                        7,
                        8,
                        9
                    ]
                }

            ],


            // ====================================================
            // COLUMN TOGGLE
            // ====================================================

            initComplete: function () {

                const columnNames = [

                    'ID',

                    'Provider Code',

                    'Game Code',

                    'Round ID',

                    'History ID',

                    'Bet Amount',

                    'Win Amount',

                    'Before Balance',

                    'After Balance',

                    'Status',

                    'Created At'

                ];


                const wrapper =
                    document.querySelector(
                        '.columnToggleWrapper'
                    );


                if (!wrapper) {
                    return;
                }


                const dropdown =
                    document.createElement('div');

                dropdown.className =
                    'dropdown';


                dropdown.innerHTML = `

                    <button
                        class="btn btn-sm btn-secondary"
                        type="button"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside">

                        <i class="ti ti-columns-3 me-1"></i>

                        Show / Hide Columns

                    </button>


                    <ul
                        class="dropdown-menu"
                        id="columnToggleMenu">

                        ${columnNames.map(
                    function (name, index) {

                        const visible =
                            bettingTable
                                .column(index)
                                .visible();

                        return `

                                    <li class="dropdown-item">

                                        <div class="form-check">

                                            <input
                                                class="form-check-input form-check-input-light fs-14 mt-0 toggle-vis"
                                                type="checkbox"
                                                data-column="${index}"
                                                id="bettingColToggle${index}"
                                                ${visible ? 'checked' : ''}>

                                            <label
                                                class="form-check-label fw-medium"
                                                for="bettingColToggle${index}">

                                                ${name}

                                            </label>

                                        </div>

                                    </li>

                                `;
                    }
                ).join('')}

                    </ul>
                `;


                wrapper.appendChild(dropdown);


                const menu =
                    document.getElementById(
                        'columnToggleMenu'
                    );


                if (menu) {

                    menu.addEventListener(
                        'change',
                        function (event) {

                            if (
                                !event.target.classList.contains(
                                    'toggle-vis'
                                )
                            ) {
                                return;
                            }


                            const columnIndex =
                                parseInt(
                                    event.target.dataset.column,
                                    10
                                );


                            bettingTable
                                .column(columnIndex)
                                .visible(
                                    event.target.checked
                                );
                        }
                    );
                }
            }

        }
    );


    // ============================================================
    // APPLY FILTERS
    // ============================================================

    $('#bettingFilterForm').on(
        'submit',
        function (e) {

            e.preventDefault();

            bettingTable.ajax.reload(
                null,
                true
            );
        }
    );


    // ============================================================
    // CLEAR FILTERS
    // ============================================================

    $('#clearBettingLogFiltersBtn').on(
        'click',
        function () {

            // Provider
            $('#filterProviderCode')
                .val('')
                .trigger('change');


            // Game
            $('#filterGameCode')
                .val('');


            // Round
            $('#filterRoundId')
                .val('');


            // History
            $('#filterHistoryId')
                .val('');


            // Status
            $('#filterStatus')
                .val('')
                .trigger('change');


            // Reset date
            const start =
                moment().subtract(29, 'days');

            const end =
                moment();


            updateBettingDateDisplay(
                start,
                end
            );


            // Reload
            bettingTable.ajax.reload(
                null,
                true
            );
        }
    );
</script>
