@using Whitelabel_backoffice.Database
@section Styles {
    <link href="~/assets/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/select2/select2.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/daterangepicker/daterangepicker.css" rel="stylesheet" type="text/css" />
}
@{
    ViewData["Title"] = "Player Detail";
    string userCode = (string)ViewData["UserCode"];
    int id = (int)ViewData["UserId"];
    var user = (User)ViewData["User"];
    var providerCodeList = (List<string>)ViewData["ProviderCodeList"];
    DateTime UserCreatedAtLocal = (DateTime)ViewData["UserCreatedAtLocal"];
}

<div class="container-fluid">
    <div class="page-title-head d-flex align-items-center">
        <div class="flex-grow-1">
            <h4 class="page-main-title m-0">Player</h4>
        </div>

        <div class="text-end">
            <ol class="breadcrumb m-0 py-0">
                <li class="breadcrumb-item"><a href="/">MyStake</a></li>
                <li class="breadcrumb-item"><a href="/player">Player</a></li>
                <li class="breadcrumb-item active">Detail</li>
            </ol>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- Card Body -->
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex justify-content-start align-items-center gap-3">
                            <div class="avatar avatar-xxl">
                                <div class="img-fluid img-thumbnail rounded-circle" style="height:80px; width:80px;">
                                    <span class="avatar-title text-bg-primary rounded-circle fs-48">
                                        <i class="ti ti-user"></i>
                                    </span>
                                </div>
                            </div>
                            <div>
                                <h4 class="text-nowrap fw-bold mb-1">@user.UserNickName</h4>
                                <p class="text-muted mb-1">@user.UserCode</p>
                                <span class="badge badge-soft-primary fw-medium fs-xs ms-auto">Player</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary gap-1" id="btnBackToList" style="font-size: larger;" href="/player">
                                <i class="ti ti-list"></i>
                                List
                            </a>
                            <a class="btn btn-danger gap-1" id="btnRemove" style="font-size: larger;" href="#!">
                                <i class="ti ti-trash"></i>
                                Remove
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end col-->
    </div>
    <!-- end row-->

    <div class="row">

        <div>
            <div class="row row-cols-xxl-4 row-cols-md-2 row-cols-1 align-items-center">
                <div class="col">
                    <div class="card">
                        <div class="card-body">
                            <h5 title="Number of Tasks">My Tasks</h5>
                            <div class="d-flex align-items-center gap-2 my-3">
                                <div class="avatar-md flex-shrink-0">
                                    <span class="avatar-title text-bg-primary rounded-circle fs-22">
                                        <i class="ti ti-clipboard-list"></i>
                                    </span>
                                </div>
                                <h3 class="mb-0">124</h3>
                                <span class="badge badge-soft-primary fw-medium fs-xs ms-auto">+3 New</span>
                            </div>
                            <p class="mb-0">
                                <span class="text-primary">
                                    <i class="ti ti-circle align-middle"></i>
                                </span>
                                <span class="text-nowrap text-muted">Total Tasks</span>
                                <span class="float-end"><b>12,450</b></span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card">
                        <div class="card-body">
                            <h5 title="Number of Messages">Messages</h5>
                            <div class="d-flex align-items-center gap-2 my-3">
                                <div class="avatar-md flex-shrink-0">
                                    <span class="avatar-title text-bg-secondary rounded-circle fs-22">
                                        <i class="ti ti-messages"></i>
                                    </span>
                                </div>
                                <h3 class="mb-0">69.5k</h3>
                                <span class="badge badge-soft-secondary fw-medium fs-xs ms-auto">+5 New</span>
                            </div>
                            <p class="mb-0">
                                <span class="text-secondary">
                                    <i class="ti ti-circle align-middle"></i>
                                </span>
                                <span class="text-nowrap text-muted">Total Messages</span>
                                <span class="float-end"><b>32.1M</b></span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card">
                        <div class="card-body">
                            <h5 title="Total Clients">Clients</h5>
                            <div class="d-flex align-items-center gap-2 my-3">
                                <div class="avatar-md flex-shrink-0">
                                    <span class="avatar-title text-bg-secondary rounded-circle fs-22">
                                        <i class="ti ti-users"></i>
                                    </span>
                                </div>
                                <h3 class="mb-0">184</h3>
                                <span class="badge badge-soft-secondary fw-medium fs-xs ms-auto">+4 New</span>
                            </div>
                            <p class="mb-0">
                                <span class="text-secondary">
                                    <i class="ti ti-circle align-middle"></i>
                                </span>
                                <span class="text-nowrap text-muted">Total Clients</span>
                                <span class="float-end"><b>9,835</b></span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card">
                        <div class="card-body">
                            <h5 title="Revenue Generated">Revenue</h5>
                            <div class="d-flex align-items-center gap-2 my-3">
                                <div class="avatar-md flex-shrink-0">
                                    <span class="avatar-title text-bg-primary rounded-circle fs-22">
                                        <i class="ti ti-credit-card"></i>
                                    </span>
                                </div>
                                <h3 class="mb-0">$25.5k</h3>
                                <span class="badge badge-soft-primary fw-medium fs-xs ms-auto">+1.5%</span>
                            </div>
                            <p class="mb-0">
                                <span class="text-primary">
                                    <i class="ti ti-circle align-middle"></i>
                                </span>
                                <span class="text-nowrap text-muted">Total Revenue</span>
                                <span class="float-end"><b>$12.5M</b></span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end row -->

            <div>
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">

                                <ul class="nav nav-justified nav-tabs mb-3">
                                    <li class="nav-item">
                                        <a href="#detail_profile" data-bs-toggle="tab" aria-expanded="false" class="nav-link active">Profile</a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#detail_finance" data-bs-toggle="tab" aria-expanded="true" class="nav-link">Finance</a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#detail_history" data-bs-toggle="tab" aria-expanded="false" class="nav-link">History</a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#detail_settings" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Settings</a>
                                    </li>
                                </ul>

                                <div class="tab-content">
                                    <div class="tab-pane mb-3 show active" id="detail_profile">
                                        <div class="card-body">
                                            <form id="profileForm">
                                                <div class="row g-3 row-cols-2">
                                                    <div style="display: flex; flex-direction: column; align-items: center;">
                                                        <h5 class="text-uppercase bg-light-subtle p-1 border-dashed border rounded border-light d-flex justify-content-center align-items-center gap-1">
                                                            <i class="ti ti-key fs-24"></i>
                                                            Identity
                                                        </h5>

                                                        <!-- User ID -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">User Code</label>
                                                            <input type="text" class="form-control" id="userCode" value="@user.UserCode" disabled="" wfd-id="id2">
                                                        </div>

                                                        <!-- Status -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">Status</label>
                                                            <select class="form-select" id="userStatus">
                                                                <option value="1">Active</option>
                                                                <option value="0">Blocked</option>
                                                            </select>
                                                        </div>

                                                        <!-- User Name -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">User Name</label>
                                                            <input type="text" class="form-control" id="userName" value="@user.UserNickName" wfd-id="id5">
                                                        </div>

                                                        <!-- User Email -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">User Email</label>
                                                            <input type="email" class="form-control" id="userEmail" value="@user.UserEmail" wfd-id="id6">
                                                        </div>
                                                    </div>
                                                    <div style="display: flex; flex-direction: column; align-items: center;">
                                                        <h5 class="text-uppercase bg-light-subtle p-1 border-dashed border rounded border-light d-flex justify-content-center align-items-center gap-1">
                                                            <i class="ti ti-user fs-24"></i>
                                                            Personal Info
                                                        </h5>

                                                        <!-- User PhoneNumber -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">Phone Number</label>
                                                            <input type="text" class="form-control" id="userPhone" value="@user.PhoneNumber" wfd-id="id5">
                                                        </div>

                                                        <!-- Currency -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">Currency</label>
                                                            <input class="form-control" disabled id="currency"></input>
                                                        </div>

                                                        <!-- Created At -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">Created Date</label>
                                                            <input type="text" class="form-control" id="createDate" value="@UserCreatedAtLocal" wfd-id="id8">
                                                        </div>

                                                        <!-- Last Login At -->
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label">Last Login Date</label>
                                                            <input type="text"
                                                                   class="form-control"
                                                                   id="lastLoginDate"
                                                                   value="@(user.LastLoginAt == DateTime.MinValue
                                                                    ? "-"
                                                                    : user.LastLoginAt.ToString("yyyy-MM-dd hh:mm:ss tt"))">
                                                        </div>
                                                    </div>
                                                    <div></div>
                                                    <div class="text-end mt-4 gap-2 justify-content-end" style="display: flex;">
                                                        <button type="submit" id="btnSaveProfile" class="btn btn-success" disabled>Save Changes</button>
                                                        <button type="button" id="btnCancelProfile" class="btn btn-danger" disabled>Cancel</button>
                                                    </div>

                                                </div>
                                                <!-- end row -->
                                            </form>
                                        </div>
                                    </div>
                                    <div class="tab-pane" id="detail_finance">
                                        <div class="card mb-3">

                                            <div class="card-header justify-content-between">

                                                <div>

                                                    <h4 class="card-title mb-1">
                                                        Search Finance Logs
                                                    </h4>

                                                    <p class="text-muted mb-0">
                                                        Search and filter finance logs by agent and date.
                                                    </p>

                                                </div>

                                            </div>


                                            <div class="card-body">

                                                <form id="financeFilterForm">

                                                    <div class="row g-3">

                                                        <!-- ORDER ID -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="financeFilterOrderId"
                                                                   class="form-label">

                                                                Order ID

                                                            </label>


                                                            <div class="app-search">

                                                                <input type="search"
                                                                       class="form-control"
                                                                       id="financeFilterOrderId"
                                                                       placeholder="Search Order ID..."
                                                                       autocomplete="off">


                                                                <i class="ti ti-hash app-search-icon text-muted"></i>

                                                            </div>

                                                        </div>

                                                        <!-- ================================================= -->
                                                        <!-- Agent CODE - SELECT2 -->
                                                        <!-- ================================================= -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="financeFilterAgentCode"
                                                                   class="form-label">

                                                                Agent Code

                                                            </label>

                                                            <select id="financeFilterAgentCode" class="form-control select2" data-toggle="select2">
                                                                <option value="">
                                                                    All Agents
                                                                </option>
                                                            </select>

                                                        </div>

                                                        <!-- FINANCE TYPE -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="financeFilterExecTypes"
                                                                   class="form-label">

                                                                Finance Types

                                                            </label>


                                                            <select id="financeFilterExecTypes"
                                                                    class="form-select">

                                                                <option value="">
                                                                    All Finance Types
                                                                </option>

                                                                <option value="0">
                                                                    Self Deposit
                                                                </option>

                                                                <option value="1">
                                                                    Manual Deposit
                                                                </option>

                                                                <option value="2">
                                                                    Self Withdraw
                                                                </option>

                                                                <option value="3">
                                                                    Manual Withdraw
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <!-- AMOUNT -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="financeFilterAmount"
                                                                   class="form-label">

                                                                Amount

                                                            </label>


                                                            <div class="app-search">

                                                                <input type="number"
                                                                       class="form-control"
                                                                       id="financeFilterAmount"
                                                                       placeholder="Search amount..."
                                                                       autocomplete="off"
                                                                       min="0"
                                                                       step="0.01"
                                                                       inputmode="decimal">


                                                                <i class="ti ti-currency-dollar app-search-icon text-muted"></i>

                                                            </div>

                                                        </div>

                                                        <!-- STATUS -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="financeFilterStatus"
                                                                   class="form-label">

                                                                Status

                                                            </label>


                                                            <select id="financeFilterStatus"
                                                                    class="form-select">

                                                                <option value="">
                                                                    All Statuses
                                                                </option>

                                                                <option value="0">
                                                                    Pending
                                                                </option>

                                                                <option value="2">
                                                                    Completed
                                                                </option>

                                                                <option value="3">
                                                                    Rejected
                                                                </option>

                                                                <option value="4">
                                                                    Failed
                                                                </option>

                                                                <option value="5">
                                                                    Cancelled
                                                                </option>


                                                                <option value="6">
                                                                    Auto Cancelled
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <!-- DATE RANGE -->

                                                        <div class="col-xl-6 col-md-6">

                                                            <label class="form-label">
                                                                Date Range
                                                            </label>


                                                            <div class="position-relative">

                                                                <div id="financeReportrange"
                                                                     class="form-control"
                                                                     data-toggle="date-picker-range"
                                                                     data-target-display="#selectedValue"
                                                                     data-cancel-class="btn-light">

                                                                    <i class="ti ti-calendar me-2"></i>

                                                                    <span id="selectedValue">
                                                                    </span>

                                                                    <i class="ti ti-chevron-down position-absolute end-0 top-50 translate-middle me-1"></i>

                                                                </div>

                                                            </div>


                                                            <input type="hidden"
                                                                   id="dateRange"
                                                                   value="" />

                                                        </div>

                                                        <!-- ================================================= -->
                                                        <!-- SEARCH / CLEAR -->

                                                        <div class="col-xl-3 col-md-6 d-flex align-items-end">

                                                            <div class="d-flex gap-2 w-100">

                                                                <button class="btn btn-primary flex-fill"
                                                                        type="submit"
                                                                        id="financeApplyFiltersBtn">

                                                                    <i class="ti ti-search me-2"></i>

                                                                    Search

                                                                </button>


                                                                <button class="btn btn-light flex-fill"
                                                                        type="button"
                                                                        id="financeClearFiltersBtn">

                                                                    <i class="ti ti-refresh me-2"></i>

                                                                    Clear

                                                                </button>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </form>

                                            </div>

                                        </div>
                                        <div class="card">

                                            <div class="card-header justify-content-between">

                                                <div>
                                                    <h4 class="card-title mb-1">
                                                        Finance History
                                                    </h4>

                                                    <p class="text-muted mb-0">
                                                        View financial transactions related to this player.
                                                    </p>
                                                </div>

                                            </div>

                                            <div class="card-body">

                                                <div class="table-responsive">

                                                    <table id="financeLogsTable"
                                                           class="table table-hover table-striped align-middle w-100">

                                                        <thead>
                                                            <tr>
                                                                <th class="text-center">No</th>
                                                                <th>Order Id</th>
                                                                <th>Agent Code</th>
                                                                <th>Finance Type</th>
                                                                <th class="text-end">Amount</th>
                                                                <th class="text-end">Balance</th>
                                                                <th>Date</th>
                                                                <th>Status</th>
                                                                <th class="text-center">Details</th>
                                                                <th class="text-center">Actions</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                        </tbody>

                                                    </table>

                                                </div>
                                                <div class="row mt-2">

                                                    <div class="col-md-4">

                                                        <div id="dataTableLengthContainer"
                                                             class="d-flex align-items-center h-100">
                                                        </div>

                                                    </div>


                                                    <div class="col-md-4">

                                                        <div id="dataTableInfoContainer"
                                                             class="d-flex align-items-center justify-content-center h-100">
                                                        </div>

                                                    </div>


                                                    <div class="col-md-4">

                                                        <div id="dataTablePagingContainer"
                                                             class="d-flex align-items-center justify-content-md-end justify-content-center h-100">
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                    <div class="modal fade"
                                         id="financeLogDetailsModal"
                                         tabindex="-1"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-lg modal-dialog-centered">

                                            <div class="modal-content">

                                                <div class="modal-header">

                                                    <h5 class="modal-title">
                                                        Finance Log Details
                                                    </h5>


                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal"
                                                            aria-label="Close">
                                                    </button>

                                                </div>


                                                <div class="modal-body">

                                                    <div class="row g-3">


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Id
                                                            </label>

                                                            <div id="detailId"
                                                                 class="fw-semibold text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Order Id
                                                            </label>

                                                            <div id="detailOrderId"
                                                                 class="fw-semibold text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Agent Code
                                                            </label>

                                                            <div id="detailAgentCode"
                                                                 class="text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Target Code
                                                            </label>

                                                            <div id="detailTargetCode"
                                                                 class="text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Finance Type
                                                            </label>

                                                            <div id="detailFinanceType">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Target Account Type
                                                            </label>

                                                            <div id="detailTargetAccountType">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Amount
                                                            </label>

                                                            <div id="detailAmount"
                                                                 class="fw-semibold">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Status
                                                            </label>

                                                            <div id="detailStatus">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-12">

                                                            <label class="form-label text-muted">
                                                                Target Balance
                                                            </label>

                                                            <div id="detailTargetBalance"
                                                                 class="fw-semibold text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Agent Balance
                                                            </label>

                                                            <div id="detailAgentBalance"
                                                                 class="text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Created At
                                                            </label>

                                                            <div id="detailCreatedAt"
                                                                 class="text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Agent Path
                                                            </label>

                                                            <div id="detailAgentPath"
                                                                 class="text-break">
                                                            </div>

                                                        </div>


                                                        <div class="col-md-6">

                                                            <label class="form-label text-muted">
                                                                Target Path
                                                            </label>

                                                            <div id="detailTargetPath"
                                                                 class="text-break">
                                                            </div>

                                                        </div>


                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                    <div class="tab-pane" id="detail_history">
                                        <div class="card mb-3">

                                            <div class="card-header justify-content-between">

                                                <div>

                                                    <h4 class="card-title mb-1">
                                                        Search Betting Logs
                                                    </h4>

                                                    <p class="text-muted mb-0">
                                                        Search and filter betting history by agent, user, provider, game, round and date.
                                                    </p>

                                                </div>

                                            </div>


                                            <div class="card-body">

                                                <form id="bettingFilterForm">

                                                    <div class="row g-3">


                                                        <!-- ================================================= -->
                                                        <!-- PROVIDER CODE - SELECT2 -->
                                                        <!-- ================================================= -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="filterProviderCode"
                                                                   class="form-label">

                                                                Provider Code

                                                            </label>

                                                            <select id="filterProviderCode"
                                                                    class="form-select">
                                                                <option value="">
                                                                    All Providers
                                                                </option>
                                                            </select>

                                                        </div>


                                                        <!-- ================================================= -->
                                                        <!-- GAME CODE -->
                                                        <!-- ================================================= -->

                                                        <div class="col-xl-3 col-md-6">

                                                            <label for="filterGameCode"
                                                                   class="form-label">

                                                                Game Code

                                                            </label>

                                                            <div class="app-search">

                                                                <input type="search"
                                                                       class="form-control"
                                                                       id="filterGameCode"
                                                                       placeholder="Search game code..."
                                                                       autocomplete="off">

                                                                <i class="ti ti-device-gamepad app-search-icon text-muted"></i>

                                                            </div>

                                                        </div>


                                                        <!-- ================================================= -->
                                                        <!-- ROUND ID -->
                                                        <!-- ================================================= -->

                                                        <div class="col-xl-3 col-md-6">

