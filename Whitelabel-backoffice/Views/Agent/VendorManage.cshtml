<script src="/assets/js/agent/vendormanage.js"></script>
<script src="/assets/js/agent/sweetalert.js"></script>
<script src="/assets/js/agent/sweetalert1.js"></script>

<script>
    document.querySelectorAll(".switch-item").forEach(item => {

        const checkbox = item.querySelector("input");
        const text = item.querySelector(".switch-text");

        function updateSwitch() {

            if (checkbox.classList.contains("open")) {

                checkbox.checked = true;

                text.textContent = "open";
                text.style.color = "#00b894";

            } else {

                checkbox.classList.remove("open");
                checkbox.classList.add("close");

                checkbox.checked = false;

                text.textContent = "close";
                text.style.color = "#ff3b4d";
            }
        }

        checkbox.addEventListener("change", function () {

            // IMPORTANT:
            // Do nothing here when the change comes from
            // updatestatus(). The AJAX response will handle it.
            if (this.dataset.updating === "true") {
                return;
            }

            if (this.checked) {

                this.classList.remove("close");
                this.classList.add("open");

            } else {

                this.classList.remove("open");
                this.classList.add("close");
            }

            updateSwitch();
        });

        text.addEventListener("click", function () {
            checkbox.click();
        });

        // Initial state
        updateSwitch();
    });</script>
<script>
    function updatestatus(id) {

        const checkbox = event.currentTarget;
        const item = checkbox.closest(".switch-item");
        const text = item.querySelector(".switch-text");

        // Get the REAL status before the checkbox changes
        const wasOpen = checkbox.classList.contains("open");

        // Prevent the change event from changing the UI
        checkbox.dataset.updating = "true";

        // Keep the original visual state
        checkbox.checked = wasOpen;

        const status = wasOpen ? "open" : "close";

        let title;
        let message;
        let confirmText;

        if (wasOpen) {

            title = "Close Provider?";
            message = "Are you sure you want to close this provider?";
            confirmText = "Yes, Close";

        } else {

            title = "Open Provider?";
            message = "Are you sure you want to open this provider?";
            confirmText = "Yes, Open";
        }

        Swal.fire({
            title: title,
            text: message,
            icon: "question",
            showCancelButton: true,
            showCloseButton: true,
            confirmButtonText: confirmText,
            cancelButtonText: "Cancel",
            buttonsStyling: false,
            customClass: {
                confirmButton: "btn btn-primary me-2 mt-2",
                cancelButton: "btn btn-danger mt-2"
            }
        }).then(function (result) {

            // ==========================================
            // CANCEL
            // ==========================================

            if (!result.isConfirmed) {

                checkbox.dataset.updating = "false";

                // Keep original state
                checkbox.checked = wasOpen;

                return;
            }

            // ==========================================
            // LOADING
            // ==========================================

            Swal.fire({
                title: "Updating...",
                text: "Please wait while the provider status is being updated.",
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,

                didOpen: function () {
                    Swal.showLoading();
                }
            });

            // ==========================================
            // AJAX
            // ==========================================

            $.ajax({
                url: "/Agent/UpdateStatus",
                method: "POST",

                data: {
                    id: id,
                    status: status
                },

                success: function (res) {

                    if (res.success) {

                        // ==========================================
                        // ONLY NOW CHANGE THE SWITCH
                        // ==========================================

                        if (wasOpen) {

                            // OPEN -> CLOSE

                            checkbox.classList.remove("open");
                            checkbox.classList.add("close");

                            checkbox.checked = false;

                            text.textContent = "close";
                            text.style.color = "#ff3b4d";

                        } else {

                            // CLOSE -> OPEN

                            checkbox.classList.remove("close");
                            checkbox.classList.add("open");

                            checkbox.checked = true;

                            text.textContent = "open";
                            text.style.color = "#00b894";
                        }

                        // Allow normal change events again
                        checkbox.dataset.updating = "false";

                        // ==========================================
                        // SUCCESS ALERT
                        // ==========================================

                        Swal.fire({
                            icon: "success",
                            title: "Success!",
                            text: wasOpen
                                ? "Provider has been closed successfully."
                                : "Provider has been opened successfully.",
                            showConfirmButton: false,
                            timer: 1500,
                            buttonsStyling: false
                        });

                    } else {

                        // ==========================================
                        // FAILED RESPONSE
                        // ==========================================

                        checkbox.dataset.updating = "false";

                        // Keep original state
                        checkbox.checked = wasOpen;

                        if (wasOpen) {
                            checkbox.classList.remove("close");
                            checkbox.classList.add("open");
                        } else {
                            checkbox.classList.remove("open");
                            checkbox.classList.add("close");
                        }

                        Swal.fire({
                            icon: "error",
                            title: "Update Failed",
                            text: res.message || "Unable to update provider status.",
                            confirmButtonText: "OK",
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: "btn btn-primary mt-2"
                            }
                        });
                    }
                },

                error: function () {

                    // ==========================================
                    // AJAX ERROR
                    // ==========================================

                    checkbox.dataset.updating = "false";

                    // Keep original state
                    checkbox.checked = wasOpen;

                    if (wasOpen) {
                        checkbox.classList.remove("close");
                        checkbox.classList.add("open");
                    } else {
                        checkbox.classList.remove("open");
                        checkbox.classList.add("close");
                    }

                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "An error occurred while updating the provider status.",
                        confirmButtonText: "OK",
                        buttonsStyling: false,
                        customClass: {
                            confirmButton: "btn btn-primary mt-2"
                        }
                    });
                }
            });
        });
    }
    /*
    * ============================================================
    * UPDATE TOTAL GAME COUNT
    * ============================================================
    */

    function Update(providerCode) {

        Swal.fire({
            title: "Update Provider Games?",
            text: "This will sync the provider's game list and update the database.",
            icon: "question",
            showCancelButton: true,
            showCloseButton: true,
            confirmButtonText: "Yes, Update",
            cancelButtonText: "Cancel",
            buttonsStyling: false,
            customClass: {
                confirmButton: "btn btn-primary me-2 mt-2",
                cancelButton: "btn btn-danger mt-2"
            }
        }).then(function (result) {

            if (!result.isConfirmed) {
                return;
            }

            Swal.fire({
                title: "Updating...",
                text: "Please wait while the provider games are being synchronized.",
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: function () {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: "/service/agent/vendormanage/update",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    ProviderCode: providerCode
                }),

                success: function (res) {

                    if (res.success) {

                        // Update TotalGameCount in the table
                        $("#" + providerCode).text(res.totalGameCount);

                        Swal.fire({
                            icon: "success",
                            title: "Update Successful!",
                            text:
                                "Added: " + res.addedCount +
                                " | Updated: " + res.updatedCount +
                                " | Deactivated: " + res.deactivatedCount +
                                " | Total: " + res.totalGameCount,
                            confirmButtonText: "OK",
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: "btn btn-primary mt-2"
                            }
                        });

                    } else {

                        Swal.fire({
                            icon: "error",
                            title: "Update Failed",
                            text: res.message || "Unable to update provider games.",
                            confirmButtonText: "OK",
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: "btn btn-primary mt-2"
                            }
                        });
                    }
                },

                error: function (xhr) {

                    let message = "An error occurred while updating provider games.";

                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }

                    Swal.fire({
                        icon: "error",
                        title: "Update Failed",
                        text: message,
                        confirmButtonText: "OK",
                        buttonsStyling: false,
                        customClass: {
                            confirmButton: "btn btn-primary mt-2"
                        }
                    });
                }
            });
        });
    }
    </script>


