@model List<Titan.HybridRepository.Database.Api>

@{
    ViewData["Title"] = "API Setting";
}


<link id="app-style" href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />


<style>


    .api-setting-list {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding: 10px 5px;
        scrollbar-width: thin;
    }



        .api-setting-list::-webkit-scrollbar {
            height: 6px;
        }



    .api-setting-card {
        min-width: 160px;
        cursor: pointer;
        transition: .2s ease;
    }



        .api-setting-card:hover {
            transform: translateY(-3px);
        }



        .api-setting-card.active {
            border-color: #1ab394 !important;
            box-shadow: 0 0 0 2px rgba(26,179,148,.15);
        }



    .api-logo-box {
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 600;
    }



    .api-status-btn {
        font-size: 11px;
        padding: 3px 12px;
    }



    .api-detail-item label {
        font-size: 12px;
        color: var(--bs-secondary-color);
        margin-bottom: 3px;
    }



    .api-detail-item div {
        font-weight: 500;
        word-break: break-all;
    }

</style>





<div class="page-title-head d-flex align-items-center">



    <div class="flex-grow-1 ms-3">


        <h4 class="page-main-title m-0">

            API Setting

        </h4>


    </div>




    <div class="text-end">


        <ol class="breadcrumb m-0 py-0">


            <li class="breadcrumb-item">

                <a href="~/dashboard/index">

                    MyStake

                </a>

            </li>



            <li class="breadcrumb-item">

                <a href="javascript:void(0);">

                    System

                </a>

            </li>



            <li class="breadcrumb-item active">

                API Setting

            </li>


        </ol>


    </div>


</div>







<div class="container-fluid">





    <!-- API LIST -->


    <div class="card">


        <div class="card-header">


            <h5 class="card-title mb-1">

                API List

            </h5>



            <small class="text-muted">

                Select API to manage configuration

            </small>


        </div>





        <div class="card-body">



            <div class="api-setting-list">



                @foreach (var api in Model)
                {


                    <div class="card api-setting-card"
                         data-id="@api.Id">


                        <div class="card-body text-center p-3">



                            <div class="api-logo-box">

                                @api.ApiCode.ToUpper()

                            </div>




                            <button type="button"
                                    class="btn btn-sm api-status-btn @(api.Status == 1 ? "btn-success" : "btn-secondary")">


                                @(api.Status == 1 ? "ON" : "OFF")


                            </button>



                        </div>


                    </div>


                }



            </div>



        </div>



    </div>







    <!-- API INFORMATION -->



    <div class="card d-none"
         id="apiInformation">



        <div class="card-header">


            <h5 class="card-title mb-1">

                API Information

            </h5>



            <small class="text-muted">

                Current selected API details

            </small>



        </div>





        <div class="card-body">


            <div class="row g-3">





                <div class="col-md-3 api-detail-item">


                    <label>

                        API Code

                    </label>


                    <div id="infoApiCode"></div>


                </div>






                <div class="col-md-3 api-detail-item">


                    <label>

                        OP Code

                    </label>


                    <div id="infoOpCode"></div>


                </div>






                <div class="col-md-3 api-detail-item">


                    <label>

                        API URL

                    </label>


                    <div id="infoApiUrl"></div>


                </div>






                <div class="col-md-3 api-detail-item">


                    <label>

                        Status

                    </label>


                    <div id="infoStatus"></div>


                </div>




            </div>



        </div>



    </div>








    <!-- PROVIDER MANAGEMENT -->



    <div class="card d-none"
         id="providerManagement">



        <div class="card-header">


            <h5 class="card-title mb-1">

                Provider Management

            </h5>



            <small class="text-muted">

                Provider list for selected API

            </small>



        </div>





        <div class="card-body">



            Provider loading will be implemented next.



        </div>



    </div>






</div>









<script>


    $(document).ready(function () {



        $(".api-setting-card").on("click", function () {



            $(".api-setting-card")
                .removeClass("active");



            $(this)
                .addClass("active");




            let id = $(this).data("id");





            $.ajax({


                url: "/api_setting/get",


                type: "POST",


                data: {


                    id: id


                },



                success: function (res) {



                    if (!res.success)

                        return;




                    let api = res.data;





                    $("#infoApiCode")
                        .text(
                            api.apiCode.toUpperCase()
                        );





                    $("#infoOpCode")
                        .text(
                            api.opCode
                        );





                    $("#infoApiUrl")
                        .text(
                            api.apiUrl
                        );





                    $("#infoStatus")
                        .text(

                            api.status == 1

                                ? "ON"

                                : "OFF"

                        );





                    $("#apiInformation")
                        .removeClass("d-none");





                    $("#providerManagement")
                        .removeClass("d-none");



                }



            });



        });



    });



</script>