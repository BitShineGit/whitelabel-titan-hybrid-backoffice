{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.9.157;Database=whitelabel-crypto;User ID=sa;Password=Sqlpassword37!;TrustServerCertificate=True;MultipleActiveResultSets=true;Pooling=true;Max Pool Size=100;Connect Timeout=120;"
  },
  "AppSettings": {
    "IsTest": true,
    "ApiCode": "gdgx",
    "MainDomain": "https://localhost:7040"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information" // Set the default minimum level
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:/Logs/747/Common/applog-.txt",
          "rollingInterval": "Hour",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3}] {Username} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "D:/Logs/747/Error/applog-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"

}


